<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>エイトカプセルを守ってくださイ</original>
			<edited>请保护8号胶囊</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>エイトカプセルが破壊されるとアウトでス</original>
			<edited>8号胶囊被破坏就算出局</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>エイトカプセルを撃つと 少し回復できまス</original>
			<edited>射击8号胶囊能稍微回复</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0003" offset="00" relocatable="true" max_length="0">
			<original>敵がたまる前に、一体ずつ 確実に仕留めましょウ</original>
			<edited>在敌人聚集之前，一个个稳稳干掉吧</edited>
			<subEntries />
		</entry>
		<entry name="DefenseZones_0000" offset="00" relocatable="true" max_length="0">
			<original>フム… 敵さんが待ち構えておるのゥ</original>
			<edited>嗯… 敌人在严阵以待呢</edited>
			<subEntries />
		</entry>
		<entry name="DefenseZones_0001" offset="00" relocatable="true" max_length="0">
			<original>己の信じるメインウェポンを選ぶんじゃ</original>
			<edited>选自己信赖的主武器</edited>
			<subEntries />
		</entry>
		<entry name="DefenseZones_0002" offset="00" relocatable="true" max_length="0">
			<original>シャー！ どんどん倒せー！</original>
			<edited>哇！接连干掉！</edited>
			<subEntries />
		</entry>
		<entry name="DefenseZones_0003" offset="00" relocatable="true" max_length="0">
			<original>『エイトカプセルを守る』のが 最優先です！</original>
			<edited>“保护8号胶囊”是重中之重！</edited>
			<subEntries />
		</entry>
		<entry name="DefenseZones_0004" offset="00" relocatable="true" max_length="0">
			<original>ワシの竹筒なら ２０キルはヨユーじゃぞィ！</original>
			<edited>老夫的竹筒，20杀都轻轻松松！</edited>
			<subEntries />
		</entry>
		<entry name="DefenseZones_0005" offset="00" relocatable="true" max_length="0">
			<original>まだまだ来るぞ！ ふんばれー！</original>
			<edited>还会源源不断来！顶住！</edited>
			<subEntries />
		</entry>
		<entry name="DefenseZones_0006" offset="00" relocatable="true" max_length="0">
			<original>あと少し 耐えてください！</original>
			<edited>再撑一下！</edited>
			<subEntries />
		</entry>
		<entry name="DefenseZones_0007" offset="00" relocatable="true" max_length="0">
			<original>防衛の鉄則１！ 最初は敵の着地点をねらえ！</original>
			<edited>防守铁则1！一开始瞄准敌人的降落点！</edited>
			<subEntries />
		</entry>
		<entry name="DefenseZones_0008" offset="00" relocatable="true" max_length="0">
			<original>防衛の鉄則２！ 周囲をこまめに確認！</original>
			<edited>防守铁则2！勤查四周！</edited>
			<subEntries />
		</entry>
		<entry name="DefenseZones_0009" offset="00" relocatable="true" max_length="0">
			<original>防衛の鉄則３！ 耳も使え！ 木箱は壊れてなイカ？</original>
			<edited>防守铁则3！用耳朵听！木箱有没有坏掉？</edited>
			<subEntries />
		</entry>
		<entry name="DefenseZones_0010" offset="00" relocatable="true" max_length="0">
			<original>防衛の鉄則４！ 中ばんは遠くからボムでけん制です！</original>
			<edited>防守铁则4！中场用炸弹从远处牵制！</edited>
			<subEntries />
		</entry>
		<entry name="DefenseZones_0011" offset="00" relocatable="true" max_length="0">
			<original>防衛の鉄則５！ 最後は自分をオトリにして守れ！</original>
			<edited>防守铁则5！最后用自己做诱饵守护！</edited>
			<subEntries />
		</entry>
		<entry name="DefenseZones_0012" offset="00" relocatable="true" max_length="0">
			<original>ダメージ たまってきたゾ！</original>
			<edited>伤害在累积！</edited>
			<subEntries />
		</entry>
		<entry name="DefenseZones_0013" offset="00" relocatable="true" max_length="0">
			<original>あ！ エイトカプセルを回復しないと！</original>
			<edited>啊！得给8号胶囊回复！</edited>
			<subEntries />
		</entry>
		<entry name="DefenseZones_0014" offset="00" relocatable="true" max_length="0">
			<original>ふぁんたすてぃっく！ 全員倒したようじゃ！</original>
			<edited>太棒了！好像全干掉了！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
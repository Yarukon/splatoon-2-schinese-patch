<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>このチャレンジでは、ジェットパックを使用しまス</original>
			<edited>这个挑战要使用喷气背包。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>ジェットパックの射程に注意してくださイ</original>
			<edited>注意喷气背包的射程。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>ジェットパックでもダメージを受けたら センプクで回復でス</original>
			<edited>使用喷气背包时受伤，也要靠鱿鱼潜行回复。</edited>
			<subEntries />
		</entry>
		<entry name="HangedKingJET_0002" offset="00" relocatable="true" max_length="0">
			<original>カベのダッシュ板は、センプクで登れば 使えます！</original>
			<edited>墙上的冲刺板，用鱿鱼潜行爬上去就能用！</edited>
			<subEntries />
		</entry>
		<entry name="HangedKingJET_0003" offset="00" relocatable="true" max_length="0">
			<original>ハイパープレッサー！ カベ、つきぬけるゾ！</original>
			<edited>高压水枪！会穿透墙壁！</edited>
			<subEntries />
		</entry>
		<entry name="HangedKingJET_0004" offset="00" relocatable="true" max_length="0">
			<original>トビタコポッド！ 追いかけてきます！</original>
			<edited>跳跃章鱼弹舱兵！会追上来！</edited>
			<subEntries />
		</entry>
		<entry name="HangedKingJET_0005" offset="00" relocatable="true" max_length="0">
			<original>シャワー攻撃！ つっこんで来ます！</original>
			<edited>喷淋攻击！它冲过来了！</edited>
			<subEntries />
		</entry>
		<entry name="HangedKingJET_0006" offset="00" relocatable="true" max_length="0">
			<original>弱点のタコ足が出たぞィ！ 撃てーィ！</original>
			<edited>弱点的章鱼脚露出来了！快打！</edited>
			<subEntries />
		</entry>
		<entry name="HangedKingJET_0007" offset="00" relocatable="true" max_length="0">
			<original>シャー！ どんどんいくゾ！</original>
			<edited>好！乘胜追击！</edited>
			<subEntries />
		</entry>
		<entry name="HangedKingJET_0008" offset="00" relocatable="true" max_length="0">
			<original>もう少しです！ ８号さん！</original>
			<edited>就差一点了，8号！</edited>
			<subEntries />
		</entry>
		<entry name="HangedKingJET_0009" offset="00" relocatable="true" max_length="0">
			<original>こっちの弾が届くとこまで 近づかねーとな！</original>
			<edited>得靠近到我们的子弹射得到的地方！</edited>
			<subEntries />
		</entry>
		<entry name="HangedKingJET_0010" offset="00" relocatable="true" max_length="0">
			<original>本体には 攻撃が効きません！</original>
			<edited>攻击对本体无效！</edited>
			<subEntries />
		</entry>
		<entry name="HangedKingJET_0011" offset="00" relocatable="true" max_length="0">
			<original>上のタコプターから 片付けるんじゃ！</original>
			<edited>先收拾上面的章鱼螺旋桨兵！</edited>
			<subEntries />
		</entry>
		<entry name="HangedKingJET_0012" offset="00" relocatable="true" max_length="0">
			<original>トビタコポッドは 先に倒しましょう！</original>
			<edited>先打倒跳跃章鱼弹舱兵吧！</edited>
			<subEntries />
		</entry>
		<entry name="HangedKingJET_0013" offset="00" relocatable="true" max_length="0">
			<original>タコ足じゃ！ 撃ちつくせィ！</original>
			<edited>是章鱼脚！狠狠干它！</edited>
			<subEntries />
		</entry>
		<entry name="HangedKingJET_0014" offset="00" relocatable="true" max_length="0">
			<original>いいゾ！ 終わらせてやれ！</original>
			<edited>好！解决它！</edited>
			<subEntries />
		</entry>
		<entry name="HangedKingJET_0015" offset="00" relocatable="true" max_length="0">
			<original>打点を 高い位置でキープするんじゃ！</original>
			<edited>保持高打点！</edited>
			<subEntries />
		</entry>
		<entry name="HangedKingJET_0017" offset="00" relocatable="true" max_length="0">
			<original>早めに撃ち落としましょう！</original>
			<edited>趁早把它打下来吧！</edited>
			<subEntries />
		</entry>
		<entry name="HangedKingJET_0018" offset="00" relocatable="true" max_length="0">
			<original>縦の動きも使うんじゃ！</original>
			<edited>也要利用上下移动！</edited>
			<subEntries />
		</entry>
		<entry name="HangedKingJET_0019" offset="00" relocatable="true" max_length="0">
			<original>ハイパープレッサーは引きつけて、センプクでよけてください！</original>
			<edited>先引开高压水枪，再用鱿鱼潜行躲开！</edited>
			<subEntries />
		</entry>
		<entry name="HangedKingJET_0020" offset="00" relocatable="true" max_length="0">
			<original>なわとびの要領で、センプクと飛行をくり返すんじゃ！</original>
			<edited>像跳绳一样，交替使用潜行和飞行！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Opening_0000" offset="00" relocatable="true" max_length="0">
			<original>こんちゃーっ！
ハイカラニュースの時間だよ！</original>
			<edited>早呀——！
现在是尚兴新闻的时间哦！</edited>
			<subEntries />
		</entry>
		<entry name="Opening_0001" offset="00" relocatable="true" max_length="0">
			<original>今日もハイカラスクエアのかたスミから
テンタクルズが おとどけします</original>
			<edited>今天同样在尚兴广场的一角
由腕儿姐妹为您播报。</edited>
			<subEntries />
		</entry>
		<entry name="OpeningFest_0000" offset="00" relocatable="true" max_length="0">
			<original>イエーイ！！
みんな イカしてるーーー？！</original>
			<edited>耶——！！
各位今天鱿型了吗——？！</edited>
			<subEntries />
		</entry>
		<entry name="OpeningFest_0001" offset="00" relocatable="true" max_length="0">
			<original>ハイカラスクエアの中心から
テンタクルズが おとどけしますっ！</original>
			<edited>在尚兴广场的中心
由腕儿姐妹为您播报！</edited>
			<subEntries />
		</entry>
		<entry name="OpeningFestEnd_0000" offset="00" relocatable="true" max_length="0">
			<original>しゅーりょーー！</original>
			<edited>结——束——！</edited>
			<subEntries />
		</entry>
		<entry name="OpeningFestEnd_0001" offset="00" relocatable="true" max_length="0">
			<original>みなさん、おつかれさまでした～</original>
			<edited>大家辛苦了～</edited>
			<subEntries />
		</entry>
		<entry name="OpeningFestEnd_0002" offset="00" relocatable="true" max_length="0">
			<original>それで、どっちが勝ったの？</original>
			<edited>那么，哪边赢了？</edited>
			<subEntries />
		</entry>
		<entry name="OpeningFestEnd_0003" offset="00" relocatable="true" max_length="0">
			<original>今から集計するみたいですよ
結果発表が楽しみですね～</original>
			<edited>好像现在开始统计了
好期待结果公布啊～</edited>
			<subEntries />
		</entry>
		<entry name="Ending_0000" offset="00" relocatable="true" max_length="0">
			<original>あっ 時間だ！</original>
			<edited>啊，到时间了！</edited>
			<subEntries />
		</entry>
		<entry name="Ending_0001" offset="00" relocatable="true" max_length="0">
			<original>じゃ 今日もみんなガンバ！</original>
			<edited>那么，各位今天加油吧！</edited>
			<subEntries />
		</entry>
		<entry name="Ending_0002" offset="00" relocatable="true" max_length="0">
			<original>ぬりたく～る… テンタクル！！</original>
			<edited>涂满涂满～…腕儿姐妹！！</edited>
			<subEntries />
		</entry>
		<entry name="EndingFest_0000" offset="00" relocatable="true" max_length="0">
			<original>じゃ 今日もみんなガンバ！</original>
			<edited>那么，各位今天加油吧！</edited>
			<subEntries />
		</entry>
		<entry name="EndingFest_0001" offset="00" relocatable="true" max_length="0">
			<original>ぬりたく～る… テンタクル！！</original>
			<edited>涂满涂满～…腕儿姐妹！！</edited>
			<subEntries />
		</entry>
		<entry name="FirstTime_0000" offset="00" relocatable="true" max_length="0">
			<original>あっ！ 臨時ニュースだって！
イイダ！ 読んで読んで！</original>
			<edited>啊！有临时新闻哦！
饭田！快念快念！</edited>
			<subEntries />
		</entry>
		<entry name="FirstTime_0001" offset="00" relocatable="true" max_length="0">
			<original>えっ、あ ハイ！</original>
			<edited>诶，啊，好！</edited>
			<subEntries />
		</entry>
		<entry name="FirstTime_0002" offset="00" relocatable="true" max_length="0">
			<original>ええっ、オオデンチナマズが ナゾのシッソウ？</original>
			<edited>诶诶，大电池鲶鱼神秘失踪？</edited>
			<subEntries />
		</entry>
		<entry name="FirstTime_0003" offset="00" relocatable="true" max_length="0">
			<original>それ ヤバいヤツじゃん！
っつーか 前もどっか行ってたし…</original>
			<edited>这不得了了啊！
说回来，之前也是不知道跑哪去了……</edited>
			<subEntries />
		</entry>
		<entry name="FirstTime_0004" offset="00" relocatable="true" max_length="0">
			<original>えええっ！ スーパーアイドルの
アオリちゃんも行方不明？</original>
			<edited>诶诶诶！超级偶像
小拟也下落不明？</edited>
			<subEntries />
		</entry>
		<entry name="FirstTime_0005" offset="00" relocatable="true" max_length="0">
			<original>マジ！ それ ちょーヤバくね？！
イイダ なんとかしなよ！</original>
			<edited>真的吗！这超不得了了啊？！
饭田，想想办法嘛！</edited>
			<subEntries />
		</entry>
		<entry name="FirstTime_0006" offset="00" relocatable="true" max_length="0">
			<original>できませんよ～…</original>
			<edited>没有办法啦～……</edited>
			<subEntries />
		</entry>
		<entry name="FirstTime_0007" offset="00" relocatable="true" max_length="0">
			<original>なんだよ シケてんなー…
ま、しばらくしたら どっちもなんとかなるっしょ！</original>
			<edited>什么嘛，真是没趣——…
不过，过段时间哪边都会有办法解决的吧！</edited>
			<subEntries />
		</entry>
		<entry name="FirstTime_0008" offset="00" relocatable="true" max_length="0">
			<original>ええ～っ？！ いいんですかそんなんで…</original>
			<edited>诶诶～？！ 这样真的好吗…</edited>
			<subEntries />
		</entry>
		<entry name="StageRegular_0000" offset="00" relocatable="true" max_length="0">
			<original>今のレギュラーマッチのステージは、ここだ！</original>
			<edited>本次一般比赛的场地是这里！</edited>
			<subEntries />
		</entry>
		<entry name="StageGachi_0000" offset="00" relocatable="true" max_length="0">
			<original>そして ガチマッチのステージは、ここ！</original>
			<edited>然后真格比赛的场地是这里！</edited>
			<subEntries />
		</entry>
		<entry name="StageLeague_0000" offset="00" relocatable="true" max_length="0">
			<original>リーグマッチのステージは、ここ！</original>
			<edited>联赛对战的地图，就是这里！</edited>
			<subEntries />
		</entry>
		<entry name="StageFest_0000" offset="00" relocatable="true" max_length="0">
			<original>フェスマッチのステージは…、来いっ！</original>
			<edited>祭典对战的地图…，来吧！</edited>
			<subEntries />
		</entry>
		<entry name="FestAnnounceCmn_0000" offset="00" relocatable="true" max_length="0">
			<original>イイダ！ ステージ発表の前に
臨時ニュースよろしく！</original>
			<edited>饭田！在公布地图之前
先来条临时新闻！</edited>
			<subEntries />
		</entry>
		<entry name="FestAnnounceCmn_0000_Eve" offset="00" relocatable="true" max_length="0">
			<original>イイダ！ 臨時ニュースよろしく！</original>
			<edited>饭田！临时新闻拜托了！</edited>
			<subEntries />
		</entry>
		<entry name="FestAnnounceCmn_0001" offset="00" relocatable="true" max_length="0">
			<original>エッ？！ 急に？
なんでしたっけ？</original>
			<edited>诶？！这么突然？
是什么来着？</edited>
			<subEntries />
		</entry>
		<entry name="FestAnnounceCmn_0002" offset="00" relocatable="true" max_length="0">
			<original>カミ様が動きだしてるってことは
例のアレっしょ！</original>
			<edited>神明大人动起来了的话
就是那个吧！</edited>
			<subEntries />
		</entry>
		<entry name="FestAnnounceCmn_0003" offset="00" relocatable="true" max_length="0">
			<original>フェスですか！</original>
			<edited>是祭典吗！</edited>
			<subEntries />
		</entry>
		<entry name="FestAnnounceCmn_0004" offset="00" relocatable="true" max_length="0">
			<original>それそれ！
近いうちに フェスが始まるよ！</original>
			<edited>对对！
不久就要开始祭典了哦！</edited>
			<subEntries />
		</entry>
		<entry name="FestAnnounceCmn_0005" offset="00" relocatable="true" max_length="0">
			<original>テンション上がっちゃいますネ！
機材のメンテしなくちゃ…</original>
			<edited>心情都激动起来了呢！
得去维护一下设备…</edited>
			<subEntries />
		</entry>
		<entry name="FestAnnounceCmn_0006" offset="00" relocatable="true" max_length="0">
			<original>イイダ！ フェスのお題 まだー？</original>
			<edited>饭田！祭典的主题好了没？</edited>
			<subEntries />
		</entry>
		<entry name="FestAnnounceCmn_0007" offset="00" relocatable="true" max_length="0">
			<original>ちょっと待ってくださいね！
フェスのお題… 降りて来たみたいです</original>
			<edited>请稍等一下！
祭典的主题…好像降临了</edited>
			<subEntries />
		</entry>
		<entry name="FestAnnounceCmn_0008" offset="00" relocatable="true" max_length="0">
			<original>……来たっ！
フェスのお題は… うおっ？！</original>
			<edited>……来了！
祭典的主题是… 哇哦？！</edited>
			<subEntries />
		</entry>
		<entry name="FestAnnounceCmn_0009" offset="00" relocatable="true" max_length="0">
			<original>ヒメセンパイだけ見てないで
早く教えてくださいよ！</original>
			<edited>别光顾着自己看啊，小姬前辈！
快告诉我们吧！</edited>
			<subEntries />
		</entry>
		<entry name="FestAnnounceCmn_0010" offset="00" relocatable="true" max_length="0">
			<original>それじゃあ、
はっぴょーーーするよ！！</original>
			<edited>那么，我要发——布——了哦！！</edited>
			<subEntries />
		</entry>
		<entry name="FestAnnounceCmn_0011" offset="00" relocatable="true" max_length="0">
			<original>ゴクリ…</original>
			<edited>咕咚…</edited>
			<subEntries />
		</entry>
		<entry name="FestAnnounceCmn_0012" offset="00" relocatable="true" max_length="0">
			<original>今回の フェスのお題は…</original>
			<edited>本次祭典的主题是……</edited>
			<subEntries />
		</entry>
		<entry name="MissionEnding_0000" offset="00" relocatable="true" max_length="0">
			<original>じゃーいつもどおり
レギュラーマッチのステージは ここだ！</original>
			<edited>那么照老规矩
普通对战的地图就是这里！</edited>
			<subEntries />
		</entry>
		<entry name="MissionEnding_0001" offset="00" relocatable="true" max_length="0">
			<original>あっ、ちがう！臨時ニュースだって！
イイダ ストップ！</original>
			<edited>啊，不对！是临时新闻！
饭田，停！</edited>
			<subEntries />
		</entry>
		<entry name="MissionEnding_0002" offset="00" relocatable="true" max_length="0">
			<original>ええ～っ、なんですかまた…</original>
			<edited>诶诶～，又是什么事啊…</edited>
			<subEntries />
		</entry>
		<entry name="MissionEnding_0003" offset="00" relocatable="true" max_length="0">
			<original>えっ！オオデンチナマズくん
もどってきたって？！</original>
			<edited>诶！大电池鲶鱼
回来了？！</edited>
			<subEntries />
		</entry>
		<entry name="MissionEnding_0004" offset="00" relocatable="true" max_length="0">
			<original>マジじゃん！
ヤベーっ！</original>
			<edited>真的假的！
太棒了！</edited>
			<subEntries />
		</entry>
		<entry name="MissionEnding_0005" offset="00" relocatable="true" max_length="0">
			<original>すご～い！
写真とりましょう！写真！</original>
			<edited>好厉害～！
拍张照吧！照片！</edited>
			<subEntries />
		</entry>
		<entry name="MissionEnding_0006" offset="00" relocatable="true" max_length="0">
			<original>…なんか飽きたな！</original>
			<edited>…好像有点腻了！</edited>
			<subEntries />
		</entry>
		<entry name="MissionEnding_0007" offset="00" relocatable="true" max_length="0">
			<original>そうですね～ …っていうか
いつもこんなかんじでしたね！</original>
			<edited>是啊～…话说回来
不一直都是这种感觉吗！</edited>
			<subEntries />
		</entry>
		<entry name="MissionEnding_0008" offset="00" relocatable="true" max_length="0">
			<original>じゃー気を取り直して…
レギュラーマッチのステージはここだ！</original>
			<edited>那么重整旗鼓…
普通对战的地图就是这里！</edited>
			<subEntries />
		</entry>
		<entry name="MissionEnding_0009" offset="00" relocatable="true" max_length="0">
			<original>あっ、ちがう！また臨時ニュース！
イイダ やめ！</original>
			<edited>啊，不对！又是临时新闻！
饭田，停下！</edited>
			<subEntries />
		</entry>
		<entry name="MissionEnding_0010" offset="00" relocatable="true" max_length="0">
			<original>ええ～っ…！</original>
			<edited>诶诶～…！</edited>
			<subEntries />
		</entry>
		<entry name="MissionEnding_0011" offset="00" relocatable="true" max_length="0">
			<original>おわ！アオリちゃん見つかったって！
こっちのニュースのが スゲーじゃん！！</original>
			<edited>哇！听说找到小拟了！
这条新闻更厉害吧！！</edited>
			<subEntries />
		</entry>
		<entry name="MissionEnding_0012" offset="00" relocatable="true" max_length="0">
			<original>よ、よかった～！！
ワタシ、ホントにホントに 心配だったんです！</original>
			<edited>太、太好了～！！
我，真的真的担心死了！</edited>
			<subEntries />
		</entry>
		<entry name="MissionEnding_0013" offset="00" relocatable="true" max_length="0">
			<original>マジ、ライバルにいなくなられたら
こまるからな！</original>
			<edited>说真的，要是对手不在了
会很麻烦的嘛！</edited>
			<subEntries />
		</entry>
		<entry name="MissionEnding_0014" offset="00" relocatable="true" max_length="0">
			<original>シオカラーズ、
ふたりでひとつですからね…！</original>
			<edited>潮色姐妹，
两人合在一起才是一体啊…！</edited>
			<subEntries />
		</entry>
		<entry name="MissionEnding_0015" offset="00" relocatable="true" max_length="0">
			<original>あっ、次曲紹介じゃん！
やってやって！</original>
			<edited>啊，接下来是歌曲介绍！
快上快上！</edited>
			<subEntries />
		</entry>
		<entry name="MissionEnding_0016" offset="00" relocatable="true" max_length="0">
			<original>ほんとだ！あっ！センパイ、
ちょうどピッタリの リクエストがきてますよ！</original>
			<edited>真的！啊！前辈，
正好有超级合适的点歌进来哦！</edited>
			<subEntries />
		</entry>
		<entry name="MissionEnding_0017" offset="00" relocatable="true" max_length="0">
			<original>ペンネーム【あげたてＢＯＹ】さんからの
リクエストで</original>
			<edited>来自笔名【现炸BOY】的
点歌</edited>
			<subEntries />
		</entry>
		<entry name="MissionEnding_0018" offset="00" relocatable="true" max_length="0">
			<original>今話題沸騰中、 シオカラーズ で
「&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;あさってColor&#xE;&#x0;&#x3;&#x2;ÿÿ」です！</original>
			<edited>现在话题度爆棚的潮色姐妹带来
&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;《あさってColor》&#xE;&#x0;&#x3;&#x2;ÿÿ！</edited>
			<subEntries />
		</entry>
		<entry name="UpdateInfo_0000" offset="00" relocatable="true" max_length="0">
			<original>アップデートのお知らせ！</original>
			<edited>更新通知！</edited>
			<subEntries />
		</entry>
		<entry name="UpdateInfo_0001" offset="00" relocatable="true" max_length="0">
			<original>エッ？！ アップデートするんですね～</original>
			<edited>诶？！要更新了啊～</edited>
			<subEntries />
		</entry>
		<entry name="StageUnlock_0000" offset="00" relocatable="true" max_length="0">
			<original>&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;新しいステージ&#xE;&#x0;&#x3;&#x2;ÿÿが 追加されたよ！</original>
			<edited>&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;新地图&#xE;&#x0;&#x3;&#x2;ÿÿ追加了哦！</edited>
			<subEntries />
		</entry>
		<entry name="StageUnlock_0001" offset="00" relocatable="true" max_length="0">
			<original>おお～</original>
			<edited>哦哦～</edited>
			<subEntries />
		</entry>
		<entry name="StageUnlockEnd_0000" offset="00" relocatable="true" max_length="0">
			<original>いいじゃん！</original>
			<edited>不错嘛！</edited>
			<subEntries />
		</entry>
		<entry name="StageUnlockEnd_0001" offset="00" relocatable="true" max_length="0">
			<original>&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;バトルのステージ&#xE;&#x0;&#x3;&#x2;ÿÿに 選ばれるように
なったそうです！ 楽しみですね～</original>
			<edited>&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;对战地图&#xE;&#x0;&#x3;&#x2;ÿÿ会
被选中出场哦！好期待啊～</edited>
			<subEntries />
		</entry>
		<entry name="WeaponUnlock_0000" offset="00" relocatable="true" max_length="0">
			<original>&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;新しいブキ&#xE;&#x0;&#x3;&#x2;ÿÿが 追加されたよ！</original>
			<edited>&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;新武器&#xE;&#x0;&#x3;&#x2;ÿÿ追加了哦！</edited>
			<subEntries />
		</entry>
		<entry name="WeaponUnlockEnd_0000" offset="00" relocatable="true" max_length="0">
			<original>また ブキチのやつの話に
付き合わないと いけないのか…</original>
			<edited>又要陪武器子那家伙
聊他的话题了吗…</edited>
			<subEntries />
		</entry>
		<entry name="WeaponUnlockEnd_0001" offset="00" relocatable="true" max_length="0">
			<original>たまに、すっごい早口で
ついていけないとき ありますよね…</original>
			<edited>有时候他语速超快
根本跟不上呢…</edited>
			<subEntries />
		</entry>
		<entry name="GearUnlock_0000" offset="00" relocatable="true" max_length="0">
			<original>&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;新しいギア&#xE;&#x0;&#x3;&#x2;ÿÿが 追加されたよ！</original>
			<edited>&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;新装备&#xE;&#x0;&#x3;&#x2;ÿÿ追加了哦！</edited>
			<subEntries />
		</entry>
		<entry name="GearUnlockEnd_0000" offset="00" relocatable="true" max_length="0">
			<original>ワ～！
ぜ～んぶ、欲しくなっちゃいますね！</original>
			<edited>哇～！
全～部都好想要啊！</edited>
			<subEntries />
		</entry>
		<entry name="FixGame_0000" offset="00" relocatable="true" max_length="0">
			<original>ゲーム内容が ちょっと変わったよ！</original>
			<edited>游戏内容稍微有点变化哦！</edited>
			<subEntries />
		</entry>
		<entry name="FixGame_0001" offset="00" relocatable="true" max_length="0">
			<original>は～、そうなんですね～</original>
			<edited>哈～，原来如此啊～</edited>
			<subEntries />
		</entry>
		<entry name="FixGame_0002" offset="00" relocatable="true" max_length="0">
			<original>くわしいこたぁ、公式サイトをチェック！</original>
			<edited>具体详情，请查看官方网站！</edited>
			<subEntries />
		</entry>
		<entry name="FixGame_0003" offset="00" relocatable="true" max_length="0">
			<original>よろしくおねがいしま～す</original>

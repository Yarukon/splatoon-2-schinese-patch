<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>箱マト３０コ 全て壊すのでス</original>
			<edited>请打坏全部30个箱靶</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>箱マトを１つでものがすと 先に進めなくなりまス</original>
			<edited>漏掉1个箱靶就无法继续前进</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0003" offset="00" relocatable="true" max_length="0">
			<original>ダメージをくらうと アウトとなりまス</original>
			<edited>受到伤害就算出局</edited>
			<subEntries />
		</entry>
		<entry name="BoxRail_0001" offset="00" relocatable="true" max_length="0">
			<original>８号！ マトを　のがしとるぞィ！</original>
			<edited>8号！漏掉靶子了！</edited>
			<subEntries />
		</entry>
		<entry name="BoxRail_0002" offset="00" relocatable="true" max_length="0">
			<original>あと半分だゾ！</original>
			<edited>还剩一半！</edited>
			<subEntries />
		</entry>
		<entry name="BoxRail_0003" offset="00" relocatable="true" max_length="0">
			<original>あー…！</original>
			<edited>啊——…！</edited>
			<subEntries />
		</entry>
		<entry name="BoxRail_0004" offset="00" relocatable="true" max_length="0">
			<original>あと少しです！</original>
			<edited>就差一点了！</edited>
			<subEntries />
		</entry>
		<entry name="BoxRail_0005" offset="00" relocatable="true" max_length="0">
			<original>マトじゃ！ 左ッ！</original>
			<edited>是靶子！在左边！</edited>
			<subEntries />
		</entry>
		<entry name="BoxRail_0006" offset="00" relocatable="true" max_length="0">
			<original>動くタコウォッシャーに 気をつけてください！</original>
			<edited>小心移动的章鱼清洗机！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
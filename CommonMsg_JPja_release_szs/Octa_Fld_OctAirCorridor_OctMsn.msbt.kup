<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>ここは数多のピロピロが織りなす 空中通路でス</original>
			<edited>这里是由无数吹吹卷织成的空中通道。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>開いたピロピロは、先端を塗ることで 開き続けまス</original>
			<edited>张开的吹吹卷，涂前端就能保持张开。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>開いたピロピロは、敵のインクでもどりまス</original>
			<edited>张开的吹吹卷一碰到敌人墨汁就会收回。</edited>
			<subEntries />
		</entry>
		<entry name="AirCorridor_0000" offset="00" relocatable="true" max_length="0">
			<original>メインとサブ、両方 使ってけ！</original>
			<edited>主武器和副武器都用上！</edited>
			<subEntries />
		</entry>
		<entry name="AirCorridor_0001" offset="00" relocatable="true" max_length="0">
			<original>シャー！ ヌリッといくぞー！</original>
			<edited>哇！一边涂一边走！</edited>
			<subEntries />
		</entry>
		<entry name="AirCorridor_0002" offset="00" relocatable="true" max_length="0">
			<original>グッドじゃった！</original>
			<edited>干得漂亮！</edited>
			<subEntries />
		</entry>
		<entry name="AirCorridor_0003" offset="00" relocatable="true" max_length="0">
			<original>一気に行くか ジワジワ行くか、なやみますね…</original>
			<edited>一口气过去还是慢慢磨，真难选……</edited>
			<subEntries />
		</entry>
		<entry name="AirCorridor_0004" offset="00" relocatable="true" max_length="0">
			<original>タココマンダー！ ピロピロの動きに注意です！</original>
			<edited>章鱼指挥官！小心吹吹卷的动向！</edited>
			<subEntries />
		</entry>
		<entry name="AirCorridor_0005" offset="00" relocatable="true" max_length="0">
			<original>ゲッ！ 敵が増えたゾ！</original>
			<edited>呃！敌人变多了！</edited>
			<subEntries />
		</entry>
		<entry name="AirCorridor_0006" offset="00" relocatable="true" max_length="0">
			<original>いいゾ！ 次だ！</original>
			<edited>好！下一个！</edited>
			<subEntries />
		</entry>
		<entry name="AirCorridor_0007" offset="00" relocatable="true" max_length="0">
			<original>このライドレール、元の位置にもどってくるようですね</original>
			<edited>这条墨汁轨道好像会回到原位。</edited>
			<subEntries />
		</entry>
		<entry name="AirCorridor_0008" offset="00" relocatable="true" max_length="0">
			<original>ピロピロするヤツ、いっぱい あんなー</original>
			<edited>吹吹卷的家伙真多啊。</edited>
			<subEntries />
		</entry>
		<entry name="AirCorridor_0009" offset="00" relocatable="true" max_length="0">
			<original>向こうにヤバそーなのが いんゾ！</original>
			<edited>对面有危险的家伙！</edited>
			<subEntries />
		</entry>
		<entry name="AirCorridor_0010" offset="00" relocatable="true" max_length="0">
			<original>おぉ？ なんか、強くなったな ハチ！</original>
			<edited>哦？小八好像变强了啊！</edited>
			<subEntries />
		</entry>
		<entry name="AirCorridor_0011" offset="00" relocatable="true" max_length="0">
			<original>落ちたかと思いました…</original>
			<edited>还以为你掉下去了……</edited>
			<subEntries />
		</entry>
		<entry name="AirCorridor_0012" offset="00" relocatable="true" max_length="0">
			<original>ナイスとっちめ！</original>
			<edited>收拾得漂亮！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>敵をゼンメツさせると 先に進めまス</original>
			<edited>把敌人团灭就能继续前进</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>高いところから敵にインクをかけても あまり効きませン</original>
			<edited>从高处向敌人泼墨汁效果不大</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>ダッシュ板は カーリングボムなどもダッシュさせまス</original>
			<edited>冲刺板也能让冰壶炸弹等冲刺</edited>
			<subEntries />
		</entry>
		<entry name="BattleTower_0000" offset="00" relocatable="true" max_length="0">
			<original>カベの裏で深呼吸！ 戦場の鉄則ゥ！</original>
			<edited>躲到墙后深呼吸！战场的铁则！</edited>
			<subEntries />
		</entry>
		<entry name="BattleTower_0001" offset="00" relocatable="true" max_length="0">
			<original>ナイスゼンメツじゃ！</original>
			<edited>干得漂亮，团灭！</edited>
			<subEntries />
		</entry>
		<entry name="BattleTower_0002" offset="00" relocatable="true" max_length="0">
			<original>敵の位置を確認じゃ！  どこから破るかよく考えィ！</original>
			<edited>确认敌人位置！好好想想从哪里突破！</edited>
			<subEntries />
		</entry>
		<entry name="BattleTower_0003" offset="00" relocatable="true" max_length="0">
			<original>ヨッシ！ 次だ！！</original>
			<edited>好！下一个！！</edited>
			<subEntries />
		</entry>
		<entry name="BattleTower_0004" offset="00" relocatable="true" max_length="0">
			<original>残りは上にいるヤツらだな！</original>
			<edited>剩下的是上面的家伙！</edited>
			<subEntries />
		</entry>
		<entry name="BattleTower_0005" offset="00" relocatable="true" max_length="0">
			<original>下にまだ 敵がおるぞィ！！</original>
			<edited>下面还有敌人！！</edited>
			<subEntries />
		</entry>
		<entry name="BattleTower_0006" offset="00" relocatable="true" max_length="0">
			<original>うおー！ デカい！ 高い！</original>
			<edited>哇哦！好大！好高！</edited>
			<subEntries />
		</entry>
		<entry name="BattleTower_0007" offset="00" relocatable="true" max_length="0">
			<original>グッジョブじゃ！</original>
			<edited>干得好！</edited>
			<subEntries />
		</entry>
		<entry name="BattleTower_0008" offset="00" relocatable="true" max_length="0">
			<original>上の敵は片付きました！</original>
			<edited>上面的敌人清完了！</edited>
			<subEntries />
		</entry>
		<entry name="BattleTower_0009" offset="00" relocatable="true" max_length="0">
			<original>よーし、後は上のヤツらだけだな！</original>
			<edited>好，剩下上面那些了！</edited>
			<subEntries />
		</entry>
		<entry name="BattleTower_0010" offset="00" relocatable="true" max_length="0">
			<original>ドッカーン！</original>
			<edited>轰隆！</edited>
			<subEntries />
		</entry>
		<entry name="BattleTower_0011" offset="00" relocatable="true" max_length="0">
			<original>あと１体です！</original>
			<edited>还剩1个！</edited>
			<subEntries />
		</entry>
		<entry name="BattleTower_0012" offset="00" relocatable="true" max_length="0">
			<original>後はスタコラーだけです！</original>
			<edited>就剩章鱼溜兵了！</edited>
			<subEntries />
		</entry>
		<entry name="BattleTower_0013" offset="00" relocatable="true" max_length="0">
			<original>無限にカンヅメ出るマシンが ありますよ！</original>
			<edited>有无限出罐头的机器哦！</edited>
			<subEntries />
		</entry>
		<entry name="BattleTower_0014" offset="00" relocatable="true" max_length="0">
			<original>ジャンプポイント、出てんゾ！</original>
			<edited>跳跃点出现了！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
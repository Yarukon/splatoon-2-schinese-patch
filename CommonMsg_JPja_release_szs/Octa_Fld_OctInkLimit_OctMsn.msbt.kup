<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>インクが無くなるとアウトでス</original>
			<edited>墨汁用尽就算出局。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>カベを登るのにインクが必要か、よく考えましょウ</original>
			<edited>想想爬墙需要多少墨汁。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>落ち着いて 塗るべき場所を塗るのでス</original>
			<edited>冷静地涂该涂的地方</edited>
			<subEntries />
		</entry>
		<entry name="InkLimit_0000" offset="00" relocatable="true" max_length="0">
			<original>インクを使い切ったらアウトだゾ！</original>
			<edited>墨汁用尽就算出局！</edited>
			<subEntries />
		</entry>
		<entry name="InkLimit_0001" offset="00" relocatable="true" max_length="0">
			<original>インクの使用は最小限にしましょう</original>
			<edited>尽量少用墨汁。</edited>
			<subEntries />
		</entry>
		<entry name="InkLimit_0002" offset="00" relocatable="true" max_length="0">
			<original>グッドじゃった！</original>
			<edited>干得漂亮！</edited>
			<subEntries />
		</entry>
		<entry name="InkLimit_0003" offset="00" relocatable="true" max_length="0">
			<original>…さーて、どーしたもんかな？</original>
			<edited>……那，该怎么办呢？</edited>
			<subEntries />
		</entry>
		<entry name="InkLimit_0004" offset="00" relocatable="true" max_length="0">
			<original>あめぃじん！</original>
			<edited>了不起！</edited>
			<subEntries />
		</entry>
		<entry name="InkLimit_0005" offset="00" relocatable="true" max_length="0">
			<original>ジャマなザコだな… ブッ倒したいけど…</original>
			<edited>碍事的小喽啰……好想打掉……</edited>
			<subEntries />
		</entry>
		<entry name="InkLimit_0006" offset="00" relocatable="true" max_length="0">
			<original>８号さん、インク残量に注意です！</original>
			<edited>8号，注意墨汁余量！</edited>
			<subEntries />
		</entry>
		<entry name="InkLimit_0007" offset="00" relocatable="true" max_length="0">
			<original>インクが もうほとんど無いぞィ！</original>
			<edited>墨汁几乎没了！</edited>
			<subEntries />
		</entry>
		<entry name="InkLimit_0008" offset="00" relocatable="true" max_length="0">
			<original>前方にゴールポイントを発見しました！</original>
			<edited>前方就是终点！</edited>
			<subEntries />
		</entry>
		<entry name="InkLimit_0009" offset="00" relocatable="true" max_length="0">
			<original>ゴールは高台の上だ！</original>
			<edited>终点在高台上！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
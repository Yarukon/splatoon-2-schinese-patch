<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>左の見本と同じカタチに カタヌキするのでス</original>
			<edited>要削成和左侧样品一样的形状</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>まちがった箱をケズると 失敗となりまス</original>
			<edited>削错木箱就算失败</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>集中力を切らさないよう、注意してくださイ</original>
			<edited>请注意别分心</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiL_0000" offset="00" relocatable="true" max_length="0">
			<original>見本と同じカタチになるように、木箱をケズりましょ～♪</original>
			<edited>把木箱削成和样品一样的形状吧～♪</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiL_0001" offset="00" relocatable="true" max_length="0">
			<original>マジかよ… デカすぎんだろ</original>
			<edited>真的假的……也太大了吧。</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiL_0002" offset="00" relocatable="true" max_length="0">
			<original>うぉ！ アタマがぱっかーんしたゾ？！</original>
			<edited>哇！脑袋裂开了？！</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiL_0003" offset="00" relocatable="true" max_length="0">
			<original>ゴールです！ 見本の像の上まで登りましょう！</original>
			<edited>到终点了！爬到样品雕像上面去吧！</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiL_0004" offset="00" relocatable="true" max_length="0">
			<original>いったん息を整えて、落ち着いていきましょう！</original>
			<edited>先调整一下呼吸，冷静前进吧！</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiL_0005" offset="00" relocatable="true" max_length="0">
			<original>あのカギ、何に使うんだろーな？</original>
			<edited>那把钥匙是用来做什么的呢？</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiL_0006" offset="00" relocatable="true" max_length="0">
			<original>そういえば、ドアがありましたよね</original>
			<edited>说起来，之前有扇门来着。</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiL_0007" offset="00" relocatable="true" max_length="0">
			<original>ネル社のロゴ入り木箱だけ 壊したらいいみたいですね</original>
			<edited>好像只要破坏带涅尔社标志的木箱就行。</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiL_0008" offset="00" relocatable="true" max_length="0">
			<original>まるで 年末のススはらいみたいじゃのう </original>
			<edited>简直像年末大扫除一样啊。</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiL_0009" offset="00" relocatable="true" max_length="0">
			<original>回るーー！</original>
			<edited>转起来——！</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiL_0010" offset="00" relocatable="true" max_length="0">
			<original>カギ ゲットォ！</original>
			<edited>钥匙到手！</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiL_0011" offset="00" relocatable="true" max_length="0">
			<original>そういえば、中央にドアがありましたよね？</original>
			<edited>说起来，中央不是有扇门吗？</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiL_0012" offset="00" relocatable="true" max_length="0">
			<original>ころあいを見て、ドアを開きに行きましょうか</original>
			<edited>看准时机，去开门吧。</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiL_0013" offset="00" relocatable="true" max_length="0">
			<original>チェックポイントです！</original>
			<edited>到检查点了！</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiL_0014" offset="00" relocatable="true" max_length="0">
			<original>ふぅ… また最初からとか マジかんべんだったぜ！</original>
			<edited>呼……还好不用再从头来，真是受不了！</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiL_0015" offset="00" relocatable="true" max_length="0">
			<original>うーん、もう少しケズってからの方がよかったかもなー</original>
			<edited>嗯……刚才再多削一点或许更好。</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiL_0016" offset="00" relocatable="true" max_length="0">
			<original>上から ケズってみるか？</original>
			<edited>要不要试着从上面削？</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiL_0017" offset="00" relocatable="true" max_length="0">
			<original>少しずつケズるときは、ちょん押しで撃ちましょ～</original>
			<edited>想一点点削时，就轻按射击吧～</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiL_0018" offset="00" relocatable="true" max_length="0">
			<original>フルチャージは 木箱をつきぬけるから注意な！</original>
			<edited>满蓄力会穿透木箱，注意啊！</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiL_0019" offset="00" relocatable="true" max_length="0">
			<original>しっかりインクを当てれば、爆風が広がりにくいゾ！</original>
			<edited>墨汁打得够准，爆风就不容易扩散！</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiL_0020" offset="00" relocatable="true" max_length="0">
			<original>塗らしちゃった木箱は、爆風を当てないよう注意です！</original>
			<edited>已经涂上墨的木箱，要注意别让爆风碰到！</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiL_0021" offset="00" relocatable="true" max_length="0">
			<original>ようやく 残り半分くらいかのゥ…</original>
			<edited>总算削掉一半左右了吧……</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiL_0022" offset="00" relocatable="true" max_length="0">
			<original>ゲ… まだ半分もあんのかよ</original>
			<edited>啧……居然还有一半啊。</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiL_0023" offset="00" relocatable="true" max_length="0">
			<original>そういえば、あのカギを使ってみてはどうでしょう？</original>
			<edited>说起来，要不要试试那把钥匙？</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiL_0024" offset="00" relocatable="true" max_length="0">
			<original>ヤバい… 集中力が切れてきた…</original>
			<edited>糟了……注意力快涣散了……</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiL_0025" offset="00" relocatable="true" max_length="0">
			<original>そんな時は、シオカラ体操じゃ！</original>
			<edited>这种时候，就做塩辛节体操！</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiL_0026" offset="00" relocatable="true" max_length="0">
			<original>残り２０コを切りました！</original>
			<edited>剩下不到20个了！</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiL_0027" offset="00" relocatable="true" max_length="0">
			<original>あと少しだーっ！ がんばれ、ハチ！</original>
			<edited>就差一点了！加油，小八！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
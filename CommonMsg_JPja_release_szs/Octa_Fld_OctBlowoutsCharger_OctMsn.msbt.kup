<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>フルチャージなら、複数のピロピロを 撃ちぬけまス</original>
			<edited>满蓄力能射穿多个吹吹卷。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>ピロピロの先がピロピロしたら 巻きもどってくる合図でス</original>
			<edited>吹吹卷前端开始抖动，就是收回的信号。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>その時は、ピロピロ部分には 近づかないほうがよいでス</original>
			<edited>那时最好别靠近吹吹卷。</edited>
			<subEntries />
		</entry>
		<entry name="BlowoutsCharger_0000" offset="00" relocatable="true" max_length="0">
			<original>無茶すんなー…</original>
			<edited>别乱来啊……</edited>
			<subEntries />
		</entry>
		<entry name="BlowoutsCharger_0001" offset="00" relocatable="true" max_length="0">
			<original>下にゴールですが、インクが届きそうにないですね</original>
			<edited>下面是终点，但墨汁好像够不着。</edited>
			<subEntries />
		</entry>
		<entry name="BlowoutsCharger_0002" offset="00" relocatable="true" max_length="0">
			<original>ふむ、やりおる！</original>
			<edited>嗯，有两下子！</edited>
			<subEntries />
		</entry>
		<entry name="BlowoutsCharger_0003" offset="00" relocatable="true" max_length="0">
			<original>ここは、ボムを時間差で うまく使えれば…</original>
			<edited>这里，要是能巧妙利用炸弹的时间差……</edited>
			<subEntries />
		</entry>
		<entry name="BlowoutsCharger_0004" offset="00" relocatable="true" max_length="0">
			<original>ナイス！ テクいゾ、ハチ！</original>
			<edited>漂亮！真有两下子啊，小八！</edited>
			<subEntries />
		</entry>
		<entry name="BlowoutsCharger_0005" offset="00" relocatable="true" max_length="0">
			<original>ズバッといくんじゃ！ ズバーーッと！</original>
			<edited>嗖地一下！嗖——地！</edited>
			<subEntries />
		</entry>
		<entry name="BlowoutsCharger_0006" offset="00" relocatable="true" max_length="0">
			<original>ヤバそーなヤツが ねらってくるゾ！</original>
			<edited>有危险的家伙瞄准过来了！</edited>
			<subEntries />
		</entry>
		<entry name="BlowoutsCharger_0007" offset="00" relocatable="true" max_length="0">
			<original>ボム風船とピロピロが いっぱいですね…</original>
			<edited>炸弹气球和吹吹卷真多呢……</edited>
			<subEntries />
		</entry>
		<entry name="BlowoutsCharger_0008" offset="00" relocatable="true" max_length="0">
			<original>イチかバチかじゃ！</original>
			<edited>赌一把！</edited>
			<subEntries />
		</entry>
		<entry name="BlowoutsCharger_0009" offset="00" relocatable="true" max_length="0">
			<original>セーフ！ ヒヤッとしましたね！</original>
			<edited>好险！捏了把汗！</edited>
			<subEntries />
		</entry>
		<entry name="BlowoutsCharger_0010" offset="00" relocatable="true" max_length="0">
			<original>って何もないじゃん！</original>
			<edited>结果什么都没有嘛！</edited>
			<subEntries />
		</entry>
		<entry name="BlowoutsCharger_0011" offset="00" relocatable="true" max_length="0">
			<original>バシュッとな！</original>
			<edited>嗖地一下！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
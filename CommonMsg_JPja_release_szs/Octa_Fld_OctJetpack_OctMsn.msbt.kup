<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>ジャマなタコミサイルは ショットで倒しましょウ</original>
			<edited>碍事的章鱼导弹兵用射击打掉</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>タコッペリン号は 背中が弱点でス</original>
			<edited>章鱼柏林号的弱点是背部</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>ジェットパックは &#xE;&#x2;&#x18;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;で少しうきまス</original>
			<edited>喷气背包，&#xE;&#x2;&#x18;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;稍微上浮</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0003" offset="00" relocatable="true" max_length="0">
			<original>でんでんスイッチとひきよせポイントを 利用しましょウ</original>
			<edited>利用转转开关和牵引点吧</edited>
			<subEntries />
		</entry>
		<entry name="Jetpack_0000" offset="00" relocatable="true" max_length="0">
			<original>ジェットパックは 下に地面が無いと落ちちゃいます！</original>
			<edited>喷气背包下方没有地面就会掉下去！</edited>
			<subEntries />
		</entry>
		<entry name="Jetpack_0002" offset="00" relocatable="true" max_length="0">
			<original>その調子じゃッ！</original>
			<edited>就这势头！</edited>
			<subEntries />
		</entry>
		<entry name="Jetpack_0003" offset="00" relocatable="true" max_length="0">
			<original>ふぁびゅらすじゃ！</original>
			<edited>太棒了！</edited>
			<subEntries />
		</entry>
		<entry name="Jetpack_0004" offset="00" relocatable="true" max_length="0">
			<original>タコッペリン号は、タコ足を撃てば 倒せます！</original>
			<edited>章鱼柏林号，打章鱼脚就能打倒！</edited>
			<subEntries />
		</entry>
		<entry name="Jetpack_0005" offset="00" relocatable="true" max_length="0">
			<original>ヤッホー！ いいながめ！</original>
			<edited>呀吼！风景真好！</edited>
			<subEntries />
		</entry>
		<entry name="Jetpack_0006" offset="00" relocatable="true" max_length="0">
			<original>ひきよせポイント発見！ 確認されたしーッ！</original>
			<edited>发现牵引点！请确认！</edited>
			<subEntries />
		</entry>
		<entry name="Jetpack_0007" offset="00" relocatable="true" max_length="0">
			<original>いいゾ！</original>
			<edited>好！</edited>
			<subEntries />
		</entry>
		<entry name="Jetpack_0008" offset="00" relocatable="true" max_length="0">
			<original>ゴールポイントを発見しました！</original>
			<edited>发现终点了！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
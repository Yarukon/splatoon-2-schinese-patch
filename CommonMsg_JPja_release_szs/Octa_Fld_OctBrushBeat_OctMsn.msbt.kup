<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>時間内に木箱を全て壊してくださイ</original>
			<edited>请在时间内打坏所有木箱</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>インク効率よく、壊しましょウ</original>
			<edited>高效利用墨汁打坏它们</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>壊す順番も考えましょウ</original>
			<edited>也想想打坏的顺序</edited>
			<subEntries />
		</entry>
		<entry name="BrushBeat_00" offset="00" relocatable="true" max_length="0">
			<original>とにかく連打！ だな！</original>
			<edited>总之连打！</edited>
			<subEntries />
		</entry>
		<entry name="BrushBeat_01" offset="00" relocatable="true" max_length="0">
			<original>スーパーチャクチを使うタイミングが大事です！</original>
			<edited>使用超级着陆的时机很重要！</edited>
			<subEntries />
		</entry>
		<entry name="BrushBeat_02" offset="00" relocatable="true" max_length="0">
			<original>急がば急げ！ 戦場の鉄則ゥ！</original>
			<edited>欲速则达！战场的铁则！</edited>
			<subEntries />
		</entry>
		<entry name="BrushBeat_03" offset="00" relocatable="true" max_length="0">
			<original>あと１０秒です！</original>
			<edited>还剩10秒！</edited>
			<subEntries />
		</entry>
		<entry name="BrushBeat_04" offset="00" relocatable="true" max_length="0">
			<original>フルチャージだと、木箱 つきぬけて壊せるゾ！</original>
			<edited>满蓄力能穿透木箱打坏！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>時間内に 箱マトを全て 壊すのでス</original>
			<edited>请在时间内打坏所有箱靶</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>ジャンプ後、着地したら 始まりまス</original>
			<edited>跳跃后落地即开始</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>落ち着いてねらいましょウ</original>
			<edited>冷静瞄准吧</edited>
			<subEntries />
		</entry>
		<entry name="BoxSniper_0000" offset="00" relocatable="true" max_length="0">
			<original>よ～く ねらって…</original>
			<edited>好好瞄准…</edited>
			<subEntries />
		</entry>
		<entry name="BoxSniper_0002" offset="00" relocatable="true" max_length="0">
			<original>気合で 箱マトの動きを感じるんじゃ！</original>
			<edited>靠气势感受箱靶的动向！</edited>
			<subEntries />
		</entry>
		<entry name="BoxSniper_0003" offset="00" relocatable="true" max_length="0">
			<original>ッシャー！ その調子だ！</original>
			<edited>好嘞！就这势头！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
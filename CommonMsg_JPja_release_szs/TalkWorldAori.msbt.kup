<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="First_00" offset="00" relocatable="true" max_length="0">
			<original>あ！ こ、こんにちは４号！&#xE;&#x1;&#x0;&#x4;&lt;&#x0;&#x0;&#x0;
はずかしながら 帰って参りました…</original>
			<edited>啊！ 你、你好，4号！&#xE;&#x1;&#x0;&#x4;&lt;&#x0;&#x0;&#x0;
真不好意思，我回来了…</edited>
			<subEntries />
		</entry>
		<entry name="First_01" offset="00" relocatable="true" max_length="0">
			<original>いろいろメーワクかけちゃったけど、
シオカラーズも New!カラストンビ部隊も、</original>
			<edited>虽然给大家添了不少麻烦，
但潮色姐妹也好，New!喷嘴部队也好，</edited>
			<subEntries />
		</entry>
		<entry name="First_02" offset="00" relocatable="true" max_length="0">
			<original>これまで通り がんばってこー！ と、思っておりまーす！</original>
			<edited>今后也要继续加油！…我是这么想的！</edited>
			<subEntries />
		</entry>
		<entry name="First_03" offset="00" relocatable="true" max_length="0">
			<original>ま、アタシは おじいちゃんと３号が帰って来るまで
ここにいなきゃだし… ヒマなら寄ってってよ</original>
			<edited>嘛，我在爷爷和3号回来之前
得待在这里… 有空的话来坐坐吧</edited>
			<subEntries />
		</entry>
		<entry name="First_04" offset="00" relocatable="true" max_length="0">
			<original>ってか、おじいちゃん達 どこまで行ったんだろ&#xE;&#x1;&#x0;&#x4;&#xF;&#x0;&#x0;&#x0;
自由過ぎっしょ…</original>
			<edited>话说，爷爷他们到底跑到哪儿去了，&#xE;&#x1;&#x0;&#x4;&#xF;&#x0;&#x0;&#x0;
也太自由了吧…</edited>
			<subEntries />
		</entry>
		<entry name="FirstMame_00" offset="00" relocatable="true" max_length="0">
			<original>そー言えば４号のこと、
ホタルちゃんから いろいろ聞いたよっ！</original>
			<edited>对了，关于4号的事，
我听小萤说了不少呢！</edited>
			<subEntries />
		</entry>
		<entry name="FirstMame_01" offset="00" relocatable="true" max_length="0">
			<original>ってゆーワケで、&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;ホタルちゃん印の４号豆知識&#xE;&#x0;&#x3;&#x2;ÿÿを
こっそり教えちゃいまーす！</original>
			<edited>所以呢，&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;小萤亲传的4号豆知识&#xE;&#x0;&#x3;&#x2;ÿÿ，
我偷偷告诉你吧！</edited>
			<subEntries />
		</entry>
		<entry name="FirstMame_02" offset="00" relocatable="true" max_length="0">
			<original>『こっそり』って… アタシここに いるっしょ</original>
			<edited>说什么'偷偷'… 我不就在这儿嘛</edited>
			<subEntries />
		</entry>
		<entry name="MamePrefix_00" offset="00" relocatable="true" max_length="0">
			<original>えーっと、ホタルちゃん印の４号豆知識に よりますと…</original>
			<edited>嗯—，据小萤亲传的4号豆知识所说…</edited>
			<subEntries />
		</entry>
		<entry name="MameBattleWinningRate_00" offset="00" relocatable="true" max_length="0">
			<original>４号って&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;&#xE;&#x3;&#x2;&#x2;&#x7;Í&#xE;&#x0;&#x3;&#x2;ÿÿが得意なんだね！&#xE;&#x1;&#x0;&#x4;&#xF;&#x0;&#x0;&#x0;
最近、一番勝率が いいみたい！</original>
			<edited>4号，你擅长&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;&#xE;&#x3;&#x2;&#x2;&#x7;Í&#xE;&#x0;&#x3;&#x2;ÿÿ呢！&#xE;&#x1;&#x0;&#x4;&#xF;&#x0;&#x0;&#x0;
最近胜率好像是最高的！</edited>
			<subEntries />
		</entry>
		<entry name="MameBattleWinningRate_01" offset="00" relocatable="true" max_length="0">
			<original>うんうん</original>
			<edited>嗯嗯</edited>
			<subEntries />
		</entry>
		<entry name="MameBattleWinningRate_02" offset="00" relocatable="true" max_length="0">
			<original>ステージだと&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;&#xE;&#x3;&#x2;&#x2;
Í&#xE;&#x0;&#x3;&#x2;ÿÿで
調子いいね！</original>
			<edited>在&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;&#xE;&#x3;&#x2;&#x2;
Í&#xE;&#x0;&#x3;&#x2;ÿÿ场地，
状态很好呢！</edited>
			<subEntries />
		</entry>
		<entry name="MameBattleWinningRate_03" offset="00" relocatable="true" max_length="0">
			<original>他のトコも がんばってみよ～</original>
			<edited>其他地方也加油试试～</edited>
			<subEntries />
		</entry>
		<entry name="MameBattleKilledBy_00" offset="00" relocatable="true" max_length="0">
			<original>４号は最近、&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;&#xE;&#x4;&#x0;&#x4;&#x0;&#x0;&#x0;Í&#xE;&#x0;&#x3;&#x2;ÿÿに
よく やられてるんだって…</original>
			<edited>4号最近，好像经常被&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;&#xE;&#x4;&#x0;&#x4;&#x0;&#x0;&#x0;Í&#xE;&#x0;&#x3;&#x2;ÿÿ干掉呢…</edited>

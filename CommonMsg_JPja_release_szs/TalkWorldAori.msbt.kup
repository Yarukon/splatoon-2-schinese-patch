			<subEntries />
		</entry>
		<entry name="MameBattleFall_01" offset="00" relocatable="true" max_length="0">
			<original>じゃらじゃらじゃらじゃら～～～… ばん！</original>
			<edited>叮叮叮叮叮～～～… 咚！</edited>
			<subEntries />
		</entry>
		<entry name="MameBattleFall_02" offset="00" relocatable="true" max_length="0">
			<original>&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;&#xE;&#x3;&#x2;&#x2;
Í&#xE;&#x0;&#x3;&#x2;ÿÿで、

<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>ガチヤグラを、相手のゴールまで導いてくださイ</original>
			<edited>请将真格塔楼带到对手终点。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>ヤグラは、乗ると移動を始めまス</original>
			<edited>站上塔楼后，它就会开始移动。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>カンモンでは、一定時間 ヤグラが停止しまス</original>
			<edited>到关卡闸门时，塔楼会停一段时间。</edited>
			<subEntries />
		</entry>
		<entry name="KawaYagura_0000" offset="00" relocatable="true" max_length="0">
			<original>ガチヤグラを ゴールまで運ぶみてーだな</original>
			<edited>看来要把真格塔楼带到终点。</edited>
			<subEntries />
		</entry>
		<entry name="KawaYagura_0001" offset="00" relocatable="true" max_length="0">
			<original>８号さん、 ヤグラに乗りましょう！</original>
			<edited>8号，站上塔楼吧！</edited>
			<subEntries />
		</entry>
		<entry name="KawaYagura_0002" offset="00" relocatable="true" max_length="0">
			<original>まだじゃッ！ あきらめたらイカんぞィ！</original>
			<edited>还没完！可不能放弃！</edited>
			<subEntries />
		</entry>
		<entry name="KawaYagura_0003" offset="00" relocatable="true" max_length="0">
			<original>あそこから ヤグラにジャンプできるゾ！</original>
			<edited>从那里能跳到塔楼上！</edited>
			<subEntries />
		</entry>
		<entry name="KawaYagura_0004" offset="00" relocatable="true" max_length="0">
			<original>残念ですが… 始めからやり直しですね</original>
			<edited>很遗憾……要从头来过了。</edited>
			<subEntries />
		</entry>
		<entry name="KawaYagura_0005" offset="00" relocatable="true" max_length="0">
			<original>残り１分じゃ！</original>
			<edited>只剩一分钟了！</edited>
			<subEntries />
		</entry>
		<entry name="KawaYagura_0006" offset="00" relocatable="true" max_length="0">
			<original>あ～っ、８号さ～～～んっ！！</original>
			<edited>啊～，8号～～～！！</edited>
			<subEntries />
		</entry>
		<entry name="KawaYagura_0007" offset="00" relocatable="true" max_length="0">
			<original>ヤグラ、動きま～す♪</original>
			<edited>塔楼要动起来了～♪</edited>
			<subEntries />
		</entry>
		<entry name="KawaYagura_0008" offset="00" relocatable="true" max_length="0">
			<original>８号、何をしておる！ ヤグラに乗るんじゃ！</original>
			<edited>8号，干什么呢！快站上塔楼！</edited>
			<subEntries />
		</entry>
		<entry name="KawaYagura_0009" offset="00" relocatable="true" max_length="0">
			<original>ヤグラは 矢印の方向にあるゾ！</original>
			<edited>塔楼在箭头所指的方向！</edited>
			<subEntries />
		</entry>
		<entry name="KawaYagura_0010" offset="00" relocatable="true" max_length="0">
			<original>半分じゃ！ まだまだ先は長いぞィ！</original>
			<edited>到一半了！路还长着呢！</edited>
			<subEntries />
		</entry>
		<entry name="KawaYagura_0011" offset="00" relocatable="true" max_length="0">
			<original>注意しろよ！ そろそろ敵も本気出してくんゾ！</original>
			<edited>小心！敌人也差不多要动真格了！</edited>
			<subEntries />
		</entry>
		<entry name="KawaYagura_0012" offset="00" relocatable="true" max_length="0">
			<original>危なくなったら、いったんヤグラから はなれましょう</original>
			<edited>危险时，先离开塔楼吧。</edited>
			<subEntries />
		</entry>
		<entry name="KawaYagura_0013" offset="00" relocatable="true" max_length="0">
			<original>ゲーッ！ 乗ってきやがった！</original>
			<edited>呃！它们上来了！</edited>
			<subEntries />
		</entry>
		<entry name="KawaYagura_0014" offset="00" relocatable="true" max_length="0">
			<original>川に落ちないよう 注意です！</original>
			<edited>小心别掉进河里！</edited>
			<subEntries />
		</entry>
		<entry name="KawaYagura_0015" offset="00" relocatable="true" max_length="0">
			<original>敵ん中 トツゲキもいいけど、ヤグラを運ぶんだゾ</original>
			<edited>冲进敌群也行，但别忘了推进塔楼！</edited>
			<subEntries />
		</entry>
		<entry name="KawaYagura_0016" offset="00" relocatable="true" max_length="0">
			<original>ヤグラは降りると、どんどんもどっちゃいますからね</original>
			<edited>离开塔楼后，它会不断往回退哦。</edited>
			<subEntries />
		</entry>
		<entry name="KawaYagura_0017" offset="00" relocatable="true" max_length="0">
			<original>ゴールは目の前！ 負けんじゃねーゾ！</original>
			<edited>终点就在眼前！别认输啊！</edited>
			<subEntries />
		</entry>
		<entry name="KawaYagura_0018" offset="00" relocatable="true" max_length="0">
			<original>８号さん、がんばって～！</original>
			<edited>8号，加油～！</edited>
			<subEntries />
		</entry>
		<entry name="KawaYagura_0019" offset="00" relocatable="true" max_length="0">
			<original>これでゴールだーっ！</original>
			<edited>这样就到终点啦！</edited>
			<subEntries />
		</entry>
		<entry name="KawaYagura_0020" offset="00" relocatable="true" max_length="0">
			<original>あらら～、みなさんおそろいですね…</original>
			<edited>哎呀呀～，大家都到齐了呢……</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>風船マト５０コ、全て壊すのでス</original>
			<edited>请打坏全部50个气球靶</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>風船マトを１つでも のがすとアウトでス</original>
			<edited>漏掉1个气球靶就算出局</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>風船マトは すぐににげるので 急ぎましょウ</original>
			<edited>气球靶会很快逃跑，抓紧吧</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0003" offset="00" relocatable="true" max_length="0">
			<original>ジャンプで 向こうに着いたら 始まりまス</original>
			<edited>跳到对面落地即开始</edited>
			<subEntries />
		</entry>
		<entry name="BaloonIsland_0001" offset="00" relocatable="true" max_length="0">
			<original>４０コ 壊しました！ あと１０コです！</original>
			<edited>打坏了40个！还剩10个！</edited>
			<subEntries />
		</entry>
		<entry name="BaloonIsland_0002" offset="00" relocatable="true" max_length="0">
			<original>あと半分だ！</original>
			<edited>还剩一半！</edited>
			<subEntries />
		</entry>
		<entry name="BaloonIsland_0003" offset="00" relocatable="true" max_length="0">
			<original>フォー！ あと１つじゃ！</original>
			<edited>哦哦！就剩1个！</edited>
			<subEntries />
		</entry>
		<entry name="BaloonIsland_0004" offset="00" relocatable="true" max_length="0">
			<original>あと少しです！</original>
			<edited>就差一点了！</edited>
			<subEntries />
		</entry>
		<entry name="BaloonIsland_0005" offset="00" relocatable="true" max_length="0">
			<original>風船マト にげる前に撃て！</original>
			<edited>在气球靶逃跑前打中它！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
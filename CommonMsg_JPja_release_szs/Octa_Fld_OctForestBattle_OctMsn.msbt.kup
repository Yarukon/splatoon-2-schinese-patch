<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>ゴールポイントを撃って起動、さわればチャレンジ完了でス</original>
			<edited>射击终点来启动，触碰即可完成挑战</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>ルーガ森は 視界が悪いので、気をつけてくださイ</original>
			<edited>卢加森林视野差，请小心</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>むしろ、木を利用しましょウ</original>
			<edited>不如利用树木吧</edited>
			<subEntries />
		</entry>
		<entry name="ForestBattle_0000" offset="00" relocatable="true" max_length="0">
			<original>改札をぬけたら森とは… &#xE;&#x1;&#x0;&#x4;&#xF;&#x0;&#x0;&#x0;一体、どうなっとるんじゃ？</original>
			<edited>穿过检票口就是森林… &#xE;&#x1;&#x0;&#x4;&#xF;&#x0;&#x0;&#x0;到底是怎么回事？</edited>
			<subEntries />
		</entry>
		<entry name="ForestBattle_0001" offset="00" relocatable="true" max_length="0">
			<original>…タイショウ ヲ ハッケン</original>
			<edited>…发现 目标</edited>
			<subEntries />
		</entry>
		<entry name="ForestBattle_0002" offset="00" relocatable="true" max_length="0">
			<original>タコゾネスは おヌシの仲間じゃろ？ &#xE;&#x1;&#x0;&#x4;&#xF;&#x0;&#x0;&#x0;話しかけてみんか？</original>
			<edited>章鱼女战士是你的同伴吧？ &#xE;&#x1;&#x0;&#x4;&#xF;&#x0;&#x0;&#x0;要不要去搭话？</edited>
			<subEntries />
		</entry>
		<entry name="ForestBattle_0003" offset="00" relocatable="true" max_length="0">
			<original>シマツセヨ</original>
			<edited>处理掉</edited>
			<subEntries />
		</entry>
		<entry name="ForestBattle_0004" offset="00" relocatable="true" max_length="0">
			<original>どうやら 話が通じるフンイキでは なさそうじゃぞ！</original>
			<edited>看来不是能沟通的气氛啊！</edited>
			<subEntries />
		</entry>
		<entry name="ForestBattle_0005" offset="00" relocatable="true" max_length="0">
			<original>ファッ！ 道が開けた… 倒すのが正解のようじゃな</original>
			<edited>哎呀！路开了…看来打倒是正确的</edited>
			<subEntries />
		</entry>
		<entry name="ForestBattle_0006" offset="00" relocatable="true" max_length="0">
			<original>タイショウヲ カクニン… シマツセヨ</original>
			<edited>确认目标…处理掉</edited>
			<subEntries />
		</entry>
		<entry name="ForestBattle_0007" offset="00" relocatable="true" max_length="0">
			<original>新手じゃ！ &#xE;&#x1;&#x0;&#x4;&#xF;&#x0;&#x0;&#x0;今度は２体とな！</original>
			<edited>来新敌人了！ &#xE;&#x1;&#x0;&#x4;&#xF;&#x0;&#x0;&#x0;这次是2只！</edited>
			<subEntries />
		</entry>
		<entry name="ForestBattle_0008" offset="00" relocatable="true" max_length="0">
			<original>きゃつら 魂がぬけとるようじゃ… &#xE;&#x1;&#x0;&#x4;&#xF;&#x0;&#x0;&#x0;おヌシ、心当たりは？</original>
			<edited>它们好像丢了魂似的… &#xE;&#x1;&#x0;&#x4;&#xF;&#x0;&#x0;&#x0;你，知道是怎么回事吗？</edited>
			<subEntries />
		</entry>
		<entry name="ForestBattle_0009" offset="00" relocatable="true" max_length="0">
			<original>まぁよい… &#xE;&#x1;&#x0;&#x4;&#xF;&#x0;&#x0;&#x0;次の道が開いたようじゃし、先に進むかの</original>
			<edited>也罢… &#xE;&#x1;&#x0;&#x4;&#xF;&#x0;&#x0;&#x0;路好像开了，继续前进吧</edited>
			<subEntries />
		</entry>
		<entry name="ForestBattle_0010" offset="00" relocatable="true" max_length="0">
			<original>タイショウヲ カクニン… シマツセヨ</original>
			<edited>确认目标…处理掉</edited>
			<subEntries />
		</entry>
		<entry name="ForestBattle_0011" offset="00" relocatable="true" max_length="0">
			<original>また来たぞィ！</original>
			<edited>又来了！</edited>
			<subEntries />
		</entry>
		<entry name="ForestBattle_0012" offset="00" relocatable="true" max_length="0">
			<original>フォー！ &#xE;&#x1;&#x0;&#x4;&#xF;&#x0;&#x0;&#x0;なんともハイカラなブキじゃのゥ！！</original>
			<edited>哦哦！ &#xE;&#x1;&#x0;&#x4;&#xF;&#x0;&#x0;&#x0;真是时髦的武器啊！！</edited>
			<subEntries />
		</entry>
		<entry name="ForestBattle_0013" offset="00" relocatable="true" max_length="0">
			<original>あわてるな！ &#xE;&#x1;&#x0;&#x4;&#xF;&#x0;&#x0;&#x0;木にかくれて様子を見ィ！</original>
			<edited>别慌！ &#xE;&#x1;&#x0;&#x4;&#xF;&#x0;&#x0;&#x0;躲到树后观察情况！</edited>
			<subEntries />
		</entry>
		<entry name="ForestBattle_0014" offset="00" relocatable="true" max_length="0">
			<original>ふぅ… なんとか切りぬけたのゥ</original>
			<edited>呼… 总算闯过来了</edited>
			<subEntries />
		</entry>
		<entry name="ForestBattle_0015" offset="00" relocatable="true" max_length="0">
			<original>門が開いたぞィ！ &#xE;&#x1;&#x0;&#x4;&#xF;&#x0;&#x0;&#x0;ここから出られるかの？</original>
			<edited>门开了！ &#xE;&#x1;&#x0;&#x4;&#xF;&#x0;&#x0;&#x0;能从这里出去吗？</edited>
			<subEntries />
		</entry>
		<entry name="ForestBattle_0016" offset="00" relocatable="true" max_length="0">
			<original>タコがタコをおそうとは… &#xE;&#x1;&#x0;&#x4;&#xF;&#x0;&#x0;&#x0;一体どうなっとるんじゃ</original>
			<edited>章鱼竟敢攻击章鱼… &#xE;&#x1;&#x0;&#x4;&#xF;&#x0;&#x0;&#x0;到底是怎么回事</edited>
			<subEntries />
		</entry>
		<entry name="ForestBattle_0017" offset="00" relocatable="true" max_length="0">
			<original>ヌッ？！ &#xE;&#x1;&#x0;&#x4;&#xF;&#x0;&#x0;&#x0;きゃつめ、仲間を攻撃するつもりか！</original>
			<edited>嗯？！ &#xE;&#x1;&#x0;&#x4;&#xF;&#x0;&#x0;&#x0;那家伙，打算攻击同伴吗！</edited>
			<subEntries />
		</entry>
		<entry name="ForestBattle_0018" offset="00" relocatable="true" max_length="0">
			<original>むぅ… やられる前にやれィ！ &#xE;&#x1;&#x0;&#x4;&#xF;&#x0;&#x0;&#x0;戦場の鉄則じゃ！</original>
			<edited>唔… 在被干掉之前先下手！ &#xE;&#x1;&#x0;&#x4;&#xF;&#x0;&#x0;&#x0;这是战场的铁则！</edited>
			<subEntries />
		</entry>
		<entry name="ForestBattle_0019" offset="00" relocatable="true" max_length="0">
			<original>ゴールポイントが起動したら、さわってチャレンジクリアでス</original>
			<edited>终点启动后，触碰即可通关挑战</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
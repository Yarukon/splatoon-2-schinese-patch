<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>タコスナイパー１０体全て、倒してくださイ</original>
			<edited>请打倒全部十个章鱼狙击兵。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>かくれて移動、スキをついて撃ちましょウ</original>
			<edited>藏身移动，趁空隙射击吧。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>カーリングボムは、移動やオトリに便利でス</original>
			<edited>冰壶炸弹用于移动和当诱饵都很方便。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0003" offset="00" relocatable="true" max_length="0">
			<original>チャージキープに自信があるなら、スコープ無しのがいいでス</original>
			<edited>对保持蓄力有信心的话，不带瞄准镜的更合适。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0004" offset="00" relocatable="true" max_length="0">
			<original>スコープ付きのものは 射程が少しだけ長いでス</original>
			<edited>带瞄准镜的射程稍长。</edited>
			<subEntries />
		</entry>
		<entry name="ChargeRoom_0000" offset="00" relocatable="true" max_length="0">
			<original>まずは２体！</original>
			<edited>先来2个！</edited>
			<subEntries />
		</entry>
		<entry name="ChargeRoom_0001" offset="00" relocatable="true" max_length="0">
			<original>次は３体出ました！</original>
			<edited>这次出来3个！</edited>
			<subEntries />
		</entry>
		<entry name="ChargeRoom_0002" offset="00" relocatable="true" max_length="0">
			<original>今度は４体です！</original>
			<edited>这次是4个！</edited>
			<subEntries />
		</entry>
		<entry name="ChargeRoom_0004" offset="00" relocatable="true" max_length="0">
			<original>センプクでかくれて ゆっくり移動するといいゾ</original>
			<edited>潜行躲藏，慢慢移动比较好。</edited>
			<subEntries />
		</entry>
		<entry name="ChargeRoom_0005" offset="00" relocatable="true" max_length="0">
			<original>いいゾ！ センプクで様子見だ！</original>
			<edited>好！潜行观察情况！</edited>
			<subEntries />
		</entry>
		<entry name="ChargeRoom_0006" offset="00" relocatable="true" max_length="0">
			<original>オトリや移動に便利ですね♪</original>
			<edited>用来当诱饵和移动都很方便呢♪</edited>
			<subEntries />
		</entry>
		<entry name="ChargeRoom_0007" offset="00" relocatable="true" max_length="0">
			<original>カーリングボムも使えよ！</original>
			<edited>也用用冰壶炸弹！</edited>
			<subEntries />
		</entry>
		<entry name="ChargeRoom_0008" offset="00" relocatable="true" max_length="0">
			<original>カベにかくれて、敵がスキを見せたら撃つんじゃ！</original>
			<edited>躲在墙后，等敌人露出破绽再射击！</edited>
			<subEntries />
		</entry>
		<entry name="ChargeRoom_0009" offset="00" relocatable="true" max_length="0">
			<original>ナイスです♪ さぁ、センプクで様子を見ましょ～</original>
			<edited>干得漂亮♪来，潜行观察情况吧～</edited>
			<subEntries />
		</entry>
		<entry name="ChargeRoom_0010" offset="00" relocatable="true" max_length="0">
			<original>最後です！ またセンプクして、様子を見ましょ～</original>
			<edited>最后一个！再潜行观察一下吧～</edited>
			<subEntries />
		</entry>
		<entry name="ChargeRoom_0011" offset="00" relocatable="true" max_length="0">
			<original>なんだなんだ？！</original>
			<edited>怎么了怎么了？！</edited>
			<subEntries />
		</entry>
		<entry name="ChargeRoom_0012" offset="00" relocatable="true" max_length="0">
			<original>最後はUFOときたか！ しっかと、撃ち落とせィ！</original>
			<edited>最后居然是UFO！好好把它打下来！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
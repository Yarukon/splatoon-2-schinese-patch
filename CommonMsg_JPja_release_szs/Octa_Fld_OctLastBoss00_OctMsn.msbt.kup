<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="LastBoss00_0000" offset="00" relocatable="true" max_length="0">
			<original>しまったッ！ ８号は、ブキを持っとらんぞィ！</original>
			<edited>糟了！8号没有武器！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss00_0001" offset="00" relocatable="true" max_length="0">
			<original>８号さん！ 敵に見つからないように進んでください！</original>
			<edited>8号！别被敌人发现，前进吧！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss00_0002" offset="00" relocatable="true" max_length="0">
			<original>ゲッ、敵！ センプクで行くしかねーな…</original>
			<edited>呃，敌人！只能潜行过去了…</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss00_0004" offset="00" relocatable="true" max_length="0">
			<original>速く移動すると しぶきが立って、見つかりますよ！</original>
			<edited>快速移动会激起水花，被发现！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss00_0006" offset="00" relocatable="true" max_length="0">
			<original>ゔぇぇ… 息がつまりそうだゾ…</original>
			<edited>呜… 快喘不过气了…</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss00_0008" offset="00" relocatable="true" max_length="0">
			<original>敵出現ポイントがあります！ 見つかると 敵が増えます！</original>
			<edited>有敌人出现点！被发现敌人会增加！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss00_0009" offset="00" relocatable="true" max_length="0">
			<original>インクの道、切れてんゾ！ 敵が背を向けた時に 行け！</original>
			<edited>墨汁路断了！趁敌人转身时过去！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss00_0011" offset="00" relocatable="true" max_length="0">
			<original>敵のインクがジャマだなー…</original>
			<edited>敌人的墨汁真碍事…</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss00_0015" offset="00" relocatable="true" max_length="0">
			<original>ふぅ… そー言えばジジィ、そっちの様子はどうよ？</original>
			<edited>呼… 话说老头子，你那边情况怎么样？</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss00_0016" offset="00" relocatable="true" max_length="0">
			<original>３号なら、まだノビとるぞィ！</original>
			<edited>3号啊，还在睡呢！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss00_0017" offset="00" relocatable="true" max_length="0">
			<original>しかし、ブキが無いと 話になんねーな…</original>
			<edited>不过，没有武器可没法打…</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss00_0018" offset="00" relocatable="true" max_length="0">
			<original>ジャンプポイントの先に ブキの反応がありますよ！</original>
			<edited>跳跃点前面有武器反应！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss00_0022" offset="00" relocatable="true" max_length="0">
			<original>ッシャー！ ナイス！</original>
			<edited>好嘞！漂亮！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss00_0023" offset="00" relocatable="true" max_length="0">
			<original>ジャンプポイントです！ あの先で ブキをゲットしましょう！</original>
			<edited>是跳跃点！去那边拿武器吧！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss00_0026" offset="00" relocatable="true" max_length="0">
			<original>あぶなかった… 地上まで 気を引きしめてけよ！</original>
			<edited>好险… 到地面之前绷紧神经！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss00_0027" offset="00" relocatable="true" max_length="0">
			<original>全然見つかんなかったな！ この調子で地上を目指せ！</original>
			<edited>完全没被发现！照这势头朝地面前进！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
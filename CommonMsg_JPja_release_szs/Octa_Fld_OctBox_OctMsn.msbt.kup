<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>強力な敵を倒すチャレンジとなりまス</original>
			<edited>这是击败强敌的挑战。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>ブキの射程をイカしましょウ</original>
			<edited>善用武器的射程吧。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>危なくなったら、場外で 息を整えましょウ</original>
			<edited>危险时，就到场外喘口气吧。</edited>
			<subEntries />
		</entry>
		<entry name="Box_0000" offset="00" relocatable="true" max_length="0">
			<original>あれは！タコツボックス！</original>
			<edited>那是！蛸壶箱！</edited>
			<subEntries />
		</entry>
		<entry name="Box_0001" offset="00" relocatable="true" max_length="0">
			<original>昔、３号が破壊したはずじゃが…</original>
			<edited>以前应该被3号打坏过才对……</edited>
			<subEntries />
		</entry>
		<entry name="Box_0002" offset="00" relocatable="true" max_length="0">
			<original>昔の話なんか知んねーし！ ハチ、ぶっ倒すゾ！</original>
			<edited>以前的事谁知道啊！小八，干掉它！</edited>
			<subEntries />
		</entry>
		<entry name="Box_0003" offset="00" relocatable="true" max_length="0">
			<original>あっ、タッチパネルが増えたゾ！</original>
			<edited>啊，触控面板变多了！</edited>
			<subEntries />
		</entry>
		<entry name="Box_0004" offset="00" relocatable="true" max_length="0">
			<original>ゲーーッ！！ なんじゃありゃー！</original>
			<edited>哇啊！！那是什么！</edited>
			<subEntries />
		</entry>
		<entry name="Box_0005" offset="00" relocatable="true" max_length="0">
			<original>あれは、保冷効果バツグンの塗れないヨロイじゃ！！</original>
			<edited>那是保冷效果绝佳、无法涂墨的铠甲！！</edited>
			<subEntries />
		</entry>
		<entry name="Box_0006" offset="00" relocatable="true" max_length="0">
			<original>……ですね</original>
			<edited>……确实如此。</edited>
			<subEntries />
		</entry>
		<entry name="Box_0007" offset="00" relocatable="true" max_length="0">
			<original>スタンプ攻撃は、横によけれそうだな！</original>
			<edited>印章攻击好像能往旁边躲！</edited>
			<subEntries />
		</entry>
		<entry name="Box_0008" offset="00" relocatable="true" max_length="0">
			<original>横によけるのはマズい！ 退くんじゃ！</original>
			<edited>往旁边躲不行！快往后退！</edited>
			<subEntries />
		</entry>
		<entry name="Box_0009" offset="00" relocatable="true" max_length="0">
			<original>アイツの体、塗ったら登れそーだな！</original>
			<edited>那家伙身上涂了墨，好像就能爬上去！</edited>
			<subEntries />
		</entry>
		<entry name="Box_0010" offset="00" relocatable="true" max_length="0">
			<original>スタンプの後がチャンス！ 塗って登りましょ～</original>
			<edited>印章攻击后就是机会！涂墨爬上去吧～</edited>
			<subEntries />
		</entry>
		<entry name="Box_0011" offset="00" relocatable="true" max_length="0">
			<original>移動ショット中に&#xE;&#x2;&#x18;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;で スライドだ！ バシュッとよけろ！</original>
			<edited>移动射击时，按&#xE;&#x2;&#x18;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;滑步！嗖地躲开！</edited>
			<subEntries />
		</entry>
		<entry name="Box_0012" offset="00" relocatable="true" max_length="0">
			<original>言っちゃいます！ 鼻のタッチパネルが弱点です！</original>
			<edited>我就直说了！鼻子上的触控面板是弱点！</edited>
			<subEntries />
		</entry>
		<entry name="Box_0013" offset="00" relocatable="true" max_length="0">
			<original>弱点を 全部壊すんじゃ！</original>
			<edited>把所有弱点都打坏！</edited>
			<subEntries />
		</entry>
		<entry name="Box_0014" offset="00" relocatable="true" max_length="0">
			<original>弱点を 全部壊すんじゃ！</original>
			<edited>把所有弱点都打坏！</edited>
			<subEntries />
		</entry>
		<entry name="Box_0015" offset="00" relocatable="true" max_length="0">
			<original>カーリングボムで にげるのもテだな！</original>
			<edited>用冰壶炸弹逃跑也是个办法！</edited>
			<subEntries />
		</entry>
		<entry name="Box_0016" offset="00" relocatable="true" max_length="0">
			<original>フォーーッ！ あんなトコから 飛んで来るとはのゥ！</original>
			<edited>哦哦！居然从那种地方飞过来！</edited>
			<subEntries />
		</entry>
		<entry name="Box_0017" offset="00" relocatable="true" max_length="0">
			<original>疑似バブルランチャーです！ よけるか壊すか…</original>
			<edited>是疑似泡泡发射器！要么躲开，要么打掉……</edited>
			<subEntries />
		</entry>
		<entry name="Box_0018" offset="00" relocatable="true" max_length="0">
			<original>連続攻撃は、スライドで まとめてよけろ！</original>
			<edited>连续攻击，用滑步一口气躲开！</edited>
			<subEntries />
		</entry>
		<entry name="Box_0019" offset="00" relocatable="true" max_length="0">
			<original>連続攻撃は、まとめてよけろ！</original>
			<edited>连续攻击，一口气躲开！</edited>
			<subEntries />
		</entry>
		<entry name="Box_0020" offset="00" relocatable="true" max_length="0">
			<original>シャオラー！ ハチ、いいゾ！</original>
			<edited>哇哦！小八，干得好！</edited>
			<subEntries />
		</entry>
		<entry name="Box_0021" offset="00" relocatable="true" max_length="0">
			<original>シャー！ ヨロイが外れたゾ！</original>
			<edited>好！铠甲掉下来了！</edited>
			<subEntries />
		</entry>
		<entry name="Box_0022" offset="00" relocatable="true" max_length="0">
			<original>８号さん、ナイスです！</original>
			<edited>8号，干得漂亮！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
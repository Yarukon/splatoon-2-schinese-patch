<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="LastBoss02_0000" offset="00" relocatable="true" max_length="0">
			<original>次は エネルギーコアを探します！ 上を目指しましょう！</original>
			<edited>接下来去找能量核心！目标是上面！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss02_0001" offset="00" relocatable="true" max_length="0">
			<original>８号さんの端末からです！ 地上に近づいてるんですよ！</original>
			<edited>是从8号的终端传来的！我们正在接近地面哦！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss02_0002" offset="00" relocatable="true" max_length="0">
			<original>…いや、行けねーだろ</original>
			<edited>……不，走不过去吧。</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss02_0003" offset="00" relocatable="true" max_length="0">
			<original>右方向にドアを発見！ カギを探しましょう！</original>
			<edited>发现右边有门！去找钥匙吧！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss02_0004" offset="00" relocatable="true" max_length="0">
			<original>ハチ！ 上のインクに頭ぶつけんなよ！</original>
			<edited>小八！别一头撞上上面的墨汁！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss02_0005" offset="00" relocatable="true" max_length="0">
			<original>向こう岸に ジャンプポイントが見えるな</original>
			<edited>对岸能看到跳跃点。</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss02_0006" offset="00" relocatable="true" max_length="0">
			<original>手すり付きの地面は 落ちてないゾ！</original>
			<edited>有栏杆的地面不会掉下去！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss02_0007" offset="00" relocatable="true" max_length="0">
			<original>ナイスです～！</original>
			<edited>漂亮～！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss02_0008" offset="00" relocatable="true" max_length="0">
			<original>どっかから ウチらの音楽がきこえなイカ？</original>
			<edited>是不是从哪儿传来我们的音乐了？</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss02_0009" offset="00" relocatable="true" max_length="0">
			<original>ガ… ガガ… ガピー！</original>
			<edited>嘎… 嘎嘎… 嘎皮！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss02_0011" offset="00" relocatable="true" max_length="0">
			<original>わ！ バイソクミサイルタコプターです！</original>
			<edited>哇！是高速导弹章鱼螺旋桨兵！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss02_0012" offset="00" relocatable="true" max_length="0">
			<original>大回りすれば、あちらから行けそうですね</original>
			<edited>绕远一点，好像能从那边过去。</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss02_0013" offset="00" relocatable="true" max_length="0">
			<original>ナイスです！ ドアに向かいましょう！</original>
			<edited>干得漂亮！朝门走吧！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss02_0014" offset="00" relocatable="true" max_length="0">
			<original>ハチ！ 足場、よく見ろ！</original>
			<edited>小八！看好落脚点！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss02_0015" offset="00" relocatable="true" max_length="0">
			<original>トーチャク！ ハチ、そいつをぶっ倒せ！</original>
			<edited>到地方了！小八，干掉那家伙！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss02_0016" offset="00" relocatable="true" max_length="0">
			<original>ナイスですっ！ 門が開いてます！</original>
			<edited>干得漂亮！门开了！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss02_0017" offset="00" relocatable="true" max_length="0">
			<original>シャー！ で、エネルギーコアって何なの？</original>
			<edited>哇！所以，能量核心到底是什么？</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss02_0018" offset="00" relocatable="true" max_length="0">
			<original>うー！ ミコプター、ウゼェ！</original>
			<edited>唔！姬直升机，好烦！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss02_0020" offset="00" relocatable="true" max_length="0">
			<original>ジジィ、なんか言ったか？</original>
			<edited>老头子，你刚才说什么了？</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss02_0021" offset="00" relocatable="true" max_length="0">
			<original>ナイス！ エネルギーコアまで まっしぐらだ！</original>
			<edited>干得漂亮！直奔能量核心！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss02_0022" offset="00" relocatable="true" max_length="0">
			<original>手すりのある場所は 落ちないようですね</original>
			<edited>有栏杆的地方好像不会掉下去。</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss02_0023" offset="00" relocatable="true" max_length="0">
			<original>カギ、探してけー！</original>
			<edited>去找钥匙！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss02_0024" offset="00" relocatable="true" max_length="0">
			<original>上から来るブロックを 乗りついで行きましょ～</original>
			<edited>踩着从上面落下的方块前进吧～</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss02_0025" offset="00" relocatable="true" max_length="0">
			<original>ん？ デンワめ、まだ息があるんかの？</original>
			<edited>嗯？那电话还活着吗？</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss02_0026" offset="00" relocatable="true" max_length="0">
			<original>いや、なんでもないぞィ</original>
			<edited>不，没什么。</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss02_0028" offset="00" relocatable="true" max_length="0">
			<original>そー言えば イイダ</original>
			<edited>话说，饭田……</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>時間内に イカスフィアでゴールしてくださイ</original>
			<edited>请在时间内用鱿鱼球抵达终点</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>改札を通ると同時に カウントダウン開始でス</original>
			<edited>通过检票口的同时开始倒计时</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>チェックポイントごとに 時間が延長されまス</original>
			<edited>每个关卡点会延长时间</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0003" offset="00" relocatable="true" max_length="0">
			<original>イカスフィアは カベをまっすぐにしか登れませン</original>
			<edited>鱿鱼球只能垂直爬墙</edited>
			<subEntries />
		</entry>
		<entry name="Sphere_0001" offset="00" relocatable="true" max_length="0">
			<original>ハチ！ イカスフィアでも &#xE;&#x2;&#x18;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;でジャンプだ！</original>
			<edited>小八！用鱿鱼球也&#xE;&#x2;&#x18;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;跳跃！</edited>
			<subEntries />
		</entry>
		<entry name="Sphere_0002" offset="00" relocatable="true" max_length="0">
			<original>ダッシュ板に乗りましょう！</original>
			<edited>站上冲刺板吧！</edited>
			<subEntries />
		</entry>
		<entry name="Sphere_0006" offset="00" relocatable="true" max_length="0">
			<original>無敵のイカスフィアなら、ヌリヌリ棒の上に乗れそうです</original>
			<edited>无敌的鱿鱼球，好像能站上涂涂棒</edited>
			<subEntries />
		</entry>
		<entry name="Sphere_0007" offset="00" relocatable="true" max_length="0">
			<original>またしてもヌリヌリ棒じゃ！ ひるむな、トツゲキーッ！</original>
			<edited>又是涂涂棒！别怕，冲锋！</edited>
			<subEntries />
		</entry>
		<entry name="Sphere_0008" offset="00" relocatable="true" max_length="0">
			<original>ナイスですね～♪</original>
			<edited>真不错呢～♪</edited>
			<subEntries />
		</entry>
		<entry name="Sphere_0009" offset="00" relocatable="true" max_length="0">
			<original>この上がゴールじゃ！ 行けィ、８号！</original>
			<edited>上面就是终点！上吧，8号！</edited>
			<subEntries />
		</entry>
		<entry name="Sphere_0010" offset="00" relocatable="true" max_length="0">
			<original>あ！ なんか いんゾ！</original>
			<edited>啊！有什么东西！</edited>
			<subEntries />
		</entry>
		<entry name="Sphere_0011" offset="00" relocatable="true" max_length="0">
			<original>オクタリアンめ、ジャマばっかしおって…</original>
			<edited>章鱼族这帮家伙，净捣乱…</edited>
			<subEntries />
		</entry>
		<entry name="Sphere_0012" offset="00" relocatable="true" max_length="0">
			<original>生体反応の無いオクタリアン… なぜ…？</original>
			<edited>没有生命反应的章鱼族… 为什么…？</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
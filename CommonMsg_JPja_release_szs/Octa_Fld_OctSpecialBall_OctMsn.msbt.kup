<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>とちゅうから エイトボールを運ぶコースとなりまス</original>
			<edited>中途开始是要运送8号球的路线</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>やや長めのチャレンジとなりまス</original>
			<edited>这是稍长的挑战</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>集中力を切らさないようにしましょウ</original>
			<edited>保持注意力吧</edited>
			<subEntries />
		</entry>
		<entry name="SpecialBall_0000" offset="00" relocatable="true" max_length="0">
			<original>目の前にエイトボールのゴールが ありますね</original>
			<edited>眼前就有8号球的终点呢</edited>
			<subEntries />
		</entry>
		<entry name="SpecialBall_0001" offset="00" relocatable="true" max_length="0">
			<original>んじゃ、ボール探そーぜ！</original>
			<edited>那么，去找球吧！</edited>
			<subEntries />
		</entry>
		<entry name="SpecialBall_0002" offset="00" relocatable="true" max_length="0">
			<original>ってこたぁ、カギを探さねーとな！</original>
			<edited>也就是说，得去找钥匙！</edited>
			<subEntries />
		</entry>
		<entry name="SpecialBall_0003" offset="00" relocatable="true" max_length="0">
			<original>カギ発見！ 確認されたしーッ！</original>
			<edited>发现钥匙！请确认！</edited>
			<subEntries />
		</entry>
		<entry name="SpecialBall_0004" offset="00" relocatable="true" max_length="0">
			<original>ゲットしたら、ドアに向かいましょう！</original>
			<edited>拿到后，朝门走吧！</edited>
			<subEntries />
		</entry>
		<entry name="SpecialBall_0005" offset="00" relocatable="true" max_length="0">
			<original>ドアの中に、エイトボールを発見しました！</original>
			<edited>在门里发现了8号球！</edited>
			<subEntries />
		</entry>
		<entry name="SpecialBall_0006" offset="00" relocatable="true" max_length="0">
			<original>タマコロちゃんゲットじゃ！ …して、ゴールはどこじゃ？</original>
			<edited>小球球到手了！ …话说，终点在哪？</edited>
			<subEntries />
		</entry>
		<entry name="SpecialBall_0007" offset="00" relocatable="true" max_length="0">
			<original>そして&#xE;&#x2;&#x1C;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;長押しで、ボムを遠くに投げられます！</original>
			<edited>而且&#xE;&#x2;&#x1C;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;长按可以把炸弹投得更远！</edited>
			<subEntries />
		</entry>
		<entry name="SpecialBall_0008" offset="00" relocatable="true" max_length="0">
			<original>フォー！ ふぁんたすてぃっくじゃッ！</original>
			<edited>哦哦！太美妙了！</edited>
			<subEntries />
		</entry>
		<entry name="SpecialBall_0010" offset="00" relocatable="true" max_length="0">
			<original>橋、かかったぞィ！ 確認されたしーッ！</original>
			<edited>桥架好了！请确认！</edited>
			<subEntries />
		</entry>
		<entry name="SpecialBall_0011" offset="00" relocatable="true" max_length="0">
			<original>エイトボールのゴールは 改札の方向です！</original>
			<edited>8号球的终点在检票口方向！</edited>
			<subEntries />
		</entry>
		<entry name="SpecialBall_0012" offset="00" relocatable="true" max_length="0">
			<original>うむ、グッドじゃ！</original>
			<edited>嗯，很好！</edited>
			<subEntries />
		</entry>
		<entry name="SpecialBall_0013" offset="00" relocatable="true" max_length="0">
			<original>ボムピッチャー！ &#xE;&#x2;#&#x8;&lt;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;で発動！ &#xE;&#x2;&#x1C;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;で投げろ！</original>
			<edited>炸弹投手！ &#xE;&#x2;#&#x8;&lt;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;发动！ &#xE;&#x2;&#x1C;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;投出去！</edited>
			<subEntries />
		</entry>
		<entry name="SpecialBall_0014" offset="00" relocatable="true" max_length="0">
			<original>ってこたぁ、とりま カンヅメの方に行けばいいな！</original>
			<edited>也就是说，先朝罐头那边去就行！</edited>
			<subEntries />
		</entry>
		<entry name="SpecialBall_0015" offset="00" relocatable="true" max_length="0">
			<original>わっ！ イカフライ！</original>
			<edited>哇！炸鱿鱼圈！</edited>
			<subEntries />
		</entry>
		<entry name="SpecialBall_0016" offset="00" relocatable="true" max_length="0">
			<original>落ちちゃいましたね… ボールランチャーで もどせますか？</original>
			<edited>掉下去了… 能用球发射器送回去吗？</edited>
			<subEntries />
		</entry>
		<entry name="SpecialBall_0017" offset="00" relocatable="true" max_length="0">
			<original>次は、リフトですね… シンチョ～に行きましょう</original>
			<edited>接下来是升降台… 小心前进吧</edited>
			<subEntries />
		</entry>
		<entry name="SpecialBall_0018" offset="00" relocatable="true" max_length="0">
			<original>ふぇーー… 見ててハラハラしたゾ</original>
			<edited>呼——… 看着都捏把汗</edited>
			<subEntries />
		</entry>
		<entry name="SpecialBall_0019" offset="00" relocatable="true" max_length="0">
			<original>ナイスです！ この先を落ちたところが ゴールです！</original>
			<edited>漂亮！往前掉下去的地方就是终点！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
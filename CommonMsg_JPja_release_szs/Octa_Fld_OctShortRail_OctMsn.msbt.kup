<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>このチャレンジはライドレールがいっぱいでス</original>
			<edited>这个挑战里墨汁轨道很多</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>スライドなら 素早くライドレールに乗れまス</original>
			<edited>用滑步能快速乘上墨汁轨道</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>ボム風船の爆風で ライドレールを起動できまス</original>
			<edited>用炸弹气球的爆风能启动墨汁轨道</edited>
			<subEntries />
		</entry>
		<entry name="ShortRail_0000" offset="00" relocatable="true" max_length="0">
			<original>フォー！ イカしておる！</original>
			<edited>哦哦！真帅气！</edited>
			<subEntries />
		</entry>
		<entry name="ShortRail_0001" offset="00" relocatable="true" max_length="0">
			<original>ボム風船で ライドレールを起動しましょう！</original>
			<edited>用炸弹气球启动墨汁轨道吧！</edited>
			<subEntries />
		</entry>
		<entry name="ShortRail_0002" offset="00" relocatable="true" max_length="0">
			<original>最後まで足元注意ですよ！ ８号さん！</original>
			<edited>到最后都要小心脚下！8号！</edited>
			<subEntries />
		</entry>
		<entry name="ShortRail_0003" offset="00" relocatable="true" max_length="0">
			<original>ここはスライドで バシュってこーぜ！</original>
			<edited>这里用滑步嗖地过去！</edited>
			<subEntries />
		</entry>
		<entry name="ShortRail_0004" offset="00" relocatable="true" max_length="0">
			<original>ふぁびゅらす！ ５０イクラ 連続ゲットじゃ！</original>
			<edited>太棒了！连续拿到50个鲑鱼卵！</edited>
			<subEntries />
		</entry>
		<entry name="ShortRail_0005" offset="00" relocatable="true" max_length="0">
			<original>あめぃじん！ 連続１００イクラ、ゲットじゃ！</original>
			<edited>了不起！连续拿到100个鲑鱼卵！</edited>
			<subEntries />
		</entry>
		<entry name="ShortRail_0006" offset="00" relocatable="true" max_length="0">
			<original>すごいです８号さん！ 追加のイカフライが出てます！</original>
			<edited>太厉害了8号！出现追加的炸鱿鱼圈了！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
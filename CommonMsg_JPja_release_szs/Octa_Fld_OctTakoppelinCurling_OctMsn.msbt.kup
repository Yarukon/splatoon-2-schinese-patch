<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>カーリングボムは&#xE;&#x2;&#x1C;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;長押しで 距離が調整できまス</original>
			<edited>冰壶炸弹，&#xE;&#x2;&#x1C;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;长按可以调整距离</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>メインウェポンは無いので、かわして進みましょウ</original>
			<edited>没有主武器，边躲边前进吧</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>と言いつつ、カーリングボムで 敵をやっつけてもいいでス</original>
			<edited>话虽如此，用冰壶炸弹打敌人也行</edited>
			<subEntries />
		</entry>
		<entry name="TakoppelinCurling_0000" offset="00" relocatable="true" max_length="0">
			<original>なんかいっぱい、飛んでるゾー！</original>
			<edited>好多东西在飞！</edited>
			<subEntries />
		</entry>
		<entry name="TakoppelinCurling_0001" offset="00" relocatable="true" max_length="0">
			<original>タコッペリン号です！ センパイ、好きそうですね～♪</original>
			<edited>是章鱼柏林号！前辈，你好像很喜欢呢～♪</edited>
			<subEntries />
		</entry>
		<entry name="TakoppelinCurling_0002" offset="00" relocatable="true" max_length="0">
			<original>あそこに見えるスイッチ、なんとかできねーか？</original>
			<edited>那边那个开关，能想想办法吗？</edited>
			<subEntries />
		</entry>
		<entry name="TakoppelinCurling_0003" offset="00" relocatable="true" max_length="0">
			<original>ワシも そうすると思っとったぞィ！</original>
			<edited>老夫也猜到你会这么做！</edited>
			<subEntries />
		</entry>
		<entry name="TakoppelinCurling_0004" offset="00" relocatable="true" max_length="0">
			<original>正面にゴールポイントを発見！</original>
			<edited>正面发现终点！</edited>
			<subEntries />
		</entry>
		<entry name="TakoppelinCurling_0005" offset="00" relocatable="true" max_length="0">
			<original>ジャンプ用意！</original>
			<edited>准备跳！</edited>
			<subEntries />
		</entry>
		<entry name="TakoppelinCurling_0006" offset="00" relocatable="true" max_length="0">
			<original>ふぁびゅらすゲットじゃッ！</original>
			<edited>太棒了，拿到了！</edited>
			<subEntries />
		</entry>
		<entry name="TakoppelinCurling_0007" offset="00" relocatable="true" max_length="0">
			<original>ジジィ、ちょいちょい出てくんなー…</original>
			<edited>老头子，别老冒出来…</edited>
			<subEntries />
		</entry>
		<entry name="TakoppelinCurling_0008" offset="00" relocatable="true" max_length="0">
			<original>カーリングボムは&#xE;&#x2;&#x1C;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;長押しで 近くに投げられます！</original>
			<edited>冰壶炸弹，&#xE;&#x2;&#x1C;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;长按可以投到近处！</edited>
			<subEntries />
		</entry>
		<entry name="TakoppelinCurling_0009" offset="00" relocatable="true" max_length="0">
			<original>カーリング一発で 全部取っちゃえ</original>
			<edited>用一发冰壶炸弹全拿走</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
			<subEntries />
		</entry>
		<entry name="Talk_Free_03" offset="00" relocatable="true" max_length="0">
			<original>アレとは何か　教えてよ　you say？&#xE;&#x1;&#x0;&#x4;&#x1E;&#x0;&#x0;&#x0;
アレさえ集めりゃ　ワシらは　優勢？</original>

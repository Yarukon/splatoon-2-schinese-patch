<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>時間内にゴールに到達してくださイ</original>
			<edited>请在时间内抵达终点。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0003" offset="00" relocatable="true" max_length="0">
			<original>最終エリアで、ボールバンパーを早く壊すのが ポイントでス</original>
			<edited>关键是在最后区域尽快打坏球缓冲板。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0004" offset="00" relocatable="true" max_length="0">
			<original>なので、エイトボールは 多く持って行くほど 有利でス</original>
			<edited>所以，带的8号球越多越有利。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0005" offset="00" relocatable="true" max_length="0">
			<original>ただし、エイトボールは１つでも落とすと 失敗でス</original>
			<edited>不过，8号球哪怕掉一个也算失败。</edited>
			<subEntries />
		</entry>
		<entry name="GhostBall_0000" offset="00" relocatable="true" max_length="0">
			<original>おしゃべり無用！ カウントダウン、始まっとるぞィ！</original>
			<edited>别磨蹭！倒计时已经开始了！</edited>
			<subEntries />
		</entry>
		<entry name="GhostBall_0001" offset="00" relocatable="true" max_length="0">
			<original>バンパー壊して、ジャンプポイント出すゾ！</original>
			<edited>打坏缓冲板，让跳跃点出现！</edited>
			<subEntries />
		</entry>
		<entry name="GhostBall_0002" offset="00" relocatable="true" max_length="0">
			<original>ボールバンパーの裏に ジャンプポイントがかくれてます！</original>
			<edited>球缓冲板后面藏着跳跃点！</edited>
			<subEntries />
		</entry>
		<entry name="GhostBall_0003" offset="00" relocatable="true" max_length="0">
			<original>ボールもう１コあるゾ！ 持ってこーぜ</original>
			<edited>还有一个球！搬过来吧！</edited>
			<subEntries />
		</entry>
		<entry name="GhostBall_0004" offset="00" relocatable="true" max_length="0">
			<original>了解！ 敵は無視して、エイトボールを運んでください！</original>
			<edited>明白！别管敌人，运送8号球！</edited>
			<subEntries />
		</entry>
		<entry name="GhostBall_0005" offset="00" relocatable="true" max_length="0">
			<original>あの大量のバンパーを壊す時に 役立ちそうですね</original>
			<edited>打坏那堆缓冲板时好像用得上。</edited>
			<subEntries />
		</entry>
		<entry name="GhostBall_0006" offset="00" relocatable="true" max_length="0">
			<original>正面に、別のボールがあるゾ！</original>
			<edited>正面还有另一个球！</edited>
			<subEntries />
		</entry>
		<entry name="GhostBall_0007" offset="00" relocatable="true" max_length="0">
			<original>ジャンプポイント発見！ 確認されたしーッ！</original>
			<edited>发现跳跃点！请确认！</edited>
			<subEntries />
		</entry>
		<entry name="GhostBall_0008" offset="00" relocatable="true" max_length="0">
			<original>ジャンプポイントを発見しました！</original>
			<edited>发现跳跃点了！</edited>
			<subEntries />
		</entry>
		<entry name="GhostBall_0009" offset="00" relocatable="true" max_length="0">
			<original>なんか いっぱい積まれてたな！</original>
			<edited>堆了好多啊！</edited>
			<subEntries />
		</entry>
		<entry name="GhostBall_0010" offset="00" relocatable="true" max_length="0">
			<original>バンパーなら後で、エイトボールで 壊しまくりましょ～</original>
			<edited>缓冲板的事以后再说，先用8号球撞个痛快吧～</edited>
			<subEntries />
		</entry>
		<entry name="GhostBall_0011" offset="00" relocatable="true" max_length="0">
			<original>グッドじゃった！</original>
			<edited>干得漂亮！</edited>
			<subEntries />
		</entry>
		<entry name="GhostBall_0012" offset="00" relocatable="true" max_length="0">
			<original>お！ ジャンプポイント、行けんじゃね？</original>
			<edited>哦！能从跳跃点过去吧？</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
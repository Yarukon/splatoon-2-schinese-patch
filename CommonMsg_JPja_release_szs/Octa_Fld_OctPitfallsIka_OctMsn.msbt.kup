<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>壊れる足場から落ちずに 戦うのでス</original>
			<edited>战斗时小心别从会碎的平台上掉下去。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>ムダ撃ちは 大変キケンでス</original>
			<edited>乱射很危险。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>固い木箱の位置を確認しましょウ</original>
			<edited>确认牢固木箱的位置吧。</edited>
			<subEntries />
		</entry>
		<entry name="PitfallsIka_0000" offset="00" relocatable="true" max_length="0">
			<original>なんだ ありゃあ…</original>
			<edited>那是什么…</edited>
			<subEntries />
		</entry>
		<entry name="PitfallsIka_0001" offset="00" relocatable="true" max_length="0">
			<original>あそこが 戦いの場になるようですね</original>
			<edited>那里就是战场。</edited>
			<subEntries />
		</entry>
		<entry name="PitfallsIka_0002" offset="00" relocatable="true" max_length="0">
			<original>ファッ？！ これじゃと足場がインクで壊れるのゥ！</original>
			<edited>哎呀？！这样会把平台用墨汁打碎！</edited>
			<subEntries />
		</entry>
		<entry name="PitfallsIka_0003" offset="00" relocatable="true" max_length="0">
			<original>ヒッセンは射程が短いんだよ！ もっと距離をつめろ</original>
			<edited>毛刷射程短！再靠近一点！</edited>
			<subEntries />
		</entry>
		<entry name="PitfallsIka_0004" offset="00" relocatable="true" max_length="0">
			<original>遠くへにげられたら いったんはなれて、おびき出しましょう</original>
			<edited>对手逃远了就先拉开距离，把它引出来。</edited>
			<subEntries />
		</entry>
		<entry name="PitfallsIka_0005" offset="00" relocatable="true" max_length="0">
			<original>敵が増えたゾ！</original>
			<edited>敌人增多了！</edited>
			<subEntries />
		</entry>
		<entry name="PitfallsIka_0006" offset="00" relocatable="true" max_length="0">
			<original>バイソクタコプターは 移動したあとをねらいましょう！</original>
			<edited>高速章鱼螺旋桨兵！等它移动后再瞄准！</edited>
			<subEntries />
		</entry>
		<entry name="PitfallsIka_0007" offset="00" relocatable="true" max_length="0">
			<original>ゲッ！ ヤベェの出てきた！</original>
			<edited>呃！来了个麻烦的家伙！</edited>
			<subEntries />
		</entry>
		<entry name="PitfallsIka_0008" offset="00" relocatable="true" max_length="0">
			<original>バイソクボムタコプターは、ブースト移動後に攻撃で！</original>
			<edited>高速炸弹章鱼螺旋桨兵！等它冲刺后再攻击！</edited>
			<subEntries />
		</entry>
		<entry name="PitfallsIka_0009" offset="00" relocatable="true" max_length="0">
			<original>近づけないなら クイックボム！ 戦場の鉄則ゥ！</original>
			<edited>靠近不了就用快速炸弹！战场铁则！</edited>
			<subEntries />
		</entry>
		<entry name="PitfallsIka_0010" offset="00" relocatable="true" max_length="0">
			<original>インク撃ったら どんどん足場を変えてけよ！</original>
			<edited>涂过墨就不断换平台！</edited>
			<subEntries />
		</entry>
		<entry name="PitfallsIka_0011" offset="00" relocatable="true" max_length="0">
			<original>イクラ入りの木箱は 敵のインクでは 壊れないようです！</original>
			<edited>装有鲑鱼卵的木箱，敌人的墨汁打不坏！</edited>
			<subEntries />
		</entry>
		<entry name="PitfallsIka_0012" offset="00" relocatable="true" max_length="0">
			<original>ハチ！ ロゴ入り木箱の上で戦え！</original>
			<edited>小八！站在带标记的木箱上战斗！</edited>
			<subEntries />
		</entry>
		<entry name="PitfallsIka_0013" offset="00" relocatable="true" max_length="0">
			<original>近くの敵は、ヨコ振りで木箱を温存しましょ～</original>
			<edited>对近处敌人用横挥，保住木箱！</edited>
			<subEntries />
		</entry>
		<entry name="PitfallsIka_0014" offset="00" relocatable="true" max_length="0">
			<original>遠くの敵は、かたい木箱の上でタテ振りドンッだ！</original>
			<edited>对远处敌人，站在牢固木箱上用纵挥砸！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
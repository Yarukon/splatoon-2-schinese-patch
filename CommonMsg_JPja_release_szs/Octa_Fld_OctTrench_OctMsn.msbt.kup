<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>敵が多めのチャレンジとなりまス</original>
			<edited>这关敌人较多。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>スロッシャーはタテの上をこえて 攻撃ができまス</original>
			<edited>泼桶能越过障碍攻击。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>ブラスターは爆風で タテをカワして攻撃できまス</original>
			<edited>爆破枪能用爆风越过障碍攻击。</edited>
			<subEntries />
		</entry>
		<entry name="Trench_0000" offset="00" relocatable="true" max_length="0">
			<original>この先は敵が大量っぽいな！ 気合入れてけ！</original>
			<edited>前面敌人好像很多！打起精神！</edited>
			<subEntries />
		</entry>
		<entry name="Trench_0001" offset="00" relocatable="true" max_length="0">
			<original>迷路みたいですね… 死角に注意です！</original>
			<edited>像迷宫一样……小心死角！</edited>
			<subEntries />
		</entry>
		<entry name="Trench_0002" offset="00" relocatable="true" max_length="0">
			<original>タテ持ちは 上とか横からインクかけてけ！</original>
			<edited>持盾章鱼，从上面或侧面泼墨！</edited>
			<subEntries />
		</entry>
		<entry name="Trench_0003" offset="00" relocatable="true" max_length="0">
			<original>よく切りぬけたのゥ！ グッドじゃ！</original>
			<edited>真能闯啊！干得好！</edited>
			<subEntries />
		</entry>
		<entry name="Trench_0004" offset="00" relocatable="true" max_length="0">
			<original>集合住宅…？ 上にゴール見えたし登ればよさそーだな</original>
			<edited>公寓……？上面能看到终点，爬上去就行！</edited>
			<subEntries />
		</entry>
		<entry name="Trench_0005" offset="00" relocatable="true" max_length="0">
			<original>よーしッ！ 屋上に とうちゃくじゃ！</original>
			<edited>好！抵达屋顶！</edited>
			<subEntries />
		</entry>
		<entry name="Trench_0006" offset="00" relocatable="true" max_length="0">
			<original>タココマンダーがいます！ 気をつけてください！</original>
			<edited>有章鱼指挥官！小心！</edited>
			<subEntries />
		</entry>
		<entry name="Trench_0007" offset="00" relocatable="true" max_length="0">
			<original>敵に気をつけろよ！！</original>
			<edited>小心敌人！！</edited>
			<subEntries />
		</entry>
		<entry name="Trench_0008" offset="00" relocatable="true" max_length="0">
			<original>こんなところに インクレールが！</original>
			<edited>这种地方居然有墨汁轨道！</edited>
			<subEntries />
		</entry>
		<entry name="Trench_0009" offset="00" relocatable="true" max_length="0">
			<original>建設中… てゆっか、ただのハリボテだったな！</original>
			<edited>施工中……其实只是个纸板模型！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>ヌリヌリ棒を ライドレールですりぬけるチャレンジでス</original>
			<edited>这是用墨汁轨道穿过涂涂棒的挑战</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>でんでんスイッチは 同じ攻撃で同じだけ動きまス</original>
			<edited>转转开关用相同攻击会移动相同距离</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>ライドレールでヌリヌリ棒に当たると 落ちてしまいまス</original>
			<edited>在墨汁轨道上撞到涂涂棒会掉下去</edited>
			<subEntries />
		</entry>
		<entry name="NuriRide_0000" offset="00" relocatable="true" max_length="0">
			<original>ナイスフライです！</original>
			<edited>飞得漂亮！</edited>
			<subEntries />
		</entry>
		<entry name="NuriRide_0001" offset="00" relocatable="true" max_length="0">
			<original>グルグルしてんなー！</original>
			<edited>转个不停呢！</edited>
			<subEntries />
		</entry>
		<entry name="NuriRide_0002" offset="00" relocatable="true" max_length="0">
			<original>イカフライまで取っちゃうなんて、ヨユウですね～♪</original>
			<edited>连炸鱿鱼圈都拿到，真是游刃有余呢～♪</edited>
			<subEntries />
		</entry>
		<entry name="NuriRide_0003" offset="00" relocatable="true" max_length="0">
			<original>オ～プ～ン♪</original>
			<edited>打开～♪</edited>
			<subEntries />
		</entry>
		<entry name="NuriRide_0004" offset="00" relocatable="true" max_length="0">
			<original>回っておる… でっかいのが回っておるぞィ</original>
			<edited>在转… 有个大东西在转！</edited>
			<subEntries />
		</entry>
		<entry name="NuriRide_0005" offset="00" relocatable="true" max_length="0">
			<original>いい感じでグルグルを止めたいですね</original>
			<edited>想恰到好处地停下旋转呢</edited>
			<subEntries />
		</entry>
		<entry name="NuriRide_0006" offset="00" relocatable="true" max_length="0">
			<original>すごい… イカフライ全部ゲットですね！</original>
			<edited>厉害… 炸鱿鱼圈全拿到了！</edited>
			<subEntries />
		</entry>
		<entry name="NuriRide_0007" offset="00" relocatable="true" max_length="0">
			<original>ギャンッ！！</original>
			<edited>哇！！</edited>
			<subEntries />
		</entry>
		<entry name="NuriRide_0008" offset="00" relocatable="true" max_length="0">
			<original>ナイスすりぬけじゃッ！</original>
			<edited>穿过得漂亮！</edited>
			<subEntries />
		</entry>
		<entry name="NuriRide_0009" offset="00" relocatable="true" max_length="0">
			<original>キャッ？！</original>
			<edited>呀？！</edited>
			<subEntries />
		</entry>
		<entry name="NuriRide_0010" offset="00" relocatable="true" max_length="0">
			<original>ファッ？！</original>
			<edited>哎呀？！</edited>
			<subEntries />
		</entry>
		<entry name="NuriRide_0011" offset="00" relocatable="true" max_length="0">
			<original>よし、次だ！</original>
			<edited>好，下一个！</edited>
			<subEntries />
		</entry>
		<entry name="NuriRide_0012" offset="00" relocatable="true" max_length="0">
			<original>めっちゃグルグルしてたな！</original>
			<edited>转得真够厉害的！</edited>
			<subEntries />
		</entry>
		<entry name="NuriRide_0013" offset="00" relocatable="true" max_length="0">
			<original>もうヘロヘロです…</original>
			<edited>已经累瘫了…</edited>
			<subEntries />
		</entry>
		<entry name="NuriRide_0014" offset="00" relocatable="true" max_length="0">
			<original>進路良好！ 全速前進ーッ！</original>
			<edited>路线畅通！全速前进！</edited>
			<subEntries />
		</entry>
		<entry name="NuriRide_0015" offset="00" relocatable="true" max_length="0">
			<original>でっかいのの真ん中にも でんでんスイッチありますね</original>
			<edited>大东西的中间也有转转开关呢</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>ジェットパック専用のチャレンジとなりまス</original>
			<edited>这是喷气背包专用挑战</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>一定時間 たえ続ければクリアとなりまス</original>
			<edited>坚持一定时间即可通关</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>ジェットパックは&#xE;&#x2;&#x18;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;で 少し高く飛べまス</original>
			<edited>喷气背包，&#xE;&#x2;&#x18;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;能飞得稍高一些</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0003" offset="00" relocatable="true" max_length="0">
			<original>タコスナイパーのショットは タコストライクで防げまス</original>
			<edited>章鱼狙击兵的射击可以用章鱼保龄球兵挡住</edited>
			<subEntries />
		</entry>
		<entry name="StrikeYoke_0000" offset="00" relocatable="true" max_length="0">
			<original>ハチ、ジェットパックの操作 確認しとけよ！</original>
			<edited>小八，确认好喷气背包的操作！</edited>
			<subEntries />
		</entry>
		<entry name="StrikeYoke_0001" offset="00" relocatable="true" max_length="0">
			<original>３０秒間 よけ続ければいいみたいです！</original>
			<edited>好像躲过30秒就行！</edited>
			<subEntries />
		</entry>
		<entry name="StrikeYoke_0002" offset="00" relocatable="true" max_length="0">
			<original>ビンイクラ発見！ 確認されたしーッ！</original>
			<edited>发现瓶装鲑鱼卵！请确认！</edited>
			<subEntries />
		</entry>
		<entry name="StrikeYoke_0003" offset="00" relocatable="true" max_length="0">
			<original>ビンイクラ… と、敵発見！ 確認されたしーッ！</original>
			<edited>瓶装鲑鱼卵…还有敌人！请确认！</edited>
			<subEntries />
		</entry>
		<entry name="StrikeYoke_0004" offset="00" relocatable="true" max_length="0">
			<original>あとちょっとです！</original>
			<edited>就差一点了！</edited>
			<subEntries />
		</entry>
		<entry name="StrikeYoke_0005" offset="00" relocatable="true" max_length="0">
			<original>もうちょっとだ！ たえろーー！！</original>
			<edited>再坚持一下！顶住！！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
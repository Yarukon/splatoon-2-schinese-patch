		<entry name="Spinner_Quick_02" offset="00" relocatable="true" max_length="0">
			<original>&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;スプラスピナーベッチュー&#xE;&#x0;&#x3;&#x2;ÿÿは

<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Name_OctCollectIcon_00" offset="00" relocatable="true" max_length="0">
			<original>イカ</original>
			<edited>鱿鱼</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_00" offset="00" relocatable="true" max_length="0">
			<original>たおすべし　われらの敵と　教えられ
いまは手を取り　進む深海かな</original>
			<edited>曾被教导：那是我们该打倒的敌人
如今却手牵着手，走进深海</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_01" offset="00" relocatable="true" max_length="0">
			<original>ボーイ（ブルー）</original>
			<edited>男孩（蓝色）</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_01" offset="00" relocatable="true" max_length="0">
			<original>瑠璃色の　海を見つめる　キミの目は
スコープのぞく　時と同じで</original>
			<edited>你凝望蔚蓝大海的眼神
与端起瞄准镜时如出一辙</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_02" offset="00" relocatable="true" max_length="0">
			<original>ボーイ（グリーン）</original>
			<edited>男孩（绿色）</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_02" offset="00" relocatable="true" max_length="0">
			<original>一直線　転がる筒が　新緑の
大波小波　大地を起こす</original>
			<edited>一路直滚的滚筒，掀起新绿的
层层波浪，翻起大地</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_03" offset="00" relocatable="true" max_length="0">
			<original>ガール（オレンジ）</original>
			<edited>女孩（橙色）</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_03" offset="00" relocatable="true" max_length="0">
			<original>陽光が　降りそそぐよに　塗るキミの
背にあこがれて　シューターを持つ</original>
			<edited>你如阳光倾洒般涂地的背影
令我憧憬，也拿起了射击枪</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_04" offset="00" relocatable="true" max_length="0">
			<original>ガール（ピンク）</original>
			<edited>女孩（粉色）</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_04" offset="00" relocatable="true" max_length="0">
			<original>桃色の　閃光が脇を　すり抜けて
ボクの背中に　ほほ笑むキミよ</original>
			<edited>桃色闪光擦身而过
你对着我的背影微笑</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_05" offset="00" relocatable="true" max_length="0">
			<original>タコ</original>
			<edited>章鱼</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_05" offset="00" relocatable="true" max_length="0">
			<original>蛸壺の　外の世界を　夢見れど
彷徨ういまは　友が恋しき</original>
			<edited>虽然梦想着蛸壶之外的世界
但如今漂泊的我，好想念朋友</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_06" offset="00" relocatable="true" max_length="0">
			<original>バイタコトルーパー</original>
			<edited>强化章鱼兵</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_06" offset="00" relocatable="true" max_length="0">
			<original>双頭の　ごとくたなびく　ツインヘア
ツーステップを　刻む散弾</original>
			<edited>双马尾如双头般飘扬
散弹枪踏着两步节拍</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_07" offset="00" relocatable="true" max_length="0">
			<original>タコプター</original>
			<edited>章鱼螺旋桨兵</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_07" offset="00" relocatable="true" max_length="0">
			<original>あかねさす　真昼の丘で　ピクニック
上目遣いで　キミを見た午後</original>
			<edited>茜色映照的正午山丘上野餐
午后，我抬眼望着你</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_08" offset="00" relocatable="true" max_length="0">
			<original>ボムタコプター</original>
			<edited>炸弹章鱼螺旋桨兵</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_08" offset="00" relocatable="true" max_length="0">
			<original>「落としたら　それで終わり」の　争点は
落とした後の　アナタの誠意</original>
			<edited>“掉了就全完了”的争论焦点
其实是掉了之后你的诚意</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_09" offset="00" relocatable="true" max_length="0">
			<original>スタコラー</original>
			<edited>章鱼溜兵</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_09" offset="00" relocatable="true" max_length="0">
			<original>ツンデレな　キミはワタシの　逆をゆく
ワタシと顔を　合わせずにゆく</original>
			<edited>傲娇的你总与我背道而驰
从不看着我便走开</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_10" offset="00" relocatable="true" max_length="0">
			<original>タコポッド</original>
			<edited>章鱼弹舱兵</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_10" offset="00" relocatable="true" max_length="0">
			<original>信念を　曲げない姿勢は　いいけれど
捨て身はダメだよ　ママが泣くから</original>
			<edited>坚持信念固然很好
可别豁出命啊，妈妈会哭的</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_11" offset="00" relocatable="true" max_length="0">
			<original>タコスタンプ</original>
			<edited>章鱼印章兵</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_11" offset="00" relocatable="true" max_length="0">
			<original>暴れると　お尻ペンペン　しちゃいます
お尻ペンペン　したくなります</original>
			<edited>再胡闹就打你屁股哦
真想打你屁股</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_12" offset="00" relocatable="true" max_length="0">
			<original>タコッペリン号</original>
			<edited>章鱼柏林号</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_12" offset="00" relocatable="true" max_length="0">
			<original>天の川　ぷかぷか浮かび　パトロール
からくれなゐに　染まる宙舟</original>
			<edited>在银河中飘飘荡荡地巡逻
染成深红的宇宙飞船</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_13" offset="00" relocatable="true" max_length="0">
			<original>タコ足</original>
			<edited>章鱼脚</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_13" offset="00" relocatable="true" max_length="0">
			<original>ぬばたまの　夜にキラめく　星の痕
崩れ落ちたる　親方の影</original>
			<edited>漆黑夜里闪耀的星痕
是崩塌倒下的首领身影</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_14" offset="00" relocatable="true" max_length="0">
			<original>タコゾネス</original>
			<edited>章鱼女战士</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_14" offset="00" relocatable="true" max_length="0">
			<original>さよならも　言えずに堕ちた　深海で
我とよく似た　キミにふたたび</original>
			<edited>连再见都没说便坠入深海
在那里，再次遇见与我很像的你</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_15" offset="00" relocatable="true" max_length="0">
			<original>シャケ</original>
			<edited>鲑鱼</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_15" offset="00" relocatable="true" max_length="0">
			<original>ふり向けば　いつもそこには　キミがいて
シャケられないよ　その眼差しを </original>
			<edited>回头总能看见你
那道目光，令我避不开</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_16" offset="00" relocatable="true" max_length="0">
			<original>バクダン</original>
			<edited>炸弹鱼</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_16" offset="00" relocatable="true" max_length="0">
			<original>「キミが好き」　そんなシャケ氏に　だまされて
生み落とされたる　愛のバクダン</original>
			<edited>被鲑鱼先生一句“我喜欢你”骗了
诞生的是爱的炸弹</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_17" offset="00" relocatable="true" max_length="0">
			<original>ヘビ</original>
			<edited>蛇鱼</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_17" offset="00" relocatable="true" max_length="0">
			<original>回り道　してるかのよに　見せかけて
キミは不乱に　すすむ蛇の道</original>
			<edited>看似绕了远路
你却不慌不忙地走在蛇道上</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_18" offset="00" relocatable="true" max_length="0">
			<original>カタパッド</original>
			<edited>垫肩飞鱼</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_18" offset="00" relocatable="true" max_length="0">
			<original>夏が暮れ　帰宅途中に　キミが来て
見せてくれたね　花火ゼロ距離</original>
			<edited>夏将尽时，你来到我的归途上
让我看见近在咫尺的烟花</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_19" offset="00" relocatable="true" max_length="0">
			<original>モグラ</original>
			<edited>鼹鼠鱼</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_19" offset="00" relocatable="true" max_length="0">
			<original>地底から　見上げた空は　どんな色？
たまには大地　見下ろしたくない？</original>
			<edited>从地底仰望的天空是什么颜色？
偶尔不想俯瞰大地吗？</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_20" offset="00" relocatable="true" max_length="0">
			<original>タワー</original>
			<edited>高塔鱼</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_20" offset="00" relocatable="true" max_length="0">
			<original>コツコツと　積み上げてきた　喜びを
こわし喜び　上がる口角</original>
			<edited>一点一滴累积的欢喜
亲手毁掉的欢喜，令嘴角上扬</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_21" offset="00" relocatable="true" max_length="0">
			<original>テッパン</original>
			<edited>铁板鱼</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_21" offset="00" relocatable="true" max_length="0">
			<original>海鳴りに　胸を揺すられ　走るボク
恋のアクセル　ペダル踏むキミ</original>
			<edited>被海鸣声摇动心弦奔跑的我
踩着恋爱油门的你</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_22" offset="00" relocatable="true" max_length="0">
			<original>コウモリ</original>
			<edited>蝙蝠鱼</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_22" offset="00" relocatable="true" max_length="0">
			<original>夕立を　さけて通れぬ　道だけど
ワタシの心は　太陽がいっぱい</original>
			<edited>虽然这条路躲不开骤雨
但我的心里满是太阳</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_23" offset="00" relocatable="true" max_length="0">
			<original>キンシャケ</original>
			<edited>金鲑鱼</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_23" offset="00" relocatable="true" max_length="0">
			<original>初空を　あおぐキンシャケ　追いかけて
撃つともらえる　おとし玉かな</original>
			<edited>追着仰望新年初空的金鲑鱼
打中就能拿到压岁钱吗</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_24" offset="00" relocatable="true" max_length="0">
			<original>スタート地点</original>
			<edited>开始地点</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_24" offset="00" relocatable="true" max_length="0">
			<original>死はつまり　次の生への　第一歩
墓標に刻みし　お名前はコレ</original>
			<edited>死，不过是走向新生的第一步
墓碑上刻下的名字就是“这个”</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_25" offset="00" relocatable="true" max_length="0">
			<original>風船</original>
			<edited>气球</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_25" offset="00" relocatable="true" max_length="0">
			<original>目にすると　壊したくなる　衝動や
たたずむキミに　罪はないのに</original>
			<edited>一看见便涌起破坏冲动
明明伫立在那里，你却毫无罪过</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_26" offset="00" relocatable="true" max_length="0">
			<original>バンカー</original>
			<edited>掩体</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_26" offset="00" relocatable="true" max_length="0">
			<original>イカを待つ　我に背中を　貸すキミと
見上げた空は　いつもやさしく</original>
			<edited>等鱿鱼时借我后背的你
与你仰望的天空总是温柔</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_27" offset="00" relocatable="true" max_length="0">
			<original>イカバンカー</original>
			<edited>鱿鱼掩体</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_27" offset="00" relocatable="true" max_length="0">
			<original>そこにいる　イカのジジィよ　聞いてくれ
ワタシも撃ちたい　きゃつらイカじゃし</original>
			<edited>那边的鱿鱼老头，听我说
我也想打他们，谁让他们是鱿鱼呢</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_28" offset="00" relocatable="true" max_length="0">
			<original>ガチホコ</original>
			<edited>真格鱼虎</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_28" offset="00" relocatable="true" max_length="0">
			<original>さよならの　タイムリミット　噛み締めて
キミを抱えて　立たされた岐路</original>
			<edited>咀嚼着离别的时限
抱着你，被迫站在岔路口</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_29" offset="00" relocatable="true" max_length="0">
			<original>ガチアサリ</original>
			<edited>真格蛤蜊</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_29" offset="00" relocatable="true" max_length="0">
			<original>なぜと問う　ことは１度も　許されぬ
１０を拾うと　１になるなぜ…</original>
			<edited>问“为什么”从来不被允许
捡十个却只算一个，为什么……</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_30" offset="00" relocatable="true" max_length="0">
			<original>ガチヤグラ</original>
			<edited>真格塔楼</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_30" offset="00" relocatable="true" max_length="0">
			<original>離れゆく　キミの背中を　見て落つる
コントロールの　利かぬ涙は</original>
			<edited>望着渐渐远去的你的背影
无法控制的泪水落下</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_31" offset="00" relocatable="true" max_length="0">
			<original>木</original>
			<edited>四</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_31" offset="00" relocatable="true" max_length="0">
			<original>いる意味は　森羅万象　ありまして
植えただれかの　愛が宿らむ</original>
			<edited>存在的意义，森罗万象
栽下的，或是某人的爱</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_32" offset="00" relocatable="true" max_length="0">
			<original>スプラシューター</original>
			<edited>斯普拉射击枪</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_32" offset="00" relocatable="true" max_length="0">
			<original>銃身を　なぜる陽射しの　やさしさに
とどろく砲声　それが戦場</original>
			<edited>抚过枪身的阳光如此温柔
轰鸣的炮声，那里就是战场</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_33" offset="00" relocatable="true" max_length="0">
			<original>スプラローラー</original>
			<edited>斯普拉滚筒</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_33" offset="00" relocatable="true" max_length="0">
			<original>フラれれば　フラれるほどに　薄れゆく
色の行方は　我の采配</original>
			<edited>被甩得越多，颜色越淡
颜色的去向由我掌控</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_34" offset="00" relocatable="true" max_length="0">
			<original>スプラッシュボム</original>
			<edited>斯普拉炸弹</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_34" offset="00" relocatable="true" max_length="0">
			<original>投げて知る　あかぬ別れの　わびしさを
濡るる枕の　色はキミ色</original>
			<edited>投出后才懂未尽离别的寂寞
浸湿枕头的，是你的颜色</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_35" offset="00" relocatable="true" max_length="0">
			<original>キューバンボム</original>
			<edited>吸盘炸弹</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_35" offset="00" relocatable="true" max_length="0">
			<original>天も地も　キミにかかれば　みな足場
瞬く間ほどの　天下泰平</original>
			<edited>对你来说，天地皆是落脚处
转眼便天下太平</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_36" offset="00" relocatable="true" max_length="0">
			<original>クイックボム</original>
			<edited>快速炸弹</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_36" offset="00" relocatable="true" max_length="0">
			<original>ほとばしる　飛沫のなかに　宿る我
ブランク・ウォールに　垂れ下がる夜</original>
			<edited>我栖身于飞溅的墨滴中
夜晚垂落在空白墙上</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_37" offset="00" relocatable="true" max_length="0">
			<original>ロボットボム</original>
			<edited>机器人炸弹</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_37" offset="00" relocatable="true" max_length="0">
			<original>破滅への　カウントダウンの　足音に
耳をすませて　我ら爆発</original>
			<edited>侧耳倾听通往毁灭的倒数脚步
我们，爆炸</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_38" offset="00" relocatable="true" max_length="0">
			<original>カーリングボム</original>
			<edited>冰壶炸弹</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_38" offset="00" relocatable="true" max_length="0">
			<original>実直を　つらぬくキミの　道しるべ
「迷いはないの？」　聞くと　「そだねー」</original>
			<edited>你是坚守正直的路标
问她“不会迷茫吗？”——“对呀～”</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_39" offset="00" relocatable="true" max_length="0">
			<original>ポイズンミスト</original>
			<edited>毒雾</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_39" offset="00" relocatable="true" max_length="0">
			<original>風吹けば　逆巻く悪の　華が咲き
香にさそわれし　我は歩まん</original>
			<edited>风起时，逆卷的恶之花绽放
我受香气引诱，迈步前行</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_40" offset="00" relocatable="true" max_length="0">
			<original>ビゼン</original>
			<edited>备前</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_40" offset="00" relocatable="true" max_length="0">
			<original>柔肌の　青きからだに　長きウデ
かならず行くや　上へ出た日に</original>
			<edited>青色柔嫩的身躯，修长的触手
终有一天，会到地面上去吧</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_41" offset="00" relocatable="true" max_length="0">
			<original>シガニー</original>
			<edited>希加尼</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_41" offset="00" relocatable="true" max_length="0">
			<original>黒硝子　瞳の奥は　何を見る？
レグルス？　プレセペ？　ポルックス？</original>
			<edited>黑玻璃般的眼眸深处，在看什么？
轩辕十四？鬼星团？北河三？</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_42" offset="00" relocatable="true" max_length="0">
			<original>ミウラ</original>
			<edited>三浦</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_42" offset="00" relocatable="true" max_length="0">
			<original>ケラケラと　笑うアナタと　浮かぶキミ
願いはいつか　輪にまざり笑む</original>
			<edited>咯咯笑的你，与漂浮的你
心愿终会融入人群，一同欢笑</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_43" offset="00" relocatable="true" max_length="0">
			<original>ジャッジくん ＆ コジャッジくん</original>
			<edited>裁判猫 ＆ 小裁判猫</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_43" offset="00" relocatable="true" max_length="0">
			<original>ナワバリの　すべてを理する　ふわふわと
日なたでまどろむ　夢をみた朝</original>
			<edited>掌管占地对战一切的毛茸茸
阳光下打盹的清晨，做了个梦</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_44" offset="00" relocatable="true" max_length="0">
			<original>ブキチ</original>
			<edited>武器子</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_44" offset="00" relocatable="true" max_length="0">
			<original>あこがれの　有名すぎる　ブキ屋さん
永久に聴きたい　ブキ談義かな</original>
			<edited>憧憬的、太过有名的武器店
真想永远听他聊武器</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_45" offset="00" relocatable="true" max_length="0">
			<original>ロブ</original>
			<edited>阿龙</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_45" offset="00" relocatable="true" max_length="0">
			<original>揚げてっても　揚げてっても　長い列
いつか行きたい　ロブズ・１０・プラー</original>
			<edited>嗨个不停，队伍却还那么长
总有一天想去“阿龙·10·普拉”</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_46" offset="00" relocatable="true" max_length="0">
			<original>イイダ</original>
			<edited>饭田</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_46" offset="00" relocatable="true" max_length="0">
			<original>本当だよ　声だけですぐ　気付いたよ
アナタは無事に　着いてたんだね</original>
			<edited>真的，只听声音就立刻认出了你
原来你已平安抵达</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_47" offset="00" relocatable="true" max_length="0">
			<original>ヒメ</original>
			<edited>小姬</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_47" offset="00" relocatable="true" max_length="0">
			<original>「キラキラで　カッコよくって　やさしくて
ぜんぶステキ」と　黒髪のキミ</original>
			<edited>黑发的你说：“闪闪发光，又帅气又温柔，
全都特别棒。”</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_48" offset="00" relocatable="true" max_length="0">
			<original>スパイキー</original>
			<edited>刺冠</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_48" offset="00" relocatable="true" max_length="0">
			<original>生意気な　口調の裏に　見え隠れ
ギアへの愛は　ウニっ子１番！</original>
			<edited>盛气凌人的语气背后若隐若现的
是对装备的爱：海胆小子第一！</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_49" offset="00" relocatable="true" max_length="0">
			<original>クマサン</original>
			<edited>熊先生</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_49" offset="00" relocatable="true" max_length="0">
			<original>働きたい　ああ働きたい　いつまでも
お願いします　何でもします</original>
			<edited>好想工作啊，啊，好想一直工作
拜托了，什么都愿意做</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_50" offset="00" relocatable="true" max_length="0">
			<original>アロメ</original>
			<edited>艾洛眼</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_50" offset="00" relocatable="true" max_length="0">
			<original>街並みに　溶けるランナー　光る汗
ネオンカラーは　風になびいて</original>
			<edited>融入街景的跑者，汗水闪光
霓虹色衣衫随风飘扬</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_51" offset="00" relocatable="true" max_length="0">
			<original>バトロイカ</original>
			<edited>战斗鱿鱼</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_51" offset="00" relocatable="true" max_length="0">
			<original>イカたちが　バトルでよく着る　バトロイカ
「買ったことある？」　「買ったことない」</original>
			<edited>鱿鱼们在战斗时常穿的战斗鱿鱼
“买过吗？”“没买过”</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_52" offset="00" relocatable="true" max_length="0">
			<original>エゾッコ</original>
			<edited>泽酷</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_52" offset="00" relocatable="true" max_length="0">
			<original>オンショアに　吹かれてスカす　丘サーファー
海はやだけど　海風はすき</original>
			<edited>迎着向岸风耍酷的丘陵冲浪手
虽讨厌海，却喜欢海风</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_53" offset="00" relocatable="true" max_length="0">
			<original>タタキケンサキ</original>
			<edited>剑尖鱿</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_53" offset="00" relocatable="true" max_length="0">
			<original>モノトーン　カラーで構成　されし世に
色をつけるは　我のまにまに</original>
			<edited>在由单色构成的世界里
添上颜色，全随我心意</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_54" offset="00" relocatable="true" max_length="0">
			<original>ホッコリー</original>
			<edited>暖流</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_54" offset="00" relocatable="true" max_length="0">
			<original>ヤキフグくん　キミはジギーな　顔だけど
ＨＩＰ－ＨＯＰの　申し子なのかい？</original>
			<edited>烧河豚君，虽长着一张嘻哈脸
难道是嘻哈的天选之子吗？</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_55" offset="00" relocatable="true" max_length="0">
			<original>シグレニ</original>
			<edited>时雨</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_55" offset="00" relocatable="true" max_length="0">
			<original>インドアな　キミを誘って　キャンプ場
ワタシの心は　アウトドアなり</original>
			<edited>邀请宅家的你去露营场
我的心却向往户外</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_56" offset="00" relocatable="true" max_length="0">
			<original>アイロニック</original>
			<edited>钢铁先锋</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_56" offset="00" relocatable="true" max_length="0">
			<original>にわか雨　傘なく濡れる　キミを見て
アイロニックな　笑みがこぼれて</original>
			<edited>看着没带伞、被阵雨淋湿的你
不禁露出一抹讽刺的笑</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_57" offset="00" relocatable="true" max_length="0">
			<original>ホタックス</original>
			<edited>帆立</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_57" offset="00" relocatable="true" max_length="0">
			<original>「オシャレはね　頭の先から　始まるの」
キャップ逆さに　イカは微笑み</original>
			<edited>“时尚啊，要从头顶开始哦”
反戴棒球帽的鱿鱼微笑着说</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_58" offset="00" relocatable="true" max_length="0">
			<original>イカテンキュウビン</original>
			<edited>鱿鱼急件</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_58" offset="00" relocatable="true" max_length="0">
			<original>この想い　キミに届けと　箱詰めて
いつもよりキレイに　ガムテープ貼る</original>
			<edited>将这份心意寄给你，装进箱里
比平时贴得更整齐的胶带</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_59" offset="00" relocatable="true" max_length="0">
			<original>安全第一くん</original>
			<edited>安全第一君</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_59" offset="00" relocatable="true" max_length="0">
			<original>「この先は　危ないからね　気を付けて？」
ちがう、ちがうよ　通っちゃダメよ</original>
			<edited>“前面很危险，要小心哦？”
不对不对，根本不能过去！</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_60" offset="00" relocatable="true" max_length="0">
			<original>カンストくん</original>
			<edited>满级君</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_60" offset="00" relocatable="true" max_length="0">
			<original>いつの日か　言いたかった　この言葉
「エ、ジブンすか？　S＋カンストっす」</original>
			<edited>总有一天想说出口的话
“诶，问我吗？S+满级啦。”</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_61" offset="00" relocatable="true" max_length="0">
			<original>わかばマーク</original>
			<edited>嫩叶标志</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_61" offset="00" relocatable="true" max_length="0">
			<original>若葉をね　なめてかかると　いけないよ
記憶に残る　子守唄かな</original>
			<edited>可别小看嫩叶哦
那可是一首令人难忘的摇篮曲</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_62" offset="00" relocatable="true" max_length="0">
			<original>あのグラフィティ</original>
			<edited>那幅涂鸦</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_62" offset="00" relocatable="true" max_length="0">
			<original>なんだっけ　見かけるたびに　気になるの
「あのグラフィティ」の　正しい名前</original>
			<edited>叫什么来着？每次看到都在想
“那幅涂鸦”的正式名字</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_63" offset="00" relocatable="true" max_length="0">
			<original>アオリ</original>
			<edited>小拟</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_63" offset="00" relocatable="true" max_length="0">
			<original>あの谷で　聴いた唄から　目覚めたの
トキメキくれた　アナタはいずこ</original>
			<edited>那座山谷听过的歌将我唤醒
让我心动的你，如今在何方</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_64" offset="00" relocatable="true" max_length="0">
			<original>ホタル</original>
			<edited>小萤</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_64" offset="00" relocatable="true" max_length="0">
			<original>スミかかる　夜のしじまに　想いはす
アナタといつか　アエる日のこと</original>
			<edited>墨色笼罩的寂静夜里，思念着
总有一天能与你相会的日子</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_65" offset="00" relocatable="true" max_length="0">
			<original>デンチナマズ</original>
			<edited>电池鲶鱼</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_65" offset="00" relocatable="true" max_length="0">
			<original>囚われて　空を見つめる　その眼
震わすヒゲが　気持ちを揺らす</original>
			<edited>被囚禁、仰望天空的那双眼
颤动的胡须拨动心弦</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_66" offset="00" relocatable="true" max_length="0">
			<original>マメデンチナマズ</original>
			<edited>小电池鲶鱼</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_66" offset="00" relocatable="true" max_length="0">
			<original>ピリピリと　刻むリズムに　のせられて
ふと口ずさむ　シオカラ節よ</original>
			<edited>被细碎节奏带着
不经意哼起塩辛节</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_67" offset="00" relocatable="true" max_length="0">
			<original>イクラ</original>
			<edited>鲑鱼卵</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_67" offset="00" relocatable="true" max_length="0">
			<original>「冷えるでしょ？」　キミが渡した　手袋で
ひときわ感ず　イクラの冷たさ</original>
			<edited>戴上你递来、说“会冷吧？”的手套
更觉鲑鱼卵冰凉</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_68" offset="00" relocatable="true" max_length="0">
			<original>カギ</original>
			<edited>钥匙</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_68" offset="00" relocatable="true" max_length="0">
			<original>鐘が鳴る　カニのカギ束　握りしめ
谷をてくてく　夏空の下　</original>
			<edited>钟声响起，攥紧螃蟹钥匙串
夏空下在山谷里漫步</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_69" offset="00" relocatable="true" max_length="0">
			<original>イリコニウム</original>
			<edited>小鱼干</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_69" offset="00" relocatable="true" max_length="0">
			<original>赤々と　白銀の身に　夕日落つ
ふと鳴り出すは　我の腹なり</original>
			<edited>夕阳火红地落在白银般的身躯上
突然响起来的是我的肚子</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_70" offset="00" relocatable="true" max_length="0">
			<original>ミステリーファイル</original>
			<edited>神秘档案</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_70" offset="00" relocatable="true" max_length="0">
			<original>クルクルと　ナゾの巻き物　開けるけど
読みづらいよね　クルクルするし</original>
			<edited>打开卷成圈的神秘卷轴
可太难读，它总在转圈</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_71" offset="00" relocatable="true" max_length="0">
			<original>ＤＪタコワサ将軍</original>
			<edited>DJ芥末章鱼将军</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_71" offset="00" relocatable="true" max_length="0">
			<original>さよならは　告げずに行くの　ひっそりと
だってゼッタイ　怒られるもの</original>
			<edited>不告别，悄悄离去
因为肯定会被骂</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_72" offset="00" relocatable="true" max_length="0">
			<original>デカロニックミント</original>
			<edited>贝壳鞋 薄荷</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_72" offset="00" relocatable="true" max_length="0">
			<original>あこがれの　あのコはいてる　スニーカー
いつかおそろで　ナワバリバトル</original>
			<edited>憧憬的那个孩子穿的运动鞋
总有一天也穿同款打占地对战</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_73" offset="00" relocatable="true" max_length="0">
			<original>ホタパーカー</original>
			<edited>帆立连帽衫</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_73" offset="00" relocatable="true" max_length="0">
			<original>寒空に　思い浮かぶは　あの衣
着たいと願う　我はヘソ出し</original>
			<edited>寒冷天空中浮现那件衣衫
想穿上它的我，露着肚脐</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_74" offset="00" relocatable="true" max_length="0">
			<original>キングタンク</original>
			<edited>王者坦克背心</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_74" offset="00" relocatable="true" max_length="0">
			<original>歴戦を　戦いぬいた　ものが知る
胸に宿すは　王者の誇り</original>
			<edited>唯有历经百战者才懂
胸中怀的是王者的骄傲</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_75" offset="00" relocatable="true" max_length="0">
			<original>オレンジアローズ</original>
			<edited>箭标鞋 橘色</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_75" offset="00" relocatable="true" max_length="0">
			<original>鮮やかな　色の交差に　どきっとする
オレンジアローズ　お天気ウォーク</original>
			<edited>鲜艳色彩交错，令人怦然心动
穿箭标鞋橘色款，在晴天漫步</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_76" offset="00" relocatable="true" max_length="0">
			<original>リブニット</original>
			<edited>针织帽</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_76" offset="00" relocatable="true" max_length="0">
			<original>「ニットはね　リブの長さが　決め手なの」
いたずらに笑む　ウミウシのキミ</original>
			<edited>“针织衫嘛，罗纹长度才是关键哦”
如恶作剧般笑着的海蛞蝓</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_77" offset="00" relocatable="true" max_length="0">
			<original>イカホワイト</original>
			<edited>鱿鱼T恤 白色</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_77" offset="00" relocatable="true" max_length="0">
			<original>いいのかな　イカじゃないけど　着てみたい
いいじゃなイカ　タコだもの</original>
			<edited>虽不是鱿鱼，也想穿穿看
这不挺好吗，毕竟是章鱼嘛</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_78" offset="00" relocatable="true" max_length="0">
			<original>ウミウシイエロー</original>
			<edited>海蛞蝓鞋 黄色</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_78" offset="00" relocatable="true" max_length="0">
			<original>てくてくと　夜道に光る　音追えば
姿見えぬも　胸は高鳴り</original>
			<edited>循着夜路上闪闪发亮的声音走去
虽不见身影，心仍怦怦直跳</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_79" offset="00" relocatable="true" max_length="0">
			<original>ヤコメッシュ</original>
			<edited>暇古网帽</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_79" offset="00" relocatable="true" max_length="0">
			<original>ささやかに　風のそよ吹く　後頭部
メッシュ加工の　避暑地は住みよく</original>
			<edited>微风轻拂后脑勺
网眼加工的避暑胜地，住着真舒服</edited>
			<subEntries />
		</entry>
		<entry name="Name_OctCollectIcon_80" offset="00" relocatable="true" max_length="0">
			<original>なんかのメモリー</original>
			<edited>一段记忆</edited>
			<subEntries />
		</entry>
		<entry name="Text_OctCollectIcon_80" offset="00" relocatable="true" max_length="0">
			<original>あんまり　思い出せない……</original>
			<edited>怎么也想不起来……</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>ガチホコを、相手のゴールにタッチダウンしてくださイ</original>
			<edited>请将真格鱼虎带到对手终点得分</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>ホコを持って&#xE;&#x2;&#x1E;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;長押しで、強力なショットが撃てまス</original>
			<edited>手持鱼虎时，按住&#xE;&#x2;&#x1E;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;即可发射强力射击</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>ホコを持っていると、ボムは使えないので注意でス</original>
			<edited>手持鱼虎时无法使用炸弹，请注意</edited>
			<subEntries />
		</entry>
		<entry name="Amida01Hoko_0000" offset="00" relocatable="true" max_length="0">
			<original>ガチホコで バトルするみたいですね</original>
			<edited>看来要用真格鱼虎对战。</edited>
			<subEntries />
		</entry>
		<entry name="Amida01Hoko_0001" offset="00" relocatable="true" max_length="0">
			<original>まずは ホコをゲットだ！</original>
			<edited>先拿到鱼虎！</edited>
			<subEntries />
		</entry>
		<entry name="Amida01Hoko_0023" offset="00" relocatable="true" max_length="0">
			<original>ホコのバリアをインクショットで割り、ホコにさわってください</original>
			<edited>用墨汁射击打破鱼虎护罩，再触碰鱼虎。</edited>
			<subEntries />
		</entry>
		<entry name="Amida01Hoko_0002" offset="00" relocatable="true" max_length="0">
			<original>時間内ならやり直せます！ ホコを取りもどしましょう！</original>
			<edited>还有时间就能重来！把鱼虎夺回来吧！</edited>
			<subEntries />
		</entry>
		<entry name="Amida01Hoko_0003" offset="00" relocatable="true" max_length="0">
			<original>ぬゥ… 始めからやり直しじゃ！</original>
			<edited>唔… 从头再来！</edited>
			<subEntries />
		</entry>
		<entry name="Amida01Hoko_0004" offset="00" relocatable="true" max_length="0">
			<original>ヤベェ！ 残り1分を切ったゾ！</original>
			<edited>糟了！只剩不到一分钟了！</edited>
			<subEntries />
		</entry>
		<entry name="Amida01Hoko_0005" offset="00" relocatable="true" max_length="0">
			<original>もうダメだーっ！！</original>
			<edited>不行了！！</edited>
			<subEntries />
		</entry>
		<entry name="Amida01Hoko_0006" offset="00" relocatable="true" max_length="0">
			<original>ッシャー！ 相手のゴールまで運べー！</original>
			<edited>好嘞！运到对手终点去！</edited>
			<subEntries />
		</entry>
		<entry name="Amida01Hoko_0007" offset="00" relocatable="true" max_length="0">
			<original>おいでなすったぞィ！</original>
			<edited>送上门来了！</edited>
			<subEntries />
		</entry>
		<entry name="Amida01Hoko_0008" offset="00" relocatable="true" max_length="0">
			<original>フルチャージで 爆発に巻きこめー！</original>
			<edited>用满蓄力把它卷进爆炸里！</edited>
			<subEntries />
		</entry>
		<entry name="Amida01Hoko_0009" offset="00" relocatable="true" max_length="0">
			<original>おい、何してんだ！ ホコを運べって！</original>
			<edited>喂，干什么呢！快运鱼虎！</edited>
			<subEntries />
		</entry>
		<entry name="Amida01Hoko_0010" offset="00" relocatable="true" max_length="0">
			<original>ホコは 矢印の示す方向にあるはずです！</original>
			<edited>鱼虎应该在箭头所指的方向！</edited>
			<subEntries />
		</entry>
		<entry name="Amida01Hoko_0011" offset="00" relocatable="true" max_length="0">
			<original>ゴールまで あと半分じゃ！</original>
			<edited>到终点还剩一半路程！</edited>
			<subEntries />
		</entry>
		<entry name="Amida01Hoko_0012" offset="00" relocatable="true" max_length="0">
			<original>コンテナの上のルート、行けるゾ！</original>
			<edited>集装箱上面的路线能走！</edited>
			<subEntries />
		</entry>
		<entry name="Amida01Hoko_0013" offset="00" relocatable="true" max_length="0">
			<original>８号さん、ホコを取りにもどりましょう！</original>
			<edited>8号，回去拿鱼虎吧！</edited>
			<subEntries />
		</entry>
		<entry name="Amida01Hoko_0014" offset="00" relocatable="true" max_length="0">
			<original>先に タコどもをとっちめても いいゾ！</original>
			<edited>先把章鱼们收拾掉也行！</edited>
			<subEntries />
		</entry>
		<entry name="Amida01Hoko_0015" offset="00" relocatable="true" max_length="0">
			<original>ゴールは近いです あわてず落ち着いて！</original>
			<edited>终点很近了，别慌，稳住！</edited>
			<subEntries />
		</entry>
		<entry name="Amida01Hoko_0016" offset="00" relocatable="true" max_length="0">
			<original>っしゃ 行っけー！</original>
			<edited>好嘞，冲！</edited>
			<subEntries />
		</entry>
		<entry name="Amida01Hoko_0017" offset="00" relocatable="true" max_length="0">
			<original>今度こそ 行っけー！</original>
			<edited>这次一定要冲过去！</edited>
			<subEntries />
		</entry>
		<entry name="Amida01Hoko_0018" offset="00" relocatable="true" max_length="0">
			<original>バリアが割れたゾ！ 急いでホコを取り返せ！</original>
			<edited>护罩破了！快去把鱼虎抢回来！</edited>
			<subEntries />
		</entry>
		<entry name="Amida01Hoko_0019" offset="00" relocatable="true" max_length="0">
			<original>バリアが割れたら、ホコを放っとくなよ！</original>
			<edited>护罩破了，别放着鱼虎不管！</edited>
			<subEntries />
		</entry>
		<entry name="Amida01Hoko_0020" offset="00" relocatable="true" max_length="0">
			<original>取らないと、最初の位置にもどっちゃうんですよね…</original>
			<edited>不拿的话，鱼虎就会回到原位……</edited>
			<subEntries />
		</entry>
		<entry name="Amida01Hoko_0021" offset="00" relocatable="true" max_length="0">
			<original>おい、またホコがもどっちまったゾ！</original>
			<edited>喂，鱼虎又回去了！</edited>
			<subEntries />
		</entry>
		<entry name="Amida01Hoko_0022" offset="00" relocatable="true" max_length="0">
			<original>ゲ… なんか待ち構えてんなー</original>
			<edited>呃……好像有家伙在等着呢。</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
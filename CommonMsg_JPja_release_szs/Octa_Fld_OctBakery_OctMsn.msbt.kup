<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>戦略兵器タコツボベーカリーが 改造されていまス</original>
			<edited>战略兵器蛸壶面包房被改造过了。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>ブキの射程をイカして 下からも攻撃可能でス</original>
			<edited>发挥武器射程，从下方也能攻击。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>地上戦では、退路を意識しましょウ</original>
			<edited>地面战要留意退路。</edited>
			<subEntries />
		</entry>
		<entry name="Bakery_0000" offset="00" relocatable="true" max_length="0">
			<original>パンは足場に使えそうです！</original>
			<edited>面包好像能当落脚点！</edited>
			<subEntries />
		</entry>
		<entry name="Bakery_0001" offset="00" relocatable="true" max_length="0">
			<original>パン登って 上のタコ足倒すゾ！</original>
			<edited>爬上面包，干掉上面的章鱼脚！</edited>
			<subEntries />
		</entry>
		<entry name="Bakery_0002" offset="00" relocatable="true" max_length="0">
			<original>へヴィな朝メシだな…</original>
			<edited>这早餐够有分量的……</edited>
			<subEntries />
		</entry>
		<entry name="Bakery_0003" offset="00" relocatable="true" max_length="0">
			<original>わー！ ジャム塗り機が出てきたー！</original>
			<edited>哇！涂果酱机出来了！</edited>
			<subEntries />
		</entry>
		<entry name="Bakery_0004" offset="00" relocatable="true" max_length="0">
			<original>うしっ！ まだまだ食べれるぞ！</original>
			<edited>好嘞！还能再吃！</edited>
			<subEntries />
		</entry>
		<entry name="Bakery_0005" offset="00" relocatable="true" max_length="0">
			<original>ワシは ゴハン派じゃな！</original>
			<edited>老夫是米饭派！</edited>
			<subEntries />
		</entry>
		<entry name="Bakery_0006" offset="00" relocatable="true" max_length="0">
			<original>ゴチソウサマー！</original>
			<edited>多谢款待！</edited>
			<subEntries />
		</entry>
		<entry name="Bakery_0007" offset="00" relocatable="true" max_length="0">
			<original>たっぷりキウイジャム！</original>
			<edited>满满的猕猴桃果酱！</edited>
			<subEntries />
		</entry>
		<entry name="Bakery_0008" offset="00" relocatable="true" max_length="0">
			<original>ジャマなシールドは 気合で壊すんじゃ！</original>
			<edited>碍事的护盾，靠气势砸掉！</edited>
			<subEntries />
		</entry>
		<entry name="Bakery_0009" offset="00" relocatable="true" max_length="0">
			<original>カベのタイルは塗って登れそうだな</original>
			<edited>墙上的瓷砖，涂上墨好像能爬。</edited>
			<subEntries />
		</entry>
		<entry name="Bakery_0010" offset="00" relocatable="true" max_length="0">
			<original>このパンは 固くて食べられなさそうです…</original>
			<edited>这个面包太硬，好像没法吃……</edited>
			<subEntries />
		</entry>
		<entry name="Bakery_0011" offset="00" relocatable="true" max_length="0">
			<original>あのオーブン、ウチのと同じタイプのヤツだ！</original>
			<edited>那个烤箱，跟我们家同款！</edited>
			<subEntries />
		</entry>
		<entry name="Bakery_0012" offset="00" relocatable="true" max_length="0">
			<original>早く壊さないと 地面がドロドロになっちゃいます…</original>
			<edited>不快点打掉，地面会变得黏糊糊的……</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
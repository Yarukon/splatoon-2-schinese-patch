<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>でんでんスイッチを撃てば、何かが起こりまス</original>
			<edited>打转转开关，会发生什么呢？</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>でんでんスイッチを よく探すのでス</original>
			<edited>好好找找转转开关。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>足をふみ外さないようにしましょウ</original>
			<edited>小心别踩空</edited>
			<subEntries />
		</entry>
		<entry name="Denden_0000" offset="00" relocatable="true" max_length="0">
			<original>ハチ、行けー！</original>
			<edited>小八，冲！</edited>
			<subEntries />
		</entry>
		<entry name="Denden_0001" offset="00" relocatable="true" max_length="0">
			<original>あめぃじん！</original>
			<edited>了不起！</edited>
			<subEntries />
		</entry>
		<entry name="Denden_0002" offset="00" relocatable="true" max_length="0">
			<original>うぉ！ びびった！</original>
			<edited>哇！吓我一跳！</edited>
			<subEntries />
		</entry>
		<entry name="Denden_0003" offset="00" relocatable="true" max_length="0">
			<original>ワシも、それを使うと思っとったぞィ！</original>
			<edited>老夫就知道你会用那个！</edited>
			<subEntries />
		</entry>
		<entry name="Denden_0004" offset="00" relocatable="true" max_length="0">
			<original>ここは撃ちながら、キヨブタじゃ！</original>
			<edited>这里边打边小心！</edited>
			<subEntries />
		</entry>
		<entry name="Denden_0005" offset="00" relocatable="true" max_length="0">
			<original>グッドじゃッ！</original>
			<edited>很好！</edited>
			<subEntries />
		</entry>
		<entry name="Denden_0006" offset="00" relocatable="true" max_length="0">
			<original>ホントかー…？</original>
			<edited>真的吗…？</edited>
			<subEntries />
		</entry>
		<entry name="Denden_0007" offset="00" relocatable="true" max_length="0">
			<original>思い切って飛びこめ、ってことですね？</original>
			<edited>就是让我大胆冲进去，对吧？</edited>
			<subEntries />
		</entry>
		<entry name="Denden_0008" offset="00" relocatable="true" max_length="0">
			<original>ジジィ、ちょいちょい からんでくるなー…</original>
			<edited>老头子，别老缠着我……</edited>
			<subEntries />
		</entry>
		<entry name="Denden_0009" offset="00" relocatable="true" max_length="0">
			<original>ふぁびゅらすじゃ！</original>
			<edited>太棒了！</edited>
			<subEntries />
		</entry>
		<entry name="Denden_0010" offset="00" relocatable="true" max_length="0">
			<original>ホメる時のアタリメさん、イキイキしていますね…</original>
			<edited>鱼干司令一夸人，就神采奕奕呢……</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>時間内に 全ての箱マトを壊してくださイ</original>
			<edited>请在时间内打坏所有箱靶</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>「振り」と「塗り進み」の使い分けが重要でス</original>
			<edited>区分使用“挥打”和“边涂边前进”很重要</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>インクを回復するタイミングを 見極めてくださイ</original>
			<edited>看清回复墨汁的时机</edited>
			<subEntries />
		</entry>
		<entry name="BrushRush_0001" offset="00" relocatable="true" max_length="0">
			<original>カウントダウンが 始まったぞィ！</original>
			<edited>倒计时开始了！</edited>
			<subEntries />
		</entry>
		<entry name="BrushRush_0002" offset="00" relocatable="true" max_length="0">
			<original>&#xE;&#x2;&#x1E;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;長押しの塗り進みでも マトを破壊できますよ</original>
			<edited>&#xE;&#x2;&#x1E;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;长按边涂边前进也能破坏靶子</edited>
			<subEntries />
		</entry>
		<entry name="BrushRush_0003" offset="00" relocatable="true" max_length="0">
			<original>ライドレールにセンプクで インク回復できそうです</original>
			<edited>在墨汁轨道上潜行，好像能回复墨汁</edited>
			<subEntries />
		</entry>
		<entry name="BrushRush_0004" offset="00" relocatable="true" max_length="0">
			<original>カーリングボムで道を作れるゾ！ 風になれ！ 風を感じろ！</original>
			<edited>用冰壶炸弹开路！化作风吧！感受风！</edited>
			<subEntries />
		</entry>
		<entry name="BrushRush_0005" offset="00" relocatable="true" max_length="0">
			<original>ジャンプマットに乗って&#xE;&#x2;&#x18;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;長押しで 高くとべます♪</original>
			<edited>站上弹跳垫，&#xE;&#x2;&#x18;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;长按能跳得更高♪</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
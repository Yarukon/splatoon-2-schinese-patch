<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="LastBoss01_0000" offset="00" relocatable="true" max_length="0">
			<original>どうやらこのエリアに ブキがありそうです！</original>
			<edited>这个区域好像有武器！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss01_0001" offset="00" relocatable="true" max_length="0">
			<original>シャー！ ハチ、塗りたくれー！</original>
			<edited>哇！小八，涂个痛快！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss01_0002" offset="00" relocatable="true" max_length="0">
			<original>あ、タコパトローラーです！ プレスに注意しましょう！</original>
			<edited>啊，是章鱼巡逻兵！小心压扁！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss01_0003" offset="00" relocatable="true" max_length="0">
			<original>ドアだ！ カギ、持ってる？</original>
			<edited>是门！有钥匙吗？</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss01_0004" offset="00" relocatable="true" max_length="0">
			<original>自分のインクなら、スイッチONできるな！</original>
			<edited>自己的墨汁就能打开开关！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss01_0005" offset="00" relocatable="true" max_length="0">
			<original>ハチ、カギだ！ ドア、開けに行くゾ！</original>
			<edited>小八，是钥匙！去开门！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss01_0006" offset="00" relocatable="true" max_length="0">
			<original>うー！ パトパトローラー、ウゼェ！</original>
			<edited>唔！巡逻巡逻兵，好烦！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss01_0007" offset="00" relocatable="true" max_length="0">
			<original>『タコ』パトですね… 木箱を壊してもらいましょ～</original>
			<edited>是“章鱼”巡逻啦… 让他打坏木箱吧～</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss01_0008" offset="00" relocatable="true" max_length="0">
			<original>ッシャー！ これで先に進めそうだな！</original>
			<edited>好嘞！这样就能往前走了！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss01_0009" offset="00" relocatable="true" max_length="0">
			<original>インクレールにさそわれるまま 進みましょ～</original>
			<edited>顺着墨汁轨道前进吧～</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss01_0011" offset="00" relocatable="true" max_length="0">
			<original>ジャンプ後も、センプクを おわすれなく！</original>
			<edited>跳跃后也别忘记鱿鱼潜行！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss01_0013" offset="00" relocatable="true" max_length="0">
			<original>ガ… ガガ…</original>
			<edited>嘎… 嘎嘎…</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss01_0014" offset="00" relocatable="true" max_length="0">
			<original>ゲッ！ 行き止まり？！ なんとかなんねーか？</original>
			<edited>呃！死路？！能想想办法吗？</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss01_0015" offset="00" relocatable="true" max_length="0">
			<original>やった…！ 進みましょう！</original>
			<edited>太好了…！前进吧！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss01_0016" offset="00" relocatable="true" max_length="0">
			<original>お！ カンヅメ！</original>
			<edited>哦！罐头！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss01_0017" offset="00" relocatable="true" max_length="0">
			<original>ナイスです！ 行けるところから行きましょ～</original>
			<edited>漂亮！能走的地方先走着吧～</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss01_0018" offset="00" relocatable="true" max_length="0">
			<original>デンワ？ …空耳かのゥ</original>
			<edited>电话？…是听错了吧</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss01_0019" offset="00" relocatable="true" max_length="0">
			<original>あの敵、なかなかイカしてんな！ なんて名前？</original>
			<edited>那个敌人，挺帅气的嘛！叫啥名字？</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss01_0020" offset="00" relocatable="true" max_length="0">
			<original>タコリバーサーです！ 投げてくるコロガリウムに注意です！</original>
			<edited>是章鱼投掷兵！小心它扔过来的滚滚棒！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss01_0021" offset="00" relocatable="true" max_length="0">
			<original>スプラッシュボムです！ &#xE;&#x2;&#x1C;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;で投げましょう！</original>
			<edited>斯普拉炸弹！&#xE;&#x2;&#x1C;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;投出去吧！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss01_0022" offset="00" relocatable="true" max_length="0">
			<original>ハチ！ コロコロお肉に注意だ！</original>
			<edited>小八！小心滚动的肉块！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss01_0023" offset="00" relocatable="true" max_length="0">
			<original>やった！ オクタシューターですよ！</original>
			<edited>太好了！是章鱼射击枪！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss01_0024" offset="00" relocatable="true" max_length="0">
			<original>あ、ブキカンヅメ！ 手に入れたいですね…</original>
			<edited>啊，武器罐头！好想拿到…</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss01_0025" offset="00" relocatable="true" max_length="0">
			<original>『コロガリウム』です…</original>
			<edited>是“滚滚棒”…</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss01_0026" offset="00" relocatable="true" max_length="0">
			<original>正面にデカい門が見えたゾ！ 出口か？</original>
			<edited>前面看到一扇大门！是出口吗？</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss01_0027" offset="00" relocatable="true" max_length="0">
			<original>その前に、タコスナイパーです！ よけましょう！</original>
			<edited>在那之前，有章鱼狙击兵！躲开吧！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss01_0028" offset="00" relocatable="true" max_length="0">
			<original>シャオラー！ …からの、ジャンプポイント！</original>
			<edited>哇哦！…然后，跳跃点！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss01_0029" offset="00" relocatable="true" max_length="0">
			<original>次はエネルギーコアを探しますよ！</original>
			<edited>接下来去找能量核心！</edited>
			<subEntries />
		</entry>
		<entry name="LastBoss01_0030" offset="00" relocatable="true" max_length="0">
			<original>コ… コロコロおにく…？</original>
			<edited>滚…滚滚的肉…？</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
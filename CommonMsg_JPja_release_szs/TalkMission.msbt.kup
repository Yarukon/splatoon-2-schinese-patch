		<entry name="022_Unit05_Invisible_A5_Msn004" offset="00" relocatable="true" max_length="0">
			<original>&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;カーリングボムピッチャー&#xE;&#x0;&#x3;&#x2;ÿÿは&#xE;&#x2;#&#x8;&lt;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;押して、&#xE;&#x2;&#x1C;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;連打でし！</original>
			<edited>&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;冰壶炸弹&#xE;&#x0;&#x3;&#x2;ÿÿ按&#xE;&#x2;#&#x8;&lt;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;，再连按&#xE;&#x2;&#x1C;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;！</edited>

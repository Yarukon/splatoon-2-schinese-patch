<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>一定時間 たえ続ければクリアとなりまス</original>
			<edited>坚持一定时间即可通关</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>敵の攻撃を 見極めましょウ</original>
			<edited>看清敌人的攻击吧</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0003" offset="00" relocatable="true" max_length="0">
			<original>ビンイクラは よゆうがあるなら 取りましょウ</original>
			<edited>瓶装鲑鱼卵，有余力就拿吧</edited>
			<subEntries />
		</entry>
		<entry name="Tamayoke_0000" offset="00" relocatable="true" max_length="0">
			<original>３０秒間、よけまくればいいみたいだな！</original>
			<edited>好像躲过30秒就行！</edited>
			<subEntries />
		</entry>
		<entry name="Tamayoke_0001" offset="00" relocatable="true" max_length="0">
			<original>門の向こうに敵発見！ 確認されたしーッ！</original>
			<edited>门对面发现敌人！请确认！</edited>
			<subEntries />
		</entry>
		<entry name="Tamayoke_0003" offset="00" relocatable="true" max_length="0">
			<original>ビンイクラを発見しました！</original>
			<edited>发现瓶装鲑鱼卵了！</edited>
			<subEntries />
		</entry>
		<entry name="Tamayoke_0004" offset="00" relocatable="true" max_length="0">
			<original>また ビンイクラが出ましたが、無理は禁物です！</original>
			<edited>又出现瓶装鲑鱼卵了，但别勉强！</edited>
			<subEntries />
		</entry>
		<entry name="Tamayoke_0005" offset="00" relocatable="true" max_length="0">
			<original>もうちょっとだ！ たえろ！</original>
			<edited>就差一点！顶住！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
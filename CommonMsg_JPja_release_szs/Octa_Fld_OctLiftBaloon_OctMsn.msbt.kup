<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>風船マトを３０コ、全て壊しましょウ</original>
			<edited>打坏全部30个气球靶吧</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>風船マトを１つでも見のがすと 先に進めませン</original>
			<edited>漏看1个气球靶就无法继续前进</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>見にくい風船マトは、矢印の方向にありまス</original>
			<edited>难看到的气球靶在箭头方向</edited>
			<subEntries />
		</entry>
		<entry name="LiftBaloon_0001" offset="00" relocatable="true" max_length="0">
			<original>あと１つあるようじゃ！ 気合で探せィ！</original>
			<edited>好像还有1个！靠气势找出来！</edited>
			<subEntries />
		</entry>
		<entry name="LiftBaloon_0002" offset="00" relocatable="true" max_length="0">
			<original>あーあ… 風船マト 見のがした</original>
			<edited>哎呀… 漏掉气球靶了</edited>
			<subEntries />
		</entry>
		<entry name="LiftBaloon_0003" offset="00" relocatable="true" max_length="0">
			<original>しゃー！ 次ー！</original>
			<edited>好！下一个！</edited>
			<subEntries />
		</entry>
		<entry name="LiftBaloon_0004" offset="00" relocatable="true" max_length="0">
			<original>まだ残ってます！</original>
			<edited>还有剩下的！</edited>
			<subEntries />
		</entry>
		<entry name="LiftBaloon_0005" offset="00" relocatable="true" max_length="0">
			<original>最後のようじゃ！ 心して行けィ！</original>
			<edited>好像是最后一个！打起精神！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>ここは センプクでインクを回復できませン</original>
			<edited>这里无法靠潜行回复墨汁。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>インクが無くなると アウトでス</original>
			<edited>墨汁用尽就算出局。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>手おくれになる前に 補給インクで回復してくださイ</original>
			<edited>请在来不及前用补给墨汁回复。</edited>
			<subEntries />
		</entry>
		<entry name="InkBottle_0000" offset="00" relocatable="true" max_length="0">
			<original>ここはセンプクでは インクを回復できないようです</original>
			<edited>这里好像无法靠潜行回复墨汁。</edited>
			<subEntries />
		</entry>
		<entry name="InkBottle_0001" offset="00" relocatable="true" max_length="0">
			<original>ワシみたいに干からびんようにな</original>
			<edited>别像老夫一样干瘪了。</edited>
			<subEntries />
		</entry>
		<entry name="InkBottle_0002" offset="00" relocatable="true" max_length="0">
			<original>残りのインク、よく見てけよー</original>
			<edited>留意剩余的墨汁。</edited>
			<subEntries />
		</entry>
		<entry name="InkBottle_0003" offset="00" relocatable="true" max_length="0">
			<original>インクがもうありませんよ！</original>
			<edited>墨汁已经用光了！</edited>
			<subEntries />
		</entry>
		<entry name="InkBottle_0004" offset="00" relocatable="true" max_length="0">
			<original>これでおハダも ツヤツヤじゃのゥ！</original>
			<edited>这样皮肤也水润润的呢！</edited>
			<subEntries />
		</entry>
		<entry name="InkBottle_0005" offset="00" relocatable="true" max_length="0">
			<original>木箱壊して 先、進もーぜ！</original>
			<edited>打坏木箱，继续前进！</edited>
			<subEntries />
		</entry>
		<entry name="InkBottle_0006" offset="00" relocatable="true" max_length="0">
			<original>補給インクを取りにもどるのも 手ですね</original>
			<edited>回去拿补给墨汁也是个办法。</edited>
			<subEntries />
		</entry>
		<entry name="InkBottle_0007" offset="00" relocatable="true" max_length="0">
			<original>インクをムダにしないよう カサに注意です！</original>
			<edited>小心别浪费墨汁！</edited>
			<subEntries />
		</entry>
		<entry name="InkBottle_0008" offset="00" relocatable="true" max_length="0">
			<original>出口が見つかったゾ！</original>
			<edited>找到出口了！</edited>
			<subEntries />
		</entry>
		<entry name="InkBottle_0009" offset="00" relocatable="true" max_length="0">
			<original>なんかこう、ドカーン！ と、いきたいところだな…</original>
			<edited>真想轰地一下解决掉啊……</edited>
			<subEntries />
		</entry>
		<entry name="InkBottle_0010" offset="00" relocatable="true" max_length="0">
			<original>タテ持ちは後ろから攻撃で インク節約です！</original>
			<edited>从背后攻击持盾章鱼，省墨汁！</edited>
			<subEntries />
		</entry>
		<entry name="InkBottle_0011" offset="00" relocatable="true" max_length="0">
			<original>カギ出ました！ 補給インクを取りにもどりましょう！</original>
			<edited>钥匙出现了！回去拿补给墨汁吧！</edited>
			<subEntries />
		</entry>
		<entry name="InkBottle_0012" offset="00" relocatable="true" max_length="0">
			<original>ふ～ 生き返りますね！</original>
			<edited>呼～活过来了！</edited>
			<subEntries />
		</entry>
		<entry name="InkBottle_0013" offset="00" relocatable="true" max_length="0">
			<original>よーく ねらってけよ！</original>
			<edited>好好瞄准！</edited>
			<subEntries />
		</entry>
		<entry name="InkBottle_0014" offset="00" relocatable="true" max_length="0">
			<original>よしっ！ 補給インク、ゲットしに行くゾ！</original>
			<edited>好！去拿补给墨汁！</edited>
			<subEntries />
		</entry>
		<entry name="InkBottle_0015" offset="00" relocatable="true" max_length="0">
			<original>シャー！ ガンガン撃てー！</original>
			<edited>好！使劲打！</edited>
			<subEntries />
		</entry>
		<entry name="InkBottle_0016" offset="00" relocatable="true" max_length="0">
			<original>ムダづかいしちゃ ダメですよ…</original>
			<edited>可不能浪费哦……</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
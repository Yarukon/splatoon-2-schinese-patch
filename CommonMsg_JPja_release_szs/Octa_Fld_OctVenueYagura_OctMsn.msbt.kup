<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>ガチヤグラを、相手のゴールまで導いてくださイ</original>
			<edited>请将真格塔楼带到对手终点。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>ヤグラは、乗ると移動を始めまス</original>
			<edited>站上塔楼后，它就会开始移动。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>カンモンでは、一定時間 ヤグラが停止しまス</original>
			<edited>到关卡闸门时，塔楼会停一段时间。</edited>
			<subEntries />
		</entry>
		<entry name="VenueYagura_0000" offset="00" relocatable="true" max_length="0">
			<original>ガチヤグラを ゴールまで運ぶみたいですね～</original>
			<edited>看来要把真格塔楼带到终点呢～</edited>
			<subEntries />
		</entry>
		<entry name="VenueYagura_0001" offset="00" relocatable="true" max_length="0">
			<original>ハチ！ ヤグラに向かえー！</original>
			<edited>小八！去塔楼那边！</edited>
			<subEntries />
		</entry>
		<entry name="VenueYagura_0002" offset="00" relocatable="true" max_length="0">
			<original>時間内なら、何度でもやり直せるぞ！</original>
			<edited>还有时间就能重来，不限次数！</edited>
			<subEntries />
		</entry>
		<entry name="VenueYagura_0003" offset="00" relocatable="true" max_length="0">
			<original>あそこから ヤグラにジャンプできますよ！</original>
			<edited>从那里能跳到塔楼上哦！</edited>
			<subEntries />
		</entry>
		<entry name="VenueYagura_0004" offset="00" relocatable="true" max_length="0">
			<original>ぬゥ… また始めから仕切り直しじゃ！</original>
			<edited>唔……又得从头再来！</edited>
			<subEntries />
		</entry>
		<entry name="VenueYagura_0005" offset="00" relocatable="true" max_length="0">
			<original>残り1分です！</original>
			<edited>只剩一分钟了！</edited>
			<subEntries />
		</entry>
		<entry name="VenueYagura_0006" offset="00" relocatable="true" max_length="0">
			<original>もうダメだーっ！！</original>
			<edited>不行了！！</edited>
			<subEntries />
		</entry>
		<entry name="VenueYagura_0007" offset="00" relocatable="true" max_length="0">
			<original>ライドーン！</original>
			<edited>上塔楼！</edited>
			<subEntries />
		</entry>
		<entry name="VenueYagura_0008" offset="00" relocatable="true" max_length="0">
			<original>おい、どこ行くんだ！ ヤグラに乗れって！</original>
			<edited>喂，要去哪儿！快上塔楼！</edited>
			<subEntries />
		</entry>
		<entry name="VenueYagura_0009" offset="00" relocatable="true" max_length="0">
			<original>ヤグラは 矢印の示す方向にありますよ！</original>
			<edited>塔楼在箭头所指的方向哦！</edited>
			<subEntries />
		</entry>
		<entry name="VenueYagura_0010" offset="00" relocatable="true" max_length="0">
			<original>ゴールまで あと半分じゃ！</original>
			<edited>到终点还剩一半路程！</edited>
			<subEntries />
		</entry>
		<entry name="VenueYagura_0011" offset="00" relocatable="true" max_length="0">
			<original>こないだのライブ 最高だったよなー！</original>
			<edited>上次的演唱会超棒的吧！</edited>
			<subEntries />
		</entry>
		<entry name="VenueYagura_0012" offset="00" relocatable="true" max_length="0">
			<original>ですね～…って、それどころじゃないですよ！</original>
			<edited>是啊～……不过，现在不是聊这个的时候！</edited>
			<subEntries />
		</entry>
		<entry name="VenueYagura_0013" offset="00" relocatable="true" max_length="0">
			<original>ゲッ！ 乗ってきやがった！！</original>
			<edited>呃！它们上来了！！</edited>
			<subEntries />
		</entry>
		<entry name="VenueYagura_0014" offset="00" relocatable="true" max_length="0">
			<original>ときには降りて、体勢を整えるのも大事です！</original>
			<edited>有时下来调整一下状态也很重要！</edited>
			<subEntries />
		</entry>
		<entry name="VenueYagura_0015" offset="00" relocatable="true" max_length="0">
			<original>８号さん、ヤグラにもどりましょう！</original>
			<edited>8号，回塔楼上吧！</edited>
			<subEntries />
		</entry>
		<entry name="VenueYagura_0016" offset="00" relocatable="true" max_length="0">
			<original>先に 敵どもをとっちめても いいゾ！</original>
			<edited>先把敌人收拾掉也行！</edited>
			<subEntries />
		</entry>
		<entry name="VenueYagura_0017" offset="00" relocatable="true" max_length="0">
			<original>ゴールは近いです！ 落ち着いて行きましょう！</original>
			<edited>终点很近了！稳住，继续前进吧！</edited>
			<subEntries />
		</entry>
		<entry name="VenueYagura_0018" offset="00" relocatable="true" max_length="0">
			<original>っしゃ 行っけー！</original>
			<edited>好嘞，冲！</edited>
			<subEntries />
		</entry>
		<entry name="VenueYagura_0019" offset="00" relocatable="true" max_length="0">
			<original>今度こそ 行っけー！</original>
			<edited>这次一定要冲过去！</edited>
			<subEntries />
		</entry>
		<entry name="VenueYagura_0020" offset="00" relocatable="true" max_length="0">
			<original>…ファッ！ タコゾネスじゃ！</original>
			<edited>……哎呀！是章鱼女战士！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
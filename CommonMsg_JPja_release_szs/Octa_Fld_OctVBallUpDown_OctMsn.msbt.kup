<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>エイトボールをゴールへ導くのでス</original>
			<edited>把8号球引导到终点。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>エイトボールを敵に当てると ダメージをあたえられまス</original>
			<edited>让8号球砸中敌人能造成伤害。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>ダイタンかつセンサイに ショットするのでス</original>
			<edited>大胆又精准地射击吧。</edited>
			<subEntries />
		</entry>
		<entry name="VBallUpDown_0000" offset="00" relocatable="true" max_length="0">
			<original>ゲーーーーーーッ！！！</original>
			<edited>哇————！！！</edited>
			<subEntries />
		</entry>
		<entry name="VBallUpDown_0001" offset="00" relocatable="true" max_length="0">
			<original>追いかけましょう！</original>
			<edited>追上去吧！</edited>
			<subEntries />
		</entry>
		<entry name="VBallUpDown_0002" offset="00" relocatable="true" max_length="0">
			<original>エレベーター！ でも、ボールは乗せれなそーだな…</original>
			<edited>电梯！不过，球好像放不上去……</edited>
			<subEntries />
		</entry>
		<entry name="VBallUpDown_0003" offset="00" relocatable="true" max_length="0">
			<original>ヤッホーーーィ！！！</original>
			<edited>呀吼！！！</edited>
			<subEntries />
		</entry>
		<entry name="VBallUpDown_0004" offset="00" relocatable="true" max_length="0">
			<original>ほれ！ いそいでカギを手に入れるんじゃ！</original>
			<edited>喂！快去拿钥匙！</edited>
			<subEntries />
		</entry>
		<entry name="VBallUpDown_0005" offset="00" relocatable="true" max_length="0">
			<original>ドアの前に エイトボールのスイッチを発見です！</original>
			<edited>门前发现了8号球开关！</edited>
			<subEntries />
		</entry>
		<entry name="VBallUpDown_0006" offset="00" relocatable="true" max_length="0">
			<original>上り坂になってんな</original>
			<edited>是上坡路啊。</edited>
			<subEntries />
		</entry>
		<entry name="VBallUpDown_0007" offset="00" relocatable="true" max_length="0">
			<original>真ん中の手すりに、一度乗せましょ～</original>
			<edited>先放到中间的栏杆上吧～</edited>
			<subEntries />
		</entry>
		<entry name="VBallUpDown_0008" offset="00" relocatable="true" max_length="0">
			<original>ふぁんたすてぃっくじゃッ！</original>
			<edited>太棒了！</edited>
			<subEntries />
		</entry>
		<entry name="VBallUpDown_0009" offset="00" relocatable="true" max_length="0">
			<original>シーソーは、一気に行きましょう！</original>
			<edited>跷跷板要一口气过去！</edited>
			<subEntries />
		</entry>
		<entry name="VBallUpDown_0010" offset="00" relocatable="true" max_length="0">
			<original>このボム風船でエイトボールを、飛ばしましょう！</original>
			<edited>用这个炸弹气球把8号球弹出去！</edited>
			<subEntries />
		</entry>
		<entry name="VBallUpDown_0011" offset="00" relocatable="true" max_length="0">
			<original>タマコロちゃん、シーソーを わたりきったようじゃ！</original>
			<edited>小球球好像已经过了跷跷板！</edited>
			<subEntries />
		</entry>
		<entry name="VBallUpDown_0012" offset="00" relocatable="true" max_length="0">
			<original>遠くのシーソーが、下がった時な！</original>
			<edited>就是远处跷跷板降下去的时候！</edited>
			<subEntries />
		</entry>
		<entry name="VBallUpDown_0013" offset="00" relocatable="true" max_length="0">
			<original>カギ発見！ 確認されたしーッ！</original>
			<edited>发现钥匙！请确认！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
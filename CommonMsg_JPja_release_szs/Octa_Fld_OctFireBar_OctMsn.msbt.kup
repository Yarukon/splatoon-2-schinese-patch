<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>ジャンプマットの上で&#xE;&#x2;&#x18;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;を長押しするのでス</original>
			<edited>站在弹跳垫上，按住&#xE;&#x2;&#x18;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;即可。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>ヌリヌリ棒の動きを よく見ましょウ</original>
			<edited>好好观察涂涂棒的动向。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>ジャンプマットの上では インク切れに 注意でス…</original>
			<edited>在弹跳垫上要注意墨汁耗尽……</edited>
			<subEntries />
		</entry>
		<entry name="FireBar_0000" offset="00" relocatable="true" max_length="0">
			<original>見ろよ、ハチ！ アイツら なんだか楽しそうだゾ！</original>
			<edited>看啊，小八！那些家伙好像玩得挺开心！</edited>
			<subEntries />
		</entry>
		<entry name="FireBar_0001" offset="00" relocatable="true" max_length="0">
			<original>ナイスじゃ！</original>
			<edited>干得漂亮！</edited>
			<subEntries />
		</entry>
		<entry name="FireBar_0002" offset="00" relocatable="true" max_length="0">
			<original>カギを発見しました！</original>
			<edited>发现钥匙了！</edited>
			<subEntries />
		</entry>
		<entry name="FireBar_0003" offset="00" relocatable="true" max_length="0">
			<original>グッドじゃった！</original>
			<edited>干得漂亮！</edited>
			<subEntries />
		</entry>
		<entry name="FireBar_0004" offset="00" relocatable="true" max_length="0">
			<original>タコスナイパーです！ ひきつけて、よけましょう！</original>
			<edited>是章鱼狙击兵！引开它，再躲开！</edited>
			<subEntries />
		</entry>
		<entry name="FireBar_0005" offset="00" relocatable="true" max_length="0">
			<original>８号！ なんとかして飛びこむんじゃッ！</original>
			<edited>8号！想办法冲进去！</edited>
			<subEntries />
		</entry>
		<entry name="FireBar_0006" offset="00" relocatable="true" max_length="0">
			<original>落ち着いて 進みましょう！</original>
			<edited>冷静前进吧！</edited>
			<subEntries />
		</entry>
		<entry name="FireBar_0007" offset="00" relocatable="true" max_length="0">
			<original>ゴールを発見しました！</original>
			<edited>发现终点！</edited>
			<subEntries />
		</entry>
		<entry name="FireBar_0008" offset="00" relocatable="true" max_length="0">
			<original>いいゾ！</original>
			<edited>好！</edited>
			<subEntries />
		</entry>
		<entry name="FireBar_0009" offset="00" relocatable="true" max_length="0">
			<original>よし、ドアを開けるゾ！</original>
			<edited>好，开门！</edited>
			<subEntries />
		</entry>
		<entry name="FireBar_0010" offset="00" relocatable="true" max_length="0">
			<original>あ、ヌリヌリ棒です！ &#xE;&#x2;&#x18;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;長押しして よけましょう！</original>
			<edited>啊，是涂涂棒！按住&#xE;&#x2;&#x18;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;躲开吧！</edited>
			<subEntries />
		</entry>
		<entry name="FireBar_0011" offset="00" relocatable="true" max_length="0">
			<original>ファッ！ ここにもオクタリアンが！</original>
			<edited>哎呀！这里也有章鱼族！</edited>
			<subEntries />
		</entry>
		<entry name="FireBar_0012" offset="00" relocatable="true" max_length="0">
			<original>オクタリアンのようで、オクタリアンでない…？</original>
			<edited>像是章鱼族，又不是章鱼族……？</edited>
			<subEntries />
		</entry>
		<entry name="FireBar_0013" offset="00" relocatable="true" max_length="0">
			<original>&#xE;&#x2;&#x1E;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;インクショットで、ゴールポイントを起動させましょう！</original>
			<edited>按&#xE;&#x2;&#x1E;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;用墨汁射击启动终点！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
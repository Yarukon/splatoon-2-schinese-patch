<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Boss_0000" offset="00" relocatable="true" max_length="0">
			<original>最初のイイダボムです！ 胸に５コ、投下！</original>
			<edited>第一发饭田炸弹！胸口5个，投放！</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0001" offset="00" relocatable="true" max_length="0">
			<original>３０秒経過！ イイダボム、首の回りに５コ、投下！</original>
			<edited>30秒到！饭田炸弹，脖子周围5个，投放！</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0002" offset="00" relocatable="true" max_length="0">
			<original>６０秒経過！ イイダボム、背中に５コ、投下！</original>
			<edited>60秒到！饭田炸弹，后背5个，投放！</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0003" offset="00" relocatable="true" max_length="0">
			<original>９０秒経過！ イイダボム 右ウデに５コ、投下！</original>
			<edited>90秒到！饭田炸弹，右臂5个，投放！</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0004" offset="00" relocatable="true" max_length="0">
			<original>１２０秒経過！ 最後です！ 頭に１０コ、投下！</original>
			<edited>120秒到！最后一发！头顶10个，投放！</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0005" offset="00" relocatable="true" max_length="0">
			<original>世界をネリ返すエネルギー 発射まで、残り３０秒！</original>
			<edited>距离发射重塑世界的能量，还剩30秒！</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0006" offset="00" relocatable="true" max_length="0">
			<original>ィよーし！！ 撃って壊して塗りたくるんじゃーッ！</original>
			<edited>好嘞！！射击、破坏、涂个痛快！</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0007" offset="00" relocatable="true" max_length="0">
			<original>８号！ 首にあるポイント近くで 待機じゃ！</original>
			<edited>8号！在脖子上的标记点附近待命！</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0008" offset="00" relocatable="true" max_length="0">
			<original>ナイスです！ 次は首に投げます！ 少々お待ちを…</original>
			<edited>漂亮！接下来投脖子！请稍等…</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0009" offset="00" relocatable="true" max_length="0">
			<original>８号、聞こえたか？！ 背中側に先回りするんじゃ！</original>
			<edited>8号，听到了吗？！绕到背面去！</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0010" offset="00" relocatable="true" max_length="0">
			<original>OK！ 次は背中側に投げます！ 少々お待ちを…</original>
			<edited>OK！接下来投背面！请稍等…</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0011" offset="00" relocatable="true" max_length="0">
			<original>ハチ！ まちがうなよ！ 像の右ウデに、急げ！</original>
			<edited>小八！别搞错了！去像的右臂，快！</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0012" offset="00" relocatable="true" max_length="0">
			<original>次は右ウデの方に投下します！ 少々お待ちを…</original>
			<edited>接下来投向右臂方向！请稍等…</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0013" offset="00" relocatable="true" max_length="0">
			<original>ライドレールを使って、頭に向かえィ！</original>
			<edited>用墨汁轨道，冲向头部！</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0014" offset="00" relocatable="true" max_length="0">
			<original>ナイスです！ 最後は頭です！ 少々お待ちを…</original>
			<edited>漂亮！最后一发是头部！请稍等…</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0015" offset="00" relocatable="true" max_length="0">
			<original>８号さん！ 移動用に　この子達を使ってください！</original>
			<edited>8号！移动时请用这些小家伙！</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0016" offset="00" relocatable="true" max_length="0">
			<original>最初は 胸の辺りに５コ</original>
			<edited>先是在胸口附近5个</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0017" offset="00" relocatable="true" max_length="0">
			<original>その３０秒後に、首の回りに５コ</original>
			<edited>30秒后，脖子周围5个</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0018" offset="00" relocatable="true" max_length="0">
			<original>６０秒後に、背中に５コ</original>
			<edited>60秒后，后背5个</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0019" offset="00" relocatable="true" max_length="0">
			<original>９０秒後に、右ウデに５コ</original>
			<edited>90秒后，右臂5个</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0020" offset="00" relocatable="true" max_length="0">
			<original>最後 １２０秒後に、頭に１０コ</original>
			<edited>最后120秒后，头顶10个</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0021" offset="00" relocatable="true" max_length="0">
			<original>このイイダボムを&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;３分以内&#xE;&#x0;&#x3;&#x2;ÿÿに &#xE;&#x0;&#x3;&#x2;&#x0;&#x0;全部&#xE;&#x0;&#x3;&#x2;ÿÿ壊してください</original>
			<edited>请把这些饭田炸弹在&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;3分钟以内&#xE;&#x0;&#x3;&#x2;ÿÿ&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;全部&#xE;&#x0;&#x3;&#x2;ÿÿ破坏掉</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0023" offset="00" relocatable="true" max_length="0">
			<original>イイダボムは これらのポイントに投下します！ </original>
			<edited>饭田炸弹将投放到这些标记点！ </edited>
			<subEntries />
		</entry>
		<entry name="Boss_0025" offset="00" relocatable="true" max_length="0">
			<original>まだ 胸にイイダボムが あるぞィ！</original>
			<edited>胸口的饭田炸弹还在哦！</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0026" offset="00" relocatable="true" max_length="0">
			<original>胸にイイダボム、残ってんゾ！</original>
			<edited>胸口的饭田炸弹还留着呢！</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0027" offset="00" relocatable="true" max_length="0">
			<original>ん？ 胸のイイダボム、忘とらんか？</original>
			<edited>嗯？胸口的饭田炸弹，没忘吧？</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0028" offset="00" relocatable="true" max_length="0">
			<original>首のイイダボム、壊したほうがいーんじゃねーか？</original>
			<edited>脖子的饭田炸弹，还是打掉比较好吧？</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0029" offset="00" relocatable="true" max_length="0">
			<original>８号！ 首にイイダボム、残っとるぞィ！</original>
			<edited>8号！脖子的饭田炸弹还留着哦！</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0030" offset="00" relocatable="true" max_length="0">
			<original>ハチ！ 胸に壊してないイイダボムが あんゾ！</original>
			<edited>小八！胸口还有没打掉的饭田炸弹！</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0031" offset="00" relocatable="true" max_length="0">
			<original>背中のイイダボム、とっとと壊そーぜ！</original>
			<edited>背上的饭田炸弹，赶紧打掉吧！</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0032" offset="00" relocatable="true" max_length="0">
			<original>ホレ！ 背中のイイダボム、見のがしとるぞィ！</original>
			<edited>喂！背上的饭田炸弹，你漏掉了！</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0033" offset="00" relocatable="true" max_length="0">
			<original>首のイイダボム、放置されてんゾ！</original>
			<edited>脖子的饭田炸弹，你放着不管呢！</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0034" offset="00" relocatable="true" max_length="0">
			<original>おい！ 胸のイイダボム、見のがしてんゾ！</original>
			<edited>喂！胸口的饭田炸弹，你漏掉了！</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0035" offset="00" relocatable="true" max_length="0">
			<original>ハチ！ 右ウデのイイダボム、忘れんなよ！</original>
			<edited>小八！右臂的饭田炸弹，别忘了！</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0036" offset="00" relocatable="true" max_length="0">
			<original>ネルス像のチャージが止まりました！</original>
			<edited>涅尔像的充能停止了！</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0037" offset="00" relocatable="true" max_length="0">
			<original>８号！ こっちの準備ができるまで、そこで待っとれィ！</original>
			<edited>8号！在我们准备好之前，先在那里等着！</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0038" offset="00" relocatable="true" max_length="0">
			<original>テンション、そろそろ いいゾ！</original>
			<edited>状态，差不多到位了！</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0039" offset="00" relocatable="true" max_length="0">
			<original>てかさー… 『イイダボム』って名前、そのまんますぎね？</original>
			<edited>话说啊…“饭田炸弹”这名字，也太直白了吧？</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0040" offset="00" relocatable="true" max_length="0">
			<original>Elegantで Dramatic、かつ Amazingなボム…</original>
			<edited>既优雅又戏剧化，还令人惊叹的炸弹…</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0041" offset="00" relocatable="true" max_length="0">
			<original>略したら『E-DA』ボムに なっちゃったんですよ～</original>
			<edited>一缩写，就成了“E-DA”炸弹了～</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0042" offset="00" relocatable="true" max_length="0">
			<original>フォーッ！！ 名は体を表しとるのゥ！！</original>
			<edited>哦哦！！真是名副其实啊！！</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0043" offset="00" relocatable="true" max_length="0">
			<original>イイダボム、 ラスト１コだけ残ってんゾ！</original>
			<edited>饭田炸弹，只剩下最后1个了！</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0044" offset="00" relocatable="true" max_length="0">
			<original>ガ… 魚介類よ、このまま大人しく ネリ返されるがヨイ</original>
			<edited>嘎…鱼类们，就乖乖地被重塑吧</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0045" offset="00" relocatable="true" max_length="0">
			<original>ガッ！ 貴様らはネリ返され、新世界の一部となるノダ！</original>
			<edited>嘎！你们将被重塑，成为新世界的一部分！</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0046" offset="00" relocatable="true" max_length="0">
			<original>ガガ… この世界をネリ返し、博士の求めた世界ヲ…</original>
			<edited>嘎嘎…重塑这个世界，实现博士所求的世界…</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0047" offset="00" relocatable="true" max_length="0">
			<original>ガガッ… ムダだ、No.10008！ ネルス像は止めらレン！</original>
			<edited>嘎嘎…没用的，No.10008！涅尔像是停不下来的！</edited>
			<subEntries />
		</entry>
		<entry name="Boss_0048" offset="00" relocatable="true" max_length="0">
			<original>ガガッ！ ネルス像！ ネリ返す時が近づいて来タゾ！！</original>
			<edited>嘎嘎！涅尔像！重塑的时刻就要到了！！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
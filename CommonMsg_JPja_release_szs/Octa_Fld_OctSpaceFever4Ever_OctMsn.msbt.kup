<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>敵を全て倒してくださイ</original>
			<edited>请打倒所有敌人</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>敵の動きをよく見ましょウ</original>
			<edited>好好观察敌人的动向</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>木箱にかくれて、敵の弾を防ぎましょウ</original>
			<edited>躲在木箱后挡敌人的子弹</edited>
			<subEntries />
		</entry>
		<entry name="SpaceFever4Ever_0000" offset="00" relocatable="true" max_length="0">
			<original>数は多いですが、落ち着いて！</original>
			<edited>数量很多，但别慌！</edited>
			<subEntries />
		</entry>
		<entry name="SpaceFever4Ever_0001" offset="00" relocatable="true" max_length="0">
			<original>あと半分です！</original>
			<edited>还剩一半！</edited>
			<subEntries />
		</entry>
		<entry name="SpaceFever4Ever_0002" offset="00" relocatable="true" max_length="0">
			<original>フォーー！ 敵さんも必死じゃのゥ！</original>
			<edited>哦哦！敌人也拼了命呢！</edited>
			<subEntries />
		</entry>
		<entry name="SpaceFever4Ever_0003" offset="00" relocatable="true" max_length="0">
			<original>やべっ！ はなれろ！</original>
			<edited>糟了！快离开！</edited>
			<subEntries />
		</entry>
		<entry name="SpaceFever4Ever_0004" offset="00" relocatable="true" max_length="0">
			<original>マルチミサイルは カナアミの下へかくれてください！</original>
			<edited>多重导弹，躲到铁丝网下面！</edited>
			<subEntries />
		</entry>
		<entry name="SpaceFever4Ever_0005" offset="00" relocatable="true" max_length="0">
			<original>敵機確認！ 攻撃開始ィ！</original>
			<edited>确认敌机！开始攻击！</edited>
			<subEntries />
		</entry>
		<entry name="SpaceFever4Ever_0006" offset="00" relocatable="true" max_length="0">
			<original>UFOのシールドがやっかいだな…</original>
			<edited>UFO的护盾真麻烦…</edited>
			<subEntries />
		</entry>
		<entry name="SpaceFever4Ever_0007" offset="00" relocatable="true" max_length="0">
			<original>トツゲキじゃー！ UFOに乗りこめーィ！</original>
			<edited>冲锋！登上UFO！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
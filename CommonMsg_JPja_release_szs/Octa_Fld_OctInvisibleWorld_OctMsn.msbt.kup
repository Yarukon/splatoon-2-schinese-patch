	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>見えないモノを見ましょウ</original>
			<edited>去看看那些看不见的东西吧。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>見えないカベに注意でス</original>
			<edited>小心看不见的墙</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>あせりは禁物… 急がば回レ…</original>
			<edited>急躁是大忌……欲速则不达……</edited>
			<subEntries />
		</entry>
		<entry name="InvisibleWorld_0000" offset="00" relocatable="true" max_length="0">
			<original>ん？！ これって…</original>
			<edited>嗯？！这是……</edited>
			<subEntries />
		</entry>
		<entry name="InvisibleWorld_0001" offset="00" relocatable="true" max_length="0">
			<original>見えない地面です！ 塗って進みましょ～</original>
			<edited>是看不见的地面！边涂边前进吧～</edited>
			<subEntries />
		</entry>
		<entry name="InvisibleWorld_0002" offset="00" relocatable="true" max_length="0">
			<original>地面が見えるまで、撃って撃って撃ちつくせィ！</original>
			<edited>在地面显现前，打个不停！</edited>
			<subEntries />
		</entry>
		<entry name="InvisibleWorld_0003" offset="00" relocatable="true" max_length="0">
			<original>戦場の鉄則ゥ！</original>
			<edited>战场的铁则！</edited>
			<subEntries />
		</entry>
		<entry name="InvisibleWorld_0004" offset="00" relocatable="true" max_length="0">
			<original>否ーーーーーッ！！</original>
			<edited>不————！！</edited>
			<subEntries />
		</entry>
		<entry name="InvisibleWorld_0005" offset="00" relocatable="true" max_length="0">
			<original>仲良しさんですよね…</original>
			<edited>感情真好呢…</edited>
			<subEntries />
		</entry>
		<entry name="InvisibleWorld_0006" offset="00" relocatable="true" max_length="0">
			<original>ジャンプポイント発見！ 確認されたしーッ！</original>
			<edited>发现跳跃点！确认一下！</edited>
			<subEntries />
		</entry>
		<entry name="InvisibleWorld_0007" offset="00" relocatable="true" max_length="0">
			<original>シャオラー！</original>
			<edited>哇哦！</edited>
			<subEntries />
		</entry>
		<entry name="InvisibleWorld_0008" offset="00" relocatable="true" max_length="0">
			<original>ライドレールを発見しました♪</original>
			<edited>发现墨汁轨道了♪</edited>
			<subEntries />
		</entry>
		<entry name="InvisibleWorld_0010" offset="00" relocatable="true" max_length="0">
			<original>ゴールポイント発見、確認されたしーッ！</original>
			<edited>发现终点，确认一下！</edited>
			<subEntries />
		</entry>
	</entries>

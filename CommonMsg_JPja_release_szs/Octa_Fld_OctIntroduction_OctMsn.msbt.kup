<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Introduction_0001" offset="00" relocatable="true" max_length="0">
			<original>なんじゃここは… &#xE;&#x1;&#x0;&#x4;&#xF;&#x0;&#x0;&#x0;とりあえず、進んでみるかのゥ</original>
			<edited>这里是哪… &#xE;&#x1;&#x0;&#x4;&#xF;&#x0;&#x0;&#x0;总之，先走走看吧</edited>
			<subEntries />
		</entry>
		<entry name="Introduction_0002" offset="00" relocatable="true" max_length="0">
			<original>あれに見えるは オクタリアンの&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;ドア&#xE;&#x0;&#x3;&#x2;ÿÿじゃ！ &#xE;&#x1;&#x0;&#x4;&lt;&#x0;&#x0;&#x0;&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;カギ&#xE;&#x0;&#x3;&#x2;ÿÿで開くぞィ</original>
			<edited>那边看到的是章鱼族的&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;门&#xE;&#x0;&#x3;&#x2;ÿÿ！ &#xE;&#x1;&#x0;&#x4;&lt;&#x0;&#x0;&#x0;&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;钥匙&#xE;&#x0;&#x3;&#x2;ÿÿ能打开</edited>
			<subEntries />
		</entry>
		<entry name="Introduction_0003" offset="00" relocatable="true" max_length="0">
			<original>おヌシもオクタリアンなら ここに見覚えはないか？</original>
			<edited>你也是章鱼族的话，对这里有印象吗？</edited>
			<subEntries />
		</entry>
		<entry name="Introduction_0004" offset="00" relocatable="true" max_length="0">
			<original>しかし、オクタリアンの気配は せんのゥ…</original>
			<edited>不过，感觉不到章鱼族的气息…</edited>
			<subEntries />
		</entry>
		<entry name="Introduction_0005" offset="00" relocatable="true" max_length="0">
			<original>それはさておき、まずは&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;カギ&#xE;&#x0;&#x3;&#x2;ÿÿを探さんとな…</original>
			<edited>先不说这个，得先找&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;钥匙&#xE;&#x0;&#x3;&#x2;ÿÿ…</edited>
			<subEntries />
		</entry>
		<entry name="Introduction_0006" offset="00" relocatable="true" max_length="0">
			<original>フォー！ &#xE;&#x1;&#x0;&#x4;&#x1E;&#x0;&#x0;&#x0;その機械で ブキをゲットできるようじゃな</original>
			<edited>哦哦！ &#xE;&#x1;&#x0;&#x4;&#x1E;&#x0;&#x0;&#x0;用那台机器好像能拿到武器</edited>
			<subEntries />
		</entry>
		<entry name="Introduction_0007" offset="00" relocatable="true" max_length="0">
			<original>カギじゃ！ &#xE;&#x1;&#x0;&#x4;&#xF;&#x0;&#x0;&#x0;さっきの&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;ドア&#xE;&#x0;&#x3;&#x2;ÿÿを開けに もどるぞィ！</original>
			<edited>是钥匙！ &#xE;&#x1;&#x0;&#x4;&#xF;&#x0;&#x0;&#x0;回去开刚才那扇&#xE;&#x0;&#x3;&#x2;&#x0;&#x0;门&#xE;&#x0;&#x3;&#x2;ÿÿ！</edited>
			<subEntries />
		</entry>
		<entry name="Introduction_0008" offset="00" relocatable="true" max_length="0">
			<original>ファッ！ ブキを外されたか… 不思議な機械じゃな…</original>
			<edited>哎呀！武器被卸下来了… 真是奇怪的机器…</edited>
			<subEntries />
		</entry>
		<entry name="Introduction_0009" offset="00" relocatable="true" max_length="0">
			<original>フム… 不気味な場所じゃが 進むしかないのゥ</original>
			<edited>嗯… 虽然这地方阴森，但也只能前进了</edited>
			<subEntries />
		</entry>
		<entry name="Introduction_0010" offset="00" relocatable="true" max_length="0">
			<original>&#xE;&#x2;&#x1D;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;でインクレールに乗ったら、向こうへ わたるんじゃ</original>
			<edited>&#xE;&#x2;&#x1D;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;乘上墨汁轨道，到对面去</edited>
			<subEntries />
		</entry>
		<entry name="Introduction_0011" offset="00" relocatable="true" max_length="0">
			<original>上に ひきよせポイントじゃ！ 撃ってみィ！</original>
			<edited>上面有牵引点！打打看！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
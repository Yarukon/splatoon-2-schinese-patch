<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>グルグル回る絶望の先にこそ 希望はあるのでス</original>
			<edited>在旋转的绝望尽头，才有希望。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>スイッチ、それハ… 希望へのかけ橋でス</original>
			<edited>开关，那是……通往希望的桥梁。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>あわてず かけぬけましょウ</original>
			<edited>别慌，冲过去吧。</edited>
			<subEntries />
		</entry>
		<entry name="RollingBlocks_0000" offset="00" relocatable="true" max_length="0">
			<original>おっ 止まった？！</original>
			<edited>哦，停了？！</edited>
			<subEntries />
		</entry>
		<entry name="RollingBlocks_0001" offset="00" relocatable="true" max_length="0">
			<original>そろそろ動き始めます！</original>
			<edited>差不多要开始动了！</edited>
			<subEntries />
		</entry>
		<entry name="RollingBlocks_0002" offset="00" relocatable="true" max_length="0">
			<original>一気に登れー！</original>
			<edited>一口气爬上去！</edited>
			<subEntries />
		</entry>
		<entry name="RollingBlocks_0003" offset="00" relocatable="true" max_length="0">
			<original>８号！ スイッチじゃ、スイッチを探すんじゃ！</original>
			<edited>8号！是开关，去找开关！</edited>
			<subEntries />
		</entry>
		<entry name="RollingBlocks_0004" offset="00" relocatable="true" max_length="0">
			<original>時よ、止まれー！</original>
			<edited>时间啊，停下吧！</edited>
			<subEntries />
		</entry>
		<entry name="RollingBlocks_0005" offset="00" relocatable="true" max_length="0">
			<original>センパイ… 時間は止まってないですよ</original>
			<edited>前辈……时间可没有停。</edited>
			<subEntries />
		</entry>
		<entry name="RollingBlocks_0006" offset="00" relocatable="true" max_length="0">
			<original>何度かクルクルさせたら 上に行けそうですね</original>
			<edited>多转几次，好像能上去。</edited>
			<subEntries />
		</entry>
		<entry name="RollingBlocks_0007" offset="00" relocatable="true" max_length="0">
			<original>あれ… ここは橋がないぞ？</original>
			<edited>咦……这里没有桥？</edited>
			<subEntries />
		</entry>
		<entry name="RollingBlocks_0008" offset="00" relocatable="true" max_length="0">
			<original>よっしゃ！ わたりきったー！</original>
			<edited>好嘞！过来了！</edited>
			<subEntries />
		</entry>
		<entry name="RollingBlocks_0009" offset="00" relocatable="true" max_length="0">
			<original>スイッチ… スイッチはどこじゃ…</original>
			<edited>开关……开关在哪儿……</edited>
			<subEntries />
		</entry>
		<entry name="RollingBlocks_0010" offset="00" relocatable="true" max_length="0">
			<original>ふりこが止まってるうちに ジャンプでわたりましょう！</original>
			<edited>趁摆锤停下时，跳过去吧！</edited>
			<subEntries />
		</entry>
		<entry name="RollingBlocks_0011" offset="00" relocatable="true" max_length="0">
			<original>いっけーーーっ！</original>
			<edited>冲——！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
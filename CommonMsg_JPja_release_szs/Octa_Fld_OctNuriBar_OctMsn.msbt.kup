<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>永遠にインクを塗り続けるヌリヌリバー…</original>
			<edited>永远不停涂墨的涂涂棒…</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>ヌリヌリバーに押されないよう、お気をつけくださイ</original>
			<edited>小心别被涂涂棒推走</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>ヌリヌリバーは、敵か味方か… 果たしテ…</original>
			<edited>涂涂棒，是敌是友…到底…</edited>
			<subEntries />
		</entry>
		<entry name="NuriBar_0001" offset="00" relocatable="true" max_length="0">
			<original>ハイドラントは 射程をイカしましょう！</original>
			<edited>消防栓旋转枪，好好发挥射程吧！</edited>
			<subEntries />
		</entry>
		<entry name="NuriBar_0002" offset="00" relocatable="true" max_length="0">
			<original>右見て 左見て 後ろ見て！ 戦場の鉄則ゥ！</original>
			<edited>看看右，看看左，看看后！战场的铁则！</edited>
			<subEntries />
		</entry>
		<entry name="NuriBar_0003" offset="00" relocatable="true" max_length="0">
			<original>しゃー！ 撃て撃て撃て撃て撃てー！</original>
			<edited>哇！打打打打打！</edited>
			<subEntries />
		</entry>
		<entry name="NuriBar_0004" offset="00" relocatable="true" max_length="0">
			<original>シャー オラー！</original>
			<edited>哇，上啊！</edited>
			<subEntries />
		</entry>
		<entry name="NuriBar_0005" offset="00" relocatable="true" max_length="0">
			<original>ヌリヌリバー、来てんゾ！</original>
			<edited>涂涂棒来了！</edited>
			<subEntries />
		</entry>
		<entry name="NuriBar_0006" offset="00" relocatable="true" max_length="0">
			<original>なんかデカい敵、発見！</original>
			<edited>发现大家伙！</edited>
			<subEntries />
		</entry>
		<entry name="NuriBar_0007" offset="00" relocatable="true" max_length="0">
			<original>タカタコドーザー、ですね</original>
			<edited>是鹰章鱼推进洒墨机吧</edited>
			<subEntries />
		</entry>
		<entry name="NuriBar_0008" offset="00" relocatable="true" max_length="0">
			<original>ドーザーはインクで おびきよせましょ～</original>
			<edited>用墨汁引开推进洒墨机吧～</edited>
			<subEntries />
		</entry>
		<entry name="NuriBar_0009" offset="00" relocatable="true" max_length="0">
			<original>あのヌリヌリバー、８号のインクを塗っておるぞィ！</original>
			<edited>那个涂涂棒，在涂掉8号的墨汁！</edited>
			<subEntries />
		</entry>
		<entry name="NuriBar_0010" offset="00" relocatable="true" max_length="0">
			<original>ィよし！ ナイスじゃった！</original>
			<edited>好嘞！干得漂亮！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
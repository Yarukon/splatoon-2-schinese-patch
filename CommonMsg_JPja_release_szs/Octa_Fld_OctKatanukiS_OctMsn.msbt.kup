<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>左の見本と同じカタチに カタヌキしてくださイ</original>
			<edited>请削成和左边样品一样的形状</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>まちがった箱をケズると 失敗となりまス</original>
			<edited>削错箱子就算失败</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>集中… とにかく集中でス</original>
			<edited>集中…总之要集中</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiS_0000" offset="00" relocatable="true" max_length="0">
			<original>これと同じカタチに 右の木箱をケズるのか…</original>
			<edited>要把右边的木箱削成和这个一样的形状吗…</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiS_0001" offset="00" relocatable="true" max_length="0">
			<original>カタヌキみたいで わくわくしますね～♪</original>
			<edited>像刨花片一样，让人兴奋呢～♪</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiS_0002" offset="00" relocatable="true" max_length="0">
			<original>じっくり 見本のカタチを確認しましょうか</original>
			<edited>慢慢确认样品的形状吧</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiS_0003" offset="00" relocatable="true" max_length="0">
			<original>ってか何だあれ？ どっかで見た気もするけど…</original>
			<edited>话说那是什么？感觉在哪见过…</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiS_0004" offset="00" relocatable="true" max_length="0">
			<original>８号さん！ 細部は落ち着いてケズりましょう！</original>
			<edited>8号！细节部分冷静地削！</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiS_0005" offset="00" relocatable="true" max_length="0">
			<original>うぅ… 一気に爆破してぇー！</original>
			<edited>唔… 好想一口气炸掉！</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiS_0006" offset="00" relocatable="true" max_length="0">
			<original>…ん？ 完成してんじゃねーのか？ </original>
			<edited>…嗯？不是完成了吗？</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiS_0007" offset="00" relocatable="true" max_length="0">
			<original>どこかにまだ ケズり残しがあるようですね…</original>
			<edited>好像还有哪里没削完…</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiS_0008" offset="00" relocatable="true" max_length="0">
			<original>うっし！ ゴールに向かえー！</original>
			<edited>好嘞！朝终点去！</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiS_0009" offset="00" relocatable="true" max_length="0">
			<original>え～っ？ じっくりと作品を見ていきましょ～よ</original>
			<edited>诶～？好好欣赏一下作品嘛～</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiS_0010" offset="00" relocatable="true" max_length="0">
			<original>フォッ！ ヘソクリのイクラじゃ！</original>
			<edited>哎呀！是私房钱的鲑鱼卵！</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiS_0011" offset="00" relocatable="true" max_length="0">
			<original>息を整え、落ち着けィ！ 戦場の鉄則じゃ！</original>
			<edited>调整呼吸，稳住！战场的铁则！</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiS_0012" offset="00" relocatable="true" max_length="0">
			<original>ってかフルオートはヤバい、ちょん押しで撃とーぜ</original>
			<edited>话说全自动太危险，还是轻点按键射击吧</edited>
			<subEntries />
		</entry>
		<entry name="KatanukiS_0013" offset="00" relocatable="true" max_length="0">
			<original>フルチャージだと、木箱をつきぬけるから 注意です！</original>
			<edited>满蓄力会穿透木箱，注意！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>時間内にボールバンパーを 全て壊しましょウ</original>
			<edited>请在时间内打坏所有球挡板</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>右のふみスイッチで右、左のふみスイッチで左へ…</original>
			<edited>踩右边开关往右，踩左边开关往左…</edited>
			<subEntries />
		</entry>
		<entry name="VBallDDA_0000" offset="00" relocatable="true" max_length="0">
			<original>ふみスイッチをふんで 操作しましょう！</original>
			<edited>踩踏开关来操作吧！</edited>
			<subEntries />
		</entry>
		<entry name="VBallDDA_0001" offset="00" relocatable="true" max_length="0">
			<original>半分いったゾ！</original>
			<edited>到一半了！</edited>
			<subEntries />
		</entry>
		<entry name="VBallDDA_0002" offset="00" relocatable="true" max_length="0">
			<original>残り１０コです！</original>
			<edited>还剩10个！</edited>
			<subEntries />
		</entry>
		<entry name="VBallDDA_0003" offset="00" relocatable="true" max_length="0">
			<original>８号、もうちょいじゃ！</original>
			<edited>8号，就差一点！</edited>
			<subEntries />
		</entry>
		<entry name="VBallDDA_0004" offset="00" relocatable="true" max_length="0">
			<original>しゃー！ ラストー！</original>
			<edited>好！最后一个！</edited>
			<subEntries />
		</entry>
		<entry name="VBallDDA_0005" offset="00" relocatable="true" max_length="0">
			<original>&#xE;&#x2;&#x1A;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;押しながら&#xE;&#x2;"&#x8;&lt;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;操作の カニ歩きだと、見やすいゾ</original>
			<edited>&#xE;&#x2;&#x1A;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;一边按住，&#xE;&#x2;"&#x8;&lt;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;像螃蟹一样横着操作，更好看清</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
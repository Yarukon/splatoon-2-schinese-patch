<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>ジェットパック中&#xE;&#x2;&#x18;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;を押すと 少しうきまス</original>
			<edited>喷气背包期间，&#xE;&#x2;&#x18;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;按下会稍微上浮</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>ジェットパックは カナアミの上では飛べませン</original>
			<edited>喷气背包在铁丝网上无法飞行</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>イカフライは 無理に取る必要は無いでス</original>
			<edited>炸鱿鱼圈不必勉强去拿</edited>
			<subEntries />
		</entry>
		<entry name="PilotWings_0000" offset="00" relocatable="true" max_length="0">
			<original>フォー！ 気持ちよさそうじゃのゥ！</original>
			<edited>哦哦！看着真舒服！</edited>
			<subEntries />
		</entry>
		<entry name="PilotWings_0001" offset="00" relocatable="true" max_length="0">
			<original>&#xE;&#x2;&#x18;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;で、ちょっとだけうくゾ！</original>
			<edited>&#xE;&#x2;&#x18;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;稍微上浮！</edited>
			<subEntries />
		</entry>
		<entry name="PilotWings_0002" offset="00" relocatable="true" max_length="0">
			<original>タココマンダーを発見しました！</original>
			<edited>发现章鱼指挥官了！</edited>
			<subEntries />
		</entry>
		<entry name="PilotWings_0004" offset="00" relocatable="true" max_length="0">
			<original>ジェットパック中でも、&#xE;&#x2;&#x1D;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;でセンプクできます！</original>
			<edited>喷气背包期间也能，&#xE;&#x2;&#x1D;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;潜行！</edited>
			<subEntries />
		</entry>
		<entry name="PilotWings_0005" offset="00" relocatable="true" max_length="0">
			<original>&#xE;&#x2;&#x1E;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;で ショーーット！！</original>
			<edited>&#xE;&#x2;&#x1E;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;射——！！</edited>
			<subEntries />
		</entry>
		<entry name="PilotWings_0006" offset="00" relocatable="true" max_length="0">
			<original>空中で&#xE;&#x2;&#x18;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;、何度でもできますよ！</original>
			<edited>在空中&#xE;&#x2;&#x18;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;，多少次都行！</edited>
			<subEntries />
		</entry>
		<entry name="PilotWings_0007" offset="00" relocatable="true" max_length="0">
			<original>落ちそうなら、とにかく&#xE;&#x2;&#x18;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;しまくれば よさそうじゃな！</original>
			<edited>要掉下去的话，总之&#xE;&#x2;&#x18;&#x8;F&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;使劲按就行！</edited>
			<subEntries />
		</entry>
		<entry name="PilotWings_0008" offset="00" relocatable="true" max_length="0">
			<original>シャー！ さっさとゴールすんゾ！</original>
			<edited>哇！赶紧到终点！</edited>
			<subEntries />
		</entry>
		<entry name="PilotWings_0010" offset="00" relocatable="true" max_length="0">
			<original>フォー！ 上手いもんじゃ！</original>
			<edited>哦哦！真有两下子！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>
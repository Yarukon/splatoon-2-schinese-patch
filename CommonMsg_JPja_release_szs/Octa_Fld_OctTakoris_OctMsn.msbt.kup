<?xml version="1.0" encoding="utf-8"?>
<kup encoding="utf-16" ramOffset="00" optimizeStrings="true">
	<pointerTables />
	<stringBounds />
	<entries>
		<entry name="Syasyo_0000" offset="00" relocatable="true" max_length="0">
			<original>ログポイントを８コ全て 集めてくださイ</original>
			<edited>请收集全部八个记录点。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0001" offset="00" relocatable="true" max_length="0">
			<original>ログポイントは、壊して触れれば ゲットとなりまス</original>
			<edited>打坏记录点后，触碰即可获得。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0002" offset="00" relocatable="true" max_length="0">
			<original>カベを塗って 登れる場所を探しましょウ</original>
			<edited>找找涂墙后能爬上去的地方吧。</edited>
			<subEntries />
		</entry>
		<entry name="Syasyo_0003" offset="00" relocatable="true" max_length="0">
			<original>インクショットの曲射も 有効に使いましょウ</original>
			<edited>也好好利用墨汁射击的抛物线吧。</edited>
			<subEntries />
		</entry>
		<entry name="Takoris_00" offset="00" relocatable="true" max_length="0">
			<original>ここ、頭使うヤツか… あとは任せたっ！</original>
			<edited>这里是要动脑子的关卡……剩下的交给你了！</edited>
			<subEntries />
		</entry>
		<entry name="Takoris_01" offset="00" relocatable="true" max_length="0">
			<original>スイッチONで ぐるっと90度回るみたいです！</original>
			<edited>打开开关，好像会转九十度！</edited>
			<subEntries />
		</entry>
		<entry name="Takoris_02" offset="00" relocatable="true" max_length="0">
			<original>１コ目！ 適当に回せば 何とかなりそうだな！</original>
			<edited>第一个！随便转转好像就能搞定！</edited>
			<subEntries />
		</entry>
		<entry name="Takoris_03" offset="00" relocatable="true" max_length="0">
			<original>２コ目です！ 順調ですね♪</original>
			<edited>第二个！很顺利呢♪</edited>
			<subEntries />
		</entry>
		<entry name="Takoris_04" offset="00" relocatable="true" max_length="0">
			<original>３コ目っ！ となりの部屋からカナアミごしに撃てー！</original>
			<edited>第三个！从隔壁房间隔着铁丝网打！</edited>
			<subEntries />
		</entry>
		<entry name="Takoris_05" offset="00" relocatable="true" max_length="0">
			<original>４コ目です♪ 半分まできました！</original>
			<edited>第四个♪到一半了！</edited>
			<subEntries />
		</entry>
		<entry name="Takoris_06" offset="00" relocatable="true" max_length="0">
			<original>５コ目！ 頭グルグルするー</original>
			<edited>第五个！脑子都转晕了。</edited>
			<subEntries />
		</entry>
		<entry name="Takoris_07" offset="00" relocatable="true" max_length="0">
			<original>６コ目です！ 頭回ってきましたね…</original>
			<edited>第六个！脑子已经转起来了……</edited>
			<subEntries />
		</entry>
		<entry name="Takoris_08" offset="00" relocatable="true" max_length="0">
			<original>ふぃー ７コ目だ！ あと１コ！</original>
			<edited>呼——第七个！还剩一个！</edited>
			<subEntries />
		</entry>
		<entry name="Takoris_09" offset="00" relocatable="true" max_length="0">
			<original>後づめじゃ！ 敵が増えおったぞィ！</original>
			<edited>是增援！敌人变多了！</edited>
			<subEntries />
		</entry>
		<entry name="Takoris_10" offset="00" relocatable="true" max_length="0">
			<original>また敵に加勢じゃ！ 気をつけィ！</original>
			<edited>敌人又来增援！小心！</edited>
			<subEntries />
		</entry>
	</entries>
</kup>